<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MALPlus.Controls.FloatingShareButton"
             IsVisible="False"
             Opacity="0"
             InputTransparent="False">
    <Border StrokeShape="RoundRectangle 20"
            BackgroundColor="#0066FF"
            Stroke="Transparent"
            Padding="0"
            HeightRequest="40"
            HorizontalOptions="End"
            VerticalOptions="Center"
            InputTransparent="False">
        <Border.Shadow>
            <Shadow Brush="#80000000" Offset="0,4" Radius="8" Opacity="0.5" />
        </Border.Shadow>
        <Grid ColumnDefinitions="Auto,1,Auto" VerticalOptions="Center" InputTransparent="False">
            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center"
                                   Padding="14,0,10,0" HeightRequest="40" BackgroundColor="#0066FF" InputTransparent="False">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnShareTapped" />
                </HorizontalStackLayout.GestureRecognizers>
                <Image Source="icon_share" WidthRequest="18" HeightRequest="18"
                       VerticalOptions="Center" InputTransparent="True" />
                <Label Text="Share update" FontFamily="InterSemiBold" FontSize="13"
                       TextColor="#FFFFFF" VerticalOptions="Center" InputTransparent="True" />
            </HorizontalStackLayout>

            <BoxView Grid.Column="1" WidthRequest="1" HeightRequest="18" BackgroundColor="#40FFFFFF"
                     VerticalOptions="Center" Margin="2,0" InputTransparent="True" />

            <Border Grid.Column="2" WidthRequest="36" HeightRequest="40" StrokeShape="RoundRectangle 0 20 20 0"
                    BackgroundColor="#0066FF" Stroke="Transparent" Padding="0" VerticalOptions="Center" InputTransparent="False">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDismissTapped" />
                </Border.GestureRecognizers>
                <Label Text="✕" FontFamily="InterBold" FontSize="12" TextColor="#FFFFFF"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" InputTransparent="True" />
            </Border>
        </Grid>
    </Border>
</ContentView>
