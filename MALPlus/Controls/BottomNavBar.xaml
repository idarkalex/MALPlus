<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MALPlus.Controls.BottomNavBar"
             BackgroundColor="{StaticResource EmSheet}">
    <ContentView.Resources>
        <Style x:Key="BottomNavButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="VerticalOptions" Value="Fill" />
            <Style.Triggers>
                <Trigger TargetType="Button" Property="IsPressed" Value="True">
                    <Setter Property="BackgroundColor" Value="#260066FF" />
                    <Setter Property="Scale" Value="0.97" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ContentView.Resources>
    <!-- No Stroke here on purpose. A 1px #14FFFFFF ring drew a line down both sides and along the
         bottom of the navigation bar, which read as the bar being boxed in rather than as a bar.
         The Padding is what sets the bar's height and stays.

         The Anime and Manga cells used to carry a third child, a "⋮" button right next to the
         icon, to reach the list status filter. The four tabs were already centred exactly, but the
         dots sat inside the Anime and Manga cells only, so the eye read those two clusters as
         shifted right and the row as a whole as off centre. The status filter now lives in its own
         bar at the top of the list page, which says which status you are looking at instead of
         hiding it behind a glyph, and these cells hold nothing but the icon and its label. -->
    <Border Padding="0,4,0,6">
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="0">
            <Grid Grid.Column="0" ColumnDefinitions="*">
                <Button x:Name="DiscoverButton" Clicked="OnDiscoverTapped"
                        Style="{StaticResource BottomNavButtonStyle}"
                        AutomationId="BottomNavDiscoverButton"
                        SemanticProperties.Description="Discover"
                        SemanticProperties.Hint="Navigate to the Discover section" />
                <VerticalStackLayout InputTransparent="True" Spacing="2"
                                     HorizontalOptions="Fill" VerticalOptions="Center">
                    <Image x:Name="DiscoverIcon" Source="discover_home.svg"
                           WidthRequest="24" HeightRequest="24" Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label x:Name="DiscoverLabel" Text="Discover" FontFamily="InterSemiBold" FontSize="10"
                           TextColor="{StaticResource BrushText}" HorizontalOptions="Fill"
                           LineBreakMode="NoWrap" MaxLines="1" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <Grid Grid.Column="1" ColumnDefinitions="*">
                <Button x:Name="AnimeButton" Clicked="OnAnimeTapped"
                        Style="{StaticResource BottomNavButtonStyle}"
                        AutomationId="BottomNavAnimeButton"
                        SemanticProperties.Description="Anime"
                        SemanticProperties.Hint="Navigate to the Anime section" />
                <VerticalStackLayout InputTransparent="True" Spacing="2"
                                     HorizontalOptions="Fill" VerticalOptions="Center">
                    <Image x:Name="AnimeIcon" Source="anime_list.svg"
                           WidthRequest="24" HeightRequest="24" Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label x:Name="AnimeLabel" Text="Anime" FontFamily="InterSemiBold" FontSize="10"
                           TextColor="{StaticResource BrushText}" HorizontalOptions="Fill"
                           LineBreakMode="NoWrap" MaxLines="1" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <Grid Grid.Column="2" ColumnDefinitions="*">
                <Button x:Name="MangaButton" Clicked="OnMangaTapped"
                        Style="{StaticResource BottomNavButtonStyle}"
                        AutomationId="BottomNavMangaButton"
                        SemanticProperties.Description="Manga"
                        SemanticProperties.Hint="Navigate to the Manga section" />
                <VerticalStackLayout InputTransparent="True" Spacing="2"
                                     HorizontalOptions="Fill" VerticalOptions="Center">
                    <Image x:Name="MangaIcon" Source="manga_books.svg"
                           WidthRequest="24" HeightRequest="24" Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label x:Name="MangaLabel" Text="Manga" FontFamily="InterSemiBold" FontSize="10"
                           TextColor="{StaticResource BrushText}" HorizontalOptions="Fill"
                           LineBreakMode="NoWrap" MaxLines="1" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <Grid Grid.Column="3" ColumnDefinitions="*">
                <Button x:Name="MoreButton" Clicked="OnMoreTapped"
                        Style="{StaticResource BottomNavButtonStyle}"
                        AutomationId="BottomNavMoreButton"
                        SemanticProperties.Description="More"
                        SemanticProperties.Hint="Navigate to the More section" />
                <VerticalStackLayout InputTransparent="True" Spacing="2"
                                     HorizontalOptions="Fill" VerticalOptions="Center">
                    <Image x:Name="MoreIcon" Source="more_dots.svg"
                           WidthRequest="24" HeightRequest="24" Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label x:Name="MoreLabel" Text="More" FontFamily="InterSemiBold" FontSize="10"
                           TextColor="{StaticResource BrushText}" HorizontalOptions="Fill"
                           LineBreakMode="NoWrap" MaxLines="1" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Border>
</ContentView>
