<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MALPlus.Controls.BottomNavBar"
             BackgroundColor="{DynamicResource EmSheet}">
    <ContentView.Resources>
        <Style x:Key="BottomNavButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="VerticalOptions" Value="Fill" />
            <Style.Triggers>
                <Trigger TargetType="Button" Property="IsPressed" Value="True">
                    <Setter Property="BackgroundColor" Value="#260066FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ContentView.Resources>
    <!-- Padding sets the bar's spacing: 4dp top, 6dp bottom -->
    <Border Padding="0,4,0,6">
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="0">
            <!-- Discover -->
            <Grid Grid.Column="0">
                <Grid RowDefinitions="24,Auto" RowSpacing="2"
                      HorizontalOptions="Fill" VerticalOptions="Center"
                      InputTransparent="True">
                    <Image Grid.Row="0" x:Name="DiscoverIcon" Source="discover_compass.png"
                           WidthRequest="24" HeightRequest="24" Aspect="AspectFit"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Row="1" x:Name="DiscoverLabel" Text="Discover"
                           FontFamily="InterSemiBold" FontSize="10"
                           TextColor="{StaticResource BrushText}"
                           HorizontalOptions="Fill" HorizontalTextAlignment="Center" />
                </Grid>
                <Button x:Name="DiscoverButton" Clicked="OnDiscoverTapped"
                        Style="{StaticResource BottomNavButtonStyle}"
                        AutomationId="BottomNavDiscoverButton"
                        SemanticProperties.Description="Discover"
                        SemanticProperties.Hint="Navigate to the Discover section" />
            </Grid>

            <!-- Anime -->
            <Grid Grid.Column="1">
                <Grid RowDefinitions="24,Auto" RowSpacing="2"
                      HorizontalOptions="Fill" VerticalOptions="Center"
                      InputTransparent="True">
                    <Image Grid.Row="0" x:Name="AnimeIcon" Source="anime_list.png"
                           WidthRequest="24" HeightRequest="24" Aspect="AspectFit"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Row="1" x:Name="AnimeLabel" Text="Anime"
                           FontFamily="InterSemiBold" FontSize="10"
                           TextColor="{StaticResource BrushText}"
                           HorizontalOptions="Fill" HorizontalTextAlignment="Center" />
                </Grid>
                <Button x:Name="AnimeButton" Clicked="OnAnimeTapped"
                        Style="{StaticResource BottomNavButtonStyle}"
                        AutomationId="BottomNavAnimeButton"
                        SemanticProperties.Description="Anime"
                        SemanticProperties.Hint="Navigate to the Anime section" />
            </Grid>

            <!-- Manga -->
            <Grid Grid.Column="2">
                <Grid RowDefinitions="24,Auto" RowSpacing="2"
                      HorizontalOptions="Fill" VerticalOptions="Center"
                      InputTransparent="True">
                    <Image Grid.Row="0" x:Name="MangaIcon" Source="manga_books.png"
                           WidthRequest="24" HeightRequest="24" Aspect="AspectFit"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Row="1" x:Name="MangaLabel" Text="Manga"
                           FontFamily="InterSemiBold" FontSize="10"
                           TextColor="{StaticResource BrushText}"
                           HorizontalOptions="Fill" HorizontalTextAlignment="Center" />
                </Grid>
                <Button x:Name="MangaButton" Clicked="OnMangaTapped"
                        Style="{StaticResource BottomNavButtonStyle}"
                        AutomationId="BottomNavMangaButton"
                        SemanticProperties.Description="Manga"
                        SemanticProperties.Hint="Navigate to the Manga section" />
            </Grid>

            <!-- More -->
            <Grid Grid.Column="3">
                <Grid RowDefinitions="24,Auto" RowSpacing="2"
                      HorizontalOptions="Fill" VerticalOptions="Center"
                      InputTransparent="True">
                    <Image Grid.Row="0" x:Name="MoreIcon" Source="more_dots.png"
                           WidthRequest="24" HeightRequest="24" Aspect="AspectFit"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Row="1" x:Name="MoreLabel" Text="More"
                           FontFamily="InterSemiBold" FontSize="10"
                           TextColor="{StaticResource BrushText}"
                           HorizontalOptions="Fill" HorizontalTextAlignment="Center" />
                </Grid>
                <Button x:Name="MoreButton" Clicked="OnMoreTapped"
                        Style="{StaticResource BottomNavButtonStyle}"
                        AutomationId="BottomNavMoreButton"
                        SemanticProperties.Description="More"
                        SemanticProperties.Hint="Navigate to the More section" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
