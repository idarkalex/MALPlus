<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             x:Class="MALPlus.Controls.AnimePosterCard"
             x:Name="PosterCard">
    <ContentView.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </ContentView.Resources>

    <Grid BackgroundColor="#0D0D0D">
        <Image Source="{Binding PosterUrl, Source={x:Reference PosterCard}, Converter={StaticResource ImageConverter}}"
               Aspect="AspectFill" />

        <VerticalStackLayout Spacing="4" Margin="6,6,0,0"
                             HorizontalOptions="Start" VerticalOptions="Start">
            <Border Padding="6,2" StrokeShape="RoundRectangle 6"
                    BackgroundColor="#0066FF" Stroke="Transparent"
                    HorizontalOptions="Start"
                    IsVisible="{Binding TypeTag, Source={x:Reference PosterCard}, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}">
                <Label Text="{Binding TypeTag, Source={x:Reference PosterCard}}"
                       FontFamily="InterBold" FontSize="9" TextColor="White" MaxLines="1" />
            </Border>

            <!-- Mean score, same tag as the type, right under it. Tops and search used to print
                 "Score 8.72" in the counter pill instead. -->
            <Border Padding="6,2" StrokeShape="RoundRectangle 6"
                    BackgroundColor="#0066FF" Stroke="Transparent"
                    HorizontalOptions="Start"
                    IsVisible="{Binding ScoreTag, Source={x:Reference PosterCard}, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}">
                <Label Text="{Binding ScoreTag, Source={x:Reference PosterCard}}"
                       FontFamily="InterBold" FontSize="9" TextColor="White" MaxLines="1" />
            </Border>

            <!-- Season chip (e.g. 'Fall 24'), 3rd tag under score -->
            <Border Padding="6,2" StrokeShape="RoundRectangle 6"
                    BackgroundColor="#0066FF" Stroke="Transparent"
                    HorizontalOptions="Start"
                    IsVisible="{Binding SeasonTag, Source={x:Reference PosterCard}, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}">
                <Label Text="{Binding SeasonTag, Source={x:Reference PosterCard}}"
                       FontFamily="InterBold" FontSize="9" TextColor="White" MaxLines="1" />
            </Border>

            <VerticalStackLayout Spacing="0"
                                 HorizontalOptions="Start"
                                 BindableLayout.ItemsSource="{Binding ChipSource, Source={x:Reference PosterCard}}"
                                 BindableLayout.ItemTemplate="{Binding ChipTemplate, Source={x:Reference PosterCard}}"
                                 IsVisible="{Binding ChipSource, Source={x:Reference PosterCard}, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}" />
        </VerticalStackLayout>

        <!-- Top-right counter pill: status, episodes watched and countdown. Styled in solid blue matching the left chips -->
        <Border BackgroundColor="#0066FF" Stroke="Transparent" StrokeThickness="0"
                StrokeShape="RoundRectangle 6" Padding="6,2"
                HorizontalOptions="End" VerticalOptions="Start"
                Margin="0,6,6,0"
                IsVisible="{Binding HasBadge, Source={x:Reference PosterCard}}">
            <VerticalStackLayout Spacing="2" HorizontalOptions="End">
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="{Binding BadgeAccent, Source={x:Reference PosterCard}}"
                           FontFamily="InterBold" FontSize="9"
                           TextColor="{Binding BadgeAccentColor, Source={x:Reference PosterCard}}" VerticalOptions="Center"
                           IsVisible="{Binding BadgeAccent, Source={x:Reference PosterCard}, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}" />
                    <Label Text="{Binding BadgeMain, Source={x:Reference PosterCard}}"
                           FontFamily="InterBold" FontSize="9" TextColor="White" VerticalOptions="Center"
                           IsVisible="{Binding BadgeMain, Source={x:Reference PosterCard}, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}" />
                    <BoxView WidthRequest="1" HeightRequest="10" Color="#59FFFFFF"
                             VerticalOptions="Center"
                             IsVisible="{Binding HasBadgeExtra, Source={x:Reference PosterCard}}" />
                    <Label Text="{Binding BadgeExtra, Source={x:Reference PosterCard}}"
                           FontFamily="InterBold" FontSize="9" TextColor="White"
                           VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation"
                           IsVisible="{Binding HasBadgeExtraTop, Source={x:Reference PosterCard}}" />
                </HorizontalStackLayout>
                <Label Text="{Binding BadgeExtra, Source={x:Reference PosterCard}}"
                       FontFamily="InterBold" FontSize="9"
                       TextColor="#C0E0FF"
                       HorizontalOptions="End" VerticalOptions="Center"
                       MaxLines="1" LineBreakMode="TailTruncation"
                       IsVisible="{Binding IsAiringExtra, Source={x:Reference PosterCard}}" />
            </VerticalStackLayout>
        </Border>

        <!-- Tag and note indicators, on the same line as the score chip under the type chip. Tag on the
             left, note on the right, so the pair reads in the order MAL's edit form lists them.
             The 30 is the score chip's top measured from the card edge on a 480dpi device: the left
             stack is 6dp down, the type chip is about 18dp tall and the stack spacing is 4, which
             puts the second chip at 30. Sitting lower than that reads as a third badge floating
             under the counter pill rather than as part of the chip column.
             The chip is a translucent black with a black outline and a white glyph: it sits on
             artwork that can be anything, and the outline is what keeps it off a white sky.
             Off unless the grid asked for them, which only the anime library list does. -->
        <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Start"
                               Margin="0,30,6,0" Spacing="4"
                               IsVisible="{Binding HasAnyIndicator, Source={x:Reference PosterCard}}"
                               InputTransparent="True">
            <Border WidthRequest="18" HeightRequest="18" Padding="0" StrokeShape="RoundRectangle 5"
                    BackgroundColor="#99000000" Stroke="Black" StrokeThickness="1"
                    IsVisible="{Binding HasTagIndicator, Source={x:Reference PosterCard}}">
                <Image Source="icon_tag" WidthRequest="11" HeightRequest="11" Aspect="AspectFit"
                       Opacity="0.75" />
            </Border>
            <Border WidthRequest="18" HeightRequest="18" Padding="0" StrokeShape="RoundRectangle 5"
                    BackgroundColor="#99000000" Stroke="Black" StrokeThickness="1"
                    IsVisible="{Binding HasNoteIndicator, Source={x:Reference PosterCard}}">
                <Image Source="icon_note" WidthRequest="11" HeightRequest="11" Aspect="AspectFit"
                       Opacity="0.75" />
            </Border>
        </HorizontalStackLayout>

        <!-- Bottom scrim: this is what makes the title readable now that it is a plain
             Label. The outline used to come from an OutlinedLabel, i.e. an
             SKCanvasView, which on Android is a TextureView: the grid kept ~30 of
             them alive and each cell bind created and measured one. -->
        <Border IsVisible="{Binding TitleOverlay, Source={x:Reference PosterCard}}"
                StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.45" />
                    <GradientStop Color="#B3000000" Offset="0.75" />
                    <GradientStop Color="#E6000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Ranking, for the Top panels only. Sits above the title strip rather than inside it: the
             title is 32dp tall and runs the full width, so a chip sharing that space either
             overlaps long titles or the grid grows for one panel. 40dp of bottom margin clears it
             with a hair of gap, and the title stays at full width underneath.

             Same blue as the type and score tags on the same card, so it reads as part of that
             family instead of a fourth kind of badge. -->
        <Border Padding="6,2" StrokeShape="RoundRectangle 6"
                BackgroundColor="#0066FF" Stroke="Transparent"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,6,40"
                InputTransparent="True"
                IsVisible="{Binding HasRank, Source={x:Reference PosterCard}}">
            <Label Text="{Binding RankTag, Source={x:Reference PosterCard}}"
                   FontFamily="InterBold" FontSize="9" TextColor="White" MaxLines="1" />
        </Border>

        <!-- The label box is two lines tall so long titles have room, which used to leave a one
             line hole under a short title. Anchoring the text to the bottom keeps every card's
             title sitting on the same baseline. -->
        <Label Text="{Binding Title, Source={x:Reference PosterCard}}"
               FontFamily="Inter" FontSize="11"
               TextColor="White"
               MaxLines="2" LineBreakMode="TailTruncation"
               HeightRequest="32" VerticalOptions="End"
               VerticalTextAlignment="End"
               Margin="6,0,6,4" InputTransparent="True"
               IsVisible="{Binding TitleOverlay, Source={x:Reference PosterCard}}" />
    </Grid>

    <!-- The long press lives here, on the shared card, rather than in each grid's template: every
         poster in the app is an AnimePosterCard, so putting it in the templates would have meant
         adding it five times and would still have missed any grid added later. Tap and long press
         coexist on the same element, so a normal tap still opens the entry. -->
    <ContentView.GestureRecognizers>
        <LongPressGestureRecognizer LongPressed="OnLongPressed" />
    </ContentView.GestureRecognizers>
</ContentView>
