<?xml version="1.0" encoding="utf-8" ?>
<!-- The options panel, shared by the poster long press and the details overflow menu.

     Two shapes out of one control. The full sheet is what the redesign mockup describes, for the
     details overflow: anchored above the navigation, with a handle, a title and a subtitle. The
     compact one is what a poster long press wants: a small floating card in the middle with no
     chrome at all, because on a grid the card is already covering what the menu is about, and a
     title naming the entry again is the largest thing on a panel that should be five rows tall.

     Geometry is the mockup's, on the EM palette the rest of the app already uses: 32dp top corners,
     48dp rows with 12dp corners, a 32dp icon chip with a 16dp glyph, hairline separators and the
     destructive row last. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MALPlus.Controls.OptionsSheet"
             x:Name="Root"
             IsVisible="False"
             InputTransparent="False">
    <Grid>
        <!-- Scrim. Transparent rather than a real fill is not an oversight: it is what makes it
             hit tested on Android, so tapping outside closes the panel. -->
        <Grid BackgroundColor="Transparent" InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <Border x:Name="Panel"
                HorizontalOptions="Fill" VerticalOptions="End"
                Margin="0,0,0,58" Padding="0"
                BackgroundColor="{StaticResource EmSheet}"
                StrokeShape="RoundRectangle 28 28 0 0">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <!-- Drag handle, sheet shape only. -->
                <BoxView x:Name="Handle" Grid.Row="0" WidthRequest="40" HeightRequest="4"
                         CornerRadius="2" Color="#33FFFFFF"
                         HorizontalOptions="Center" Margin="0,10,0,4" />

                <Grid x:Name="Header" Grid.Row="1" ColumnDefinitions="*,Auto" Margin="20,6,12,10">
                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                        <Label x:Name="TitleLabel" Text="Options" FontFamily="InterBold" FontSize="16"
                               TextColor="{StaticResource BrushText}" />
                        <Label x:Name="SubtitleLabel" Text="" FontFamily="InterMedium" FontSize="11"
                               TextColor="#8FA8C0" LineBreakMode="TailTruncation" MaxLines="1"
                               IsVisible="False" />
                    </VerticalStackLayout>
<Border Grid.Column="1" x:Name="CloseButton" WidthRequest="32" HeightRequest="32"
                                StrokeShape="RoundRectangle 16" BackgroundColor="#14FFFFFF" Padding="0"
                                VerticalOptions="Center">
                        <Image Source="icon_close" WidthRequest="18" HeightRequest="18"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnScrimTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Rows. A VerticalStackLayout rather than a CollectionView: there are never more
                     than a handful, and a second collection fighting the grid underneath for the same
                     touch is a known way to lose a tap entirely.

                     The rows are Auto, not star: a star row hands this ScrollView every pixel left on
                     the page, so a seven row menu rendered as a 520dp panel with half of it empty. The
                     cap lives on the ScrollView instead, which is what lets the long lists (score is
                     eleven rows) scroll while a short one shrink wraps. -->
                <ScrollView x:Name="RowsScroll" Grid.Row="2">
                    <VerticalStackLayout x:Name="ItemsHost" Spacing="2" Padding="12,0" />
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</ContentView>
