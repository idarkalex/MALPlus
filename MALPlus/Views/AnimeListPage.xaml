<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             xmlns:vm="clr-namespace:MALClient.XShared.ViewModels.Main;assembly=MALPlus.Core"
             xmlns:itemvm="clr-namespace:MALClient.XShared.ViewModels;assembly=MALPlus.Core"
             x:Class="MALPlus.Views.AnimeListPage"
             x:DataType="vm:AnimeListViewModel"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:IntEqualityConverter x:Key="IntEq" />
    </ContentPage.Resources>

    <!-- Status bar on top, season bar above the navigation, grid in between. The status selector
         used to be a "⋮" glyph inside the Anime and Manga cells of the navigation bar, which made
         those two clusters read as off centre; here it can also say which status is being shown
         instead of hiding it behind a glyph. Both bars are Auto rows, so they collapse to nothing
         in the modes that do not use them.

         Neither bar draws a Stroke, not even a hairline: a rule above and below turned the block
         into two stacked framed boxes and fought the grid underneath it. The fill alone is enough
         to separate them from EmBackground. -->
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- The top bar states what the panel is showing: the list status in the normal list, or the
             genre/studio that was tapped on a details page. The chevron sits next to that word rather
             than at the far edge, so the pair reads as one control, and the magnifier on the right
             filters whatever the panel is currently showing.

             Neither bar draws a Stroke, not even a hairline: a rule above and below turned the block
             into two stacked framed boxes and fought the grid underneath it. The fill alone is enough
             to separate them from EmBackground. -->
        <Border x:Name="StatusBar" Grid.Row="0" IsVisible="False"
                BackgroundColor="{StaticResource EmSheet}" Padding="14,0" HeightRequest="52">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <!-- Left aligned, chevron tucked against the word so the pair reads as one control
                     instead of two things fighting for opposite ends of the bar. -->
                <HorizontalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="StatusLabel" Text="Watching"
                           FontFamily="InterSemiBold" FontSize="16" TextColor="{StaticResource BrushText}"
                           VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <!-- A solid 28dp chevron inside a soft circle. It used to be the "▾" glyph at
                         14sp in #A0FFFFFF, which read as a dim smudge next to a 16sp label. -->
                    <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16"
                            BackgroundColor="#14FFFFFF" Padding="0" VerticalOptions="Center">
                        <Image Source="icon_arrow_down_solid" WidthRequest="28" HeightRequest="28"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStatusDropdownTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

                <!-- Fills what the magnifier leaves behind, so it reaches the right edge of the bar
                     instead of floating in the middle with dead space beside it. It used to sit in an
                     Auto column at a fixed 200dp, which is what left that gap. -->
                <Border Grid.Column="1" x:Name="PanelFilterBox" IsVisible="False"
                        StrokeShape="RoundRectangle 18" Stroke="#24405A" StrokeThickness="1"
                        BackgroundColor="#0F2536" Padding="12,0,4,0" HeightRequest="36"
                        VerticalOptions="Center" HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- No placeholder: the field sits next to the panel it filters, so the word
                             "Filter" only repeated what the magnifier already said. The underline
                             and the theme's vertical padding are both stripped in code, because
                             neither is reachable from XAML and both belong to the themed background. -->
                        <Entry x:Name="PanelFilterEntry" Grid.Column="0"
                               FontFamily="Inter" FontSize="14" TextColor="{StaticResource BrushText}"
                               HeightRequest="34" VerticalOptions="Center"
                               Text="{Binding PanelFilter}" />
                        <Border Grid.Column="1" WidthRequest="28" HeightRequest="28"
                                StrokeShape="RoundRectangle 14" BackgroundColor="#14FFFFFF" Padding="0"
                                VerticalOptions="Center">
                            <Image Source="icon_close" WidthRequest="16" HeightRequest="16"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClearPanelFilter" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" x:Name="PanelFilterButton" WidthRequest="32" HeightRequest="32"
                        StrokeShape="RoundRectangle 16" BackgroundColor="#14FFFFFF" Padding="0"
                        VerticalOptions="Center">
                    <Image Source="icon_search" WidthRequest="22" HeightRequest="22"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPanelFilterTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <!-- No IsRefreshing binding. The gesture sets the flag itself and the reload is awaited
             in OnRefreshing, which puts it away in a finally; a one way binding to Loading could
             only fight that and won, because Loading stays true on a list that already has
             items, and the arrow up top spun forever. -->
        <RefreshView x:Name="ListRefresh" Grid.Row="1" Refreshing="OnRefreshing">
            <!-- One component for every poster grid in the app: the list, Related, Search and
                 Discover all get their span, cell size and spacing from AnimePosterGrid.
                 It binds DisplayedItems rather than AnimeItems so the magnifier can narrow the
                 panel without touching the collection the infinite scroll appends to. -->
            <controls:AnimePosterGrid x:Name="AnimeGrid" ItemsSource="{Binding DisplayedItems}" />
        </RefreshView>

        <Label Text="{Binding EmptyNoticeContent}" IsVisible="{Binding EmptyNoticeVisibility}"
               FontFamily="Inter" FontSize="14" TextColor="{StaticResource BrushText}"
               HorizontalOptions="Center" VerticalOptions="Center"
               Grid.Row="1" />

        <VerticalStackLayout IsVisible="{Binding LoadErrorVisibility}" Grid.Row="1"
                             HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
            <Label Text="{Binding LoadError}" FontFamily="InterSemiBold" FontSize="15"
                   TextColor="{StaticResource EmAccent}" HorizontalOptions="Center" />
            <Label Text="Pull down to retry" FontFamily="Inter" FontSize="12"
                   TextColor="#B3FFFFFF" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Separate from the empty-list notice on purpose: this one means the panel has content and
             the magnifier matched none of it, which is a different thing to say and a different way
             out. -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding PanelFilterEmpty}"
                             HorizontalOptions="Center" VerticalOptions="Center" Spacing="10"
                             InputTransparent="True">
            <Label Text="Nothing matches that here" FontFamily="InterSemiBold" FontSize="15"
                   TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
            <Label Text="The magnifier only looks inside this panel" FontFamily="Inter" FontSize="12"
                   TextColor="#8FA8C0" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Seasonal only: which season is on screen, and the two seasons next to it. The selector
             itself is filled from the same Tenrai seasons list the query uses, so it costs nothing
             extra. It sits directly above the navigation bar so it never moves the grid. -->
        <Border x:Name="SeasonBar" Grid.Row="2" IsVisible="False"
                BackgroundColor="{StaticResource EmSheet}" Padding="10,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17"
                        BackgroundColor="#14FFFFFF" Padding="0" VerticalOptions="Center">
                    <Image Source="icon_chevron_left" WidthRequest="26" HeightRequest="26"
                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSeasonPreviousTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                </Border>
                <Button x:Name="SeasonPicker" Grid.Column="1" Text="Season" Clicked="OnSeasonPickerTapped"
                        FontFamily="InterSemiBold" FontSize="15"
                        TextColor="{StaticResource BrushText}" BackgroundColor="Transparent"
                        BorderColor="Transparent" BorderWidth="0" Padding="0" HeightRequest="44"
                        AutomationId="SeasonPicker" />
                <Border Grid.Column="2" WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17"
                        BackgroundColor="#14FFFFFF" Padding="0" VerticalOptions="Center">
                    <Image Source="icon_chevron_right" WidthRequest="26" HeightRequest="26"
                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSeasonNextTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                </Border>
            </Grid>
        </Border>

        <!-- The dropdown hangs off the bar it belongs to, anchored to the START so it lines up with the word
             in the bar rather than floating on the opposite side.

             Two measured details are worth keeping. It has no left margin: with one, the poster grid
             showed through in a vertical strip beside the panel, which read as a notch rather than as
             a panel hanging off a bar. The 14dp that lines the rows up with the label moved into the
             padding instead, where it costs nothing visually.

             And it overlaps the bar by 3dp. Measured on the device, the bar ended at y=266 and the
             panel began at y=269: a real 2px slit with the grid showing through, which is exactly
             the pixel gap this is here to remove. Overlapping cannot leave a gap between two fills of
             the same colour no matter what rounding the shape applies. -->
        <Grid x:Name="StatusDropdownOverlay" Grid.Row="1" Grid.RowSpan="2" IsVisible="False"
              InputTransparent="False">
            <Grid BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStatusDropdownDismissed" />
                </Grid.GestureRecognizers>
            </Grid>
            <Border HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="266"
                    Margin="0,-3,0,0" Padding="14,8"
                    BackgroundColor="{StaticResource EmSheet}" StrokeShape="RoundRectangle 0 0 16 16">
                <VerticalStackLayout x:Name="StatusDropdownList" Spacing="0" />
            </Border>
        </Grid>

        <controls:BottomNavBar x:Name="BottomNav" Grid.Row="3" />
    </Grid>
</ContentPage>
