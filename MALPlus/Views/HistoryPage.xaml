<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.HistoryPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding LoadingVisibility}" BackgroundColor="#80000000" ZIndex="99">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                                   WidthRequest="36" HeightRequest="36" />
                <Label Text="Loading history..." FontFamily="Inter" FontSize="13"
                       TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <RefreshView IsRefreshing="{Binding LoadingVisibility}" Refreshing="OnRefreshing"
                     IsVisible="{Binding LoadingVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <Grid RowDefinitions="Auto,*" RowSpacing="0">
                <!-- One page per type, as MAL itself splits it. The list used to be a single flat
                     run of everything, which made it long and unmixable. -->
                <HorizontalStackLayout Grid.Row="0" Padding="16,4,16,8" Spacing="8">
                    <Button x:Name="TabAll" Text="All" FontFamily="InterSemiBold" FontSize="12"
                            Padding="14,4" CornerRadius="14" BackgroundColor="{StaticResource EmAccent}"
                            TextColor="White" BorderWidth="0" Clicked="OnTypeTabTapped" CommandParameter="All" />
                    <Button x:Name="TabAnime" Text="Anime" FontFamily="InterSemiBold" FontSize="12"
                            Padding="14,4" CornerRadius="14" BackgroundColor="#141d2b"
                            TextColor="#9FB3C8" BorderWidth="0" Clicked="OnTypeTabTapped" CommandParameter="Anime" />
                    <Button x:Name="TabManga" Text="Manga" FontFamily="InterSemiBold" FontSize="12"
                            Padding="14,4" CornerRadius="14" BackgroundColor="#141d2b"
                            TextColor="#9FB3C8" BorderWidth="0" Clicked="OnTypeTabTapped" CommandParameter="Manga" />
                </HorizontalStackLayout>

                <CollectionView x:Name="HistoryList" Grid.Row="1" SelectionMode="Single"
                                SelectionChanged="OnHistoryEntrySelected"
                                Scrolled="OnHistoryScrolled"
                                RemainingItemsThreshold="8"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <Label Text="No history yet" FontFamily="Inter" FontSize="13"
                           TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="16,4" BackgroundColor="{StaticResource EmSheet}"
                                Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" Padding="10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHistoryEntryTapped"
                                                      CommandParameter="{Binding Value.Item1}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                <Image Grid.Column="0" Source="{Binding Value.Item1.ImgUrl, Converter={StaticResource ImageConverter}}"
                                       WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Value.Item1.Title}" FontFamily="InterBold" FontSize="13"
                                           TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                                    <Label FontFamily="Inter" FontSize="11" TextColor="#80FFFFFF">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Value.Item2[0].ShowUnit" />
                                                <Binding Path="Value.Item2[0].WatchedEpisode" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Key}" FontFamily="InterSemiBold" FontSize="11"
                                           TextColor="{StaticResource EmAccent}" HorizontalOptions="End" />
                                    <Label Text="{Binding Value.Item2[0].Date}"
                                           FontFamily="Inter" FontSize="11" TextColor="#80FFFFFF"
                                           HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <VerticalStackLayout Spacing="8" Padding="16,12,16,36" HorizontalOptions="Center">
                        <!-- Loading spinner when reading another page -->
                        <ActivityIndicator IsRunning="{Binding LoadingMore}" Color="{StaticResource EmAccent}"
                                           WidthRequest="24" HeightRequest="24" Margin="0,4"
                                           IsVisible="{Binding LoadingMore}" />

                        <!-- End of History Card -->
                        <Border BackgroundColor="#141D2B" Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 10" Padding="16,12"
                                IsVisible="{Binding LoadingVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Image Source="icon_check" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                                    <Label Text="You're all caught up" FontFamily="InterBold" FontSize="13"
                                           TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="MyAnimeList preserves activity logs for up to 3 weeks."
                                       FontFamily="Inter" FontSize="11" TextColor="#8899A6"
                                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
            </Grid>
        </RefreshView>
    </Grid>
</ContentPage>
