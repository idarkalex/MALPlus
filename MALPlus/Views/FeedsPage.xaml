<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
xmlns:vm="clr-namespace:MALPlus.XShared.ViewModels.Main;assembly=MALPlus.Core"
xmlns:mmalspecific="clr-namespace:MALPlus.Models.Models.MalSpecific;assembly=MALPlus.Core"
             x:Class="MALPlus.Views.FeedsPage"
             x:DataType="vm:FriendsFeedsViewModel"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- The page had no header at all, so the first row of cards started at the very top of the
             window and ran up under the status bar. The other pages all carry a title band; this one
             now does too. -->
        <Label Grid.Row="0" Text="Friends activity" FontFamily="InterBold" FontSize="22"
               TextColor="{StaticResource BrushText}" Padding="16,12" />

        <RefreshView Grid.Row="1" IsRefreshing="{Binding Loading}" Refreshing="OnRefreshing">
            <CollectionView ItemsSource="{Binding Feeds}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Label Text="No activity yet" FontFamily="InterBold" FontSize="16"
                               TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
                        <Label Text="Follow some friends to see their updates"
                               FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate
                    x:DataType="mmalspecific:UserFeedEntryModel">
                        <Border Margin="16,4" BackgroundColor="{StaticResource EmSheet}"
                                Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" Padding="12">
                            <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                        StrokeShape="RoundRectangle 18"
                                        Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                                    <Image Source="{Binding User.ImgUrl, Converter={StaticResource ImageConverter}}"
                                           Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Header}" FontFamily="InterBold" FontSize="13"
                                           TextColor="{StaticResource BrushText}" MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Description}" FontFamily="Inter" FontSize="12"
                                           TextColor="#C0FFFFFF" MaxLines="3" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="12"
                                           TextColor="{StaticResource EmAccent}" MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <!-- Third column of three. It used to be laid out as part of the text
                                     column, so there was nowhere to show when the activity happened. -->
                                <Label Grid.Column="2" Text="{Binding Date, StringFormat='{0:d MMM}'}"
                                       FontFamily="Inter" FontSize="11" TextColor="#80FFFFFF"
                                       VerticalOptions="Start" MaxLines="1" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
