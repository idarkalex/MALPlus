<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
               xmlns:controls="clr-namespace:MALPlus.Controls"
               xmlns:vm="clr-namespace:MALPlus.XShared.ViewModels;assembly=MALPlus.Core"
               x:Class="MALPlus.Views.AnimeDetailsPage"

             x:Name="DetailsPage"
             Shell.PresentationMode="NotAnimated"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:IntEqualityConverter x:Key="IntEq" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:BoolToColorConverter x:Key="BoolColor" />
        <converters:AiringStatusVisibilityConverter x:Key="AiringStatus" />
        <converters:MultiAndConverter x:Key="MultiAnd" />

        <Style x:Key="TabLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="InterSemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#B3FFFFFF" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Padding" Value="0,7" />
        </Style>

        <!-- Section titles sit OUTSIDE the panel. Inside a card a label reads as a field of that
             card; above it, with the border below, it reads as the heading of what follows. -->
        <Style x:Key="SectionLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="InterBold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextColor" Value="#8FA8C0" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="Margin" Value="2,16,2,6" />
        </Style>

        <Style x:Key="StateTextStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource BrushText}" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>

        <DataTemplate x:Key="EpisodeTemplate">
            <Border Margin="12,4" Style="{StaticResource PanelStyle}" Padding="14,11">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEpisodeTapped" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                    <Label Text="{Binding EpisodeId, StringFormat='Ep {0}'}"
                           FontFamily="InterBold" FontSize="14" TextColor="#0066FF"
                           VerticalOptions="Center" MinimumWidthRequest="52" MaxLines="1" />
                    <Label Grid.Column="1" Text="{Binding Title}" FontFamily="Inter" FontSize="14"
                           TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation"
                           VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="est." FontFamily="InterSemiBold" FontSize="10" TextColor="#7AB4FF"
                           MaxLines="1" VerticalOptions="Center" IsVisible="{Binding IsEstimated}" />
                    <Label Grid.Column="3" Text="✓" FontFamily="InterBold" FontSize="13" TextColor="#2E9E5B"
                           MaxLines="1" VerticalOptions="Center" IsVisible="{Binding IsWatched}" />
                    <Label Grid.Column="4" Text="{Binding AiredLabel}" FontFamily="Inter" FontSize="11" TextColor="#80FFFFFF"
                           MaxLines="1" VerticalOptions="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReviewTemplate">
            <Border Margin="12,4" Style="{StaticResource PanelStyle}" Padding="14,11">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16"
                                Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                            <Image Source="{Binding AuthorAvatar, Converter={StaticResource ImageConverter}}"
                                   Aspect="AspectFill" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding Author}" FontFamily="InterBold" FontSize="13"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" MaxLines="1"
                               LineBreakMode="TailTruncation" />
                        <Label Grid.Column="2" Text="{Binding OverallRating}" FontFamily="InterBold" FontSize="14"
                               TextColor="#FFD700" VerticalOptions="Center" MaxLines="1" />
                    </Grid>
                    <Label Text="{Binding Review}" FontFamily="Inter" FontSize="12" TextColor="#C0FFFFFF"
                           MaxLines="{Binding ReviewMaxLines}" LineBreakMode="TailTruncation" />
                    <Button Text="{Binding ReviewToggleText}" Clicked="OnReviewMoreClicked"
                            CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderWidth="0"
                            Padding="0" HeightRequest="28" HorizontalOptions="Start"
                            FontFamily="InterSemiBold" FontSize="11" TextColor="#0066FF" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RecommendationTemplate">
            <Border Margin="12,6" Style="{StaticResource PanelStyle}" Padding="12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRecommendationTapped" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="130,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <controls:AnimePosterCard Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                               WidthRequest="130" HeightRequest="195"
                                               VerticalOptions="Start"
                                               PosterUrl="{Binding ImageUrl}"
                                               TitleOverlay="False"
                                               TypeTag="{Binding MediaType}"
                                               BadgeExtra="{Binding AirDayTillBind}" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Title}" FontFamily="InterBold" FontSize="16"
                           TextColor="{StaticResource BrushText}" MaxLines="3" LineBreakMode="TailTruncation"
                           SizeChanged="OnRecommendationTitleSized" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding DescriptionTop}" FontFamily="Inter" FontSize="13"
                           TextColor="#B8C7D8" LineHeight="1.35" MaxLines="9" LineBreakMode="TailTruncation"
                           IsVisible="{Binding HasDescriptionTop}" />
                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding DescriptionBottom}"
                           FontFamily="Inter" FontSize="13"
                           TextColor="#B8C7D8" LineHeight="1.35" MaxLines="6" LineBreakMode="TailTruncation"
                           IsVisible="{Binding HasDescriptionBottom}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RelationChipTemplate">
            <Border Margin="0" Padding="6,2" StrokeShape="RoundRectangle 6"
                    BackgroundColor="#0066FF" Stroke="Transparent">
                <Label Text="{Binding .}" FontFamily="InterBold" FontSize="9" TextColor="White" MaxLines="1" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AnimeCharacterTemplate">
            <Border HeightRequest="100" Margin="12,4" Style="{StaticResource PanelStyle}" Padding="10">
                <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                    <Border WidthRequest="64" HeightRequest="88" StrokeShape="RoundRectangle 6"
                            Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                        <Image Source="{Binding AnimeCharacter.Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                        <Label Text="{Binding AnimeCharacter.Data.Name}" FontFamily="InterBold" FontSize="15"
                               TextColor="{StaticResource BrushText}" MaxLines="1" LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="8">
                            <Border Padding="7,2" StrokeShape="RoundRectangle 6" BackgroundColor="#0066FF"
                                    Stroke="Transparent" IsVisible="{Binding HasRole}">
                                <Label Text="{Binding Role}" FontFamily="InterBold" FontSize="9" TextColor="White"
                                       MaxLines="1" />
                            </Border>
                            <HorizontalStackLayout Spacing="3" IsVisible="{Binding HasFavorites}"
                                                   VerticalOptions="Center">
                                <Label Text="★" FontFamily="Inter" FontSize="9" TextColor="#FFD700"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding FavoritesText}" FontFamily="Inter" FontSize="11"
                                       TextColor="#8FA8C0" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasJapaneseVoice}">
                            <ImageButton Source="{Binding JapaneseVoice.Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                                         Clicked="OnJapaneseVoiceClicked"
                                         CommandParameter="{Binding JapaneseVoice.Data.Id}"
                                         BackgroundColor="Transparent" BorderWidth="0" Aspect="AspectFill"
                                         WidthRequest="26" HeightRequest="26" VerticalOptions="Center" />
                            <Label Text="{Binding JapaneseVoice.Data.Name}" FontFamily="InterSemiBold" FontSize="12"
                                   TextColor="{StaticResource BrushText}" MaxLines="1" LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" WidthRequest="96" />
                            <Label Text="Japanese" FontFamily="Inter" FontSize="10" TextColor="#7AB4FF"
                                   MaxLines="1" VerticalOptions="Center" />
                            <HorizontalStackLayout Spacing="3" IsVisible="{Binding HasVoiceFavorites}"
                                                   VerticalOptions="Center">
                                <Label Text="★" FontFamily="Inter" FontSize="9" TextColor="#FFD700"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding VoiceFavoritesText}" FontFamily="Inter" FontSize="10"
                                       TextColor="#6E8AA6" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MangaCharacterTemplate">
            <Border HeightRequest="100" Margin="12,4" Style="{StaticResource PanelStyle}" Padding="10">
                <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                    <Border WidthRequest="64" HeightRequest="88" StrokeShape="RoundRectangle 6"
                            Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                        <Image Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                        <Label Text="{Binding Name}" FontFamily="InterBold" FontSize="15"
                               TextColor="{StaticResource BrushText}" MaxLines="1" LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="8">
                            <Border Padding="7,2" StrokeShape="RoundRectangle 6" BackgroundColor="#0066FF"
                                    Stroke="Transparent" IsVisible="{Binding HasRole}">
                                <Label Text="{Binding Role}" FontFamily="InterBold" FontSize="9"
                                       TextColor="White" MaxLines="1" />
                            </Border>
                            <HorizontalStackLayout Spacing="3" IsVisible="{Binding HasFavorites}"
                                                   VerticalOptions="Center">
                                <Label Text="★" FontFamily="Inter" FontSize="9" TextColor="#FFD700"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding FavoritesText}" FontFamily="Inter" FontSize="11"
                                       TextColor="#8FA8C0" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Staff is a 3 column grid, not the horizontal 64px-thumbnail row the characters
             use. A long staff list is mostly one-line entries ("Sound Director", "Episode
             Director") where the photo is the only expensive part, and three per row turns a
             40 person list from 4000px of scrolling into 1300. -->
        <DataTemplate x:Key="StaffTemplate">
            <Border Margin="4" Style="{StaticResource PanelStyle}" Padding="8">
                <VerticalStackLayout Spacing="5">
                    <Border HeightRequest="96" StrokeShape="RoundRectangle 6"
                            Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                        <Image Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFill" />
                    </Border>
                    <Label Text="{Binding Name}" FontFamily="InterBold" FontSize="12"
                           TextColor="{StaticResource BrushText}" MaxLines="1" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding RoleLineOne}" FontFamily="InterSemiBold" FontSize="9"
                           TextColor="#7AB4FF" MaxLines="1" LineBreakMode="TailTruncation"
                           IsVisible="{Binding HasRoleLineOne}" />
                    <Label Text="{Binding RoleLineTwo}" FontFamily="InterSemiBold" FontSize="9"
                           TextColor="#7AB4FF" MaxLines="1" LineBreakMode="TailTruncation"
                           IsVisible="{Binding HasRoleLineTwo}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid BackgroundColor="{StaticResource EmSheet}">
        <ScrollView x:Name="PageScroll" Scrolled="OnPageScrolled"
                        SizeChanged="OnPageViewportSizeChanged"
                        VerticalScrollBarVisibility="Never" HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">
                <Grid x:Name="HeaderSpacer" HeightRequest="600" BackgroundColor="Transparent" />

                <Grid x:Name="TabContentHost" BackgroundColor="{StaticResource EmSheet}">
<!-- One tab for what used to be General and Details. The split was costing a tap
                         and duplicating nothing useful, while the four 18sp rank cards were eating
                         the top of the screen and pushing the synopsis, the actual reason for
                         opening the page, below the fold. Everything the hero already prints (year,
                         episode count, score, status, type, next air) is filtered out of the rows
                         in the view model, so nothing is said twice. -->
                    <VerticalStackLayout IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=0}"
                                         Padding="12,4,12,32" Spacing="0">
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=GeneralLoadingVisible}"
                                Style="{StaticResource PanelStyle}" Padding="18" Margin="0,12,0,0">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingGlobal}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading details..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=GeneralErrorVisible}"
                                Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=GeneralErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>

                        <Label Text="SYNOPSIS" Style="{StaticResource SectionLabelStyle}"
                               IsVisible="{Binding Source={x:Reference DetailsPage}, Path=GeneralContentVisible}" />
                        <Border Style="{StaticResource PanelStyle}" Padding="14"
                                IsVisible="{Binding Source={x:Reference DetailsPage}, Path=GeneralContentVisible}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="{Binding Synopsis}" FontFamily="Inter" FontSize="13"
                                       TextColor="{StaticResource BrushText}" LineHeight="1.45"
                                       MaxLines="{Binding SynopsisMaxLines}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SynopsisToggleText}" FontFamily="InterSemiBold" FontSize="11"
                                       TextColor="#7AB4FF" MaxLines="1"
                                       IsVisible="{Binding SynopsisToggleVisible}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSynopsisTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Text="No synopsis available."
                                       IsVisible="{Binding Source={x:Reference DetailsPage}, Path=GeneralSynopsisEmptyVisible}"
                                       FontFamily="Inter" FontSize="12" TextColor="#8FA8C0" MaxLines="1" />
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="GENRES" Style="{StaticResource SectionLabelStyle}"
                               IsVisible="{Binding GenresVisible}" />
                        <Border Style="{StaticResource PanelStyle}" Padding="12"
                                IsVisible="{Binding GenresVisible}">
                            <FlexLayout BindableLayout.ItemsSource="{Binding GenreChips}"
                                        Wrap="Wrap" Direction="Row" JustifyContent="Start"
                                        AlignItems="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DetailChipViewModel">
                                        <!-- BackgroundColor is what makes the chip hit tested: a layout
                                             carrying only a tap recognizer and a transparent fill never
                                             receives the touch on Android. Navigable chips get a real
                                             tint, themes stay flat because there is no list to open. -->
                                        <Border Stroke="#24405A" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                                Padding="9,4" Margin="0,0,6,6"
                                                BackgroundColor="{Binding IsNavigable, Converter={StaticResource BoolColor}, ConverterParameter=#14293D}"
                                                InputTransparent="{Binding IsNavigable, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnChipTapped" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Name}" FontFamily="Inter" FontSize="12"
                                                   TextColor="#D4E4F7" MaxLines="1" InputTransparent="True" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </Border>

                        <Label Text="STUDIOS" Style="{StaticResource SectionLabelStyle}"
                               IsVisible="{Binding StudiosVisible}" />
                        <Border Style="{StaticResource PanelStyle}" Padding="12"
                                IsVisible="{Binding StudiosVisible}">
                            <FlexLayout BindableLayout.ItemsSource="{Binding StudioChips}"
                                        Wrap="Wrap" Direction="Row" JustifyContent="Start"
                                        AlignItems="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DetailChipViewModel">
                                        <Border Stroke="#24405A" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                                Padding="9,4" Margin="0,0,6,6"
                                                BackgroundColor="{Binding IsNavigable, Converter={StaticResource BoolColor}, ConverterParameter=#14293D}"
                                                InputTransparent="{Binding IsNavigable, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnChipTapped" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Name}" FontFamily="Inter" FontSize="12"
                                                   TextColor="#D4E4F7" MaxLines="1" InputTransparent="True" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </Border>

                        <Label Text="DETAILS" Style="{StaticResource SectionLabelStyle}"
                               IsVisible="{Binding Source={x:Reference DetailsPage}, Path=DetailsContentVisible}" />
                        <Border Style="{StaticResource PanelStyle}" Padding="12"
                                IsVisible="{Binding Source={x:Reference DetailsPage}, Path=DetailsContentVisible}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DetailsRows}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="96,*" Padding="0,4" ColumnSpacing="10">
                                            <Label Text="{Binding Item1}" FontFamily="Inter" FontSize="12"
                                                   TextColor="#8FA8C0" MaxLines="1" />
                                            <Label Grid.Column="1" Text="{Binding Item2}" FontFamily="Inter" FontSize="12"
                                                   TextColor="{StaticResource BrushText}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Tenrai's moreinfo is AniDB's note field. On a long show it is pages of
                             crossover trivia, so it only gets a panel when it is short enough to be
                             useful and otherwise has to be expanded on purpose. -->
                        <Label Text="NOTE" Style="{StaticResource SectionLabelStyle}"
                               IsVisible="{Binding MoreInfoVisible}" />
                        <Border Style="{StaticResource PanelStyle}" Padding="12"
                                IsVisible="{Binding MoreInfoVisible}">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding MoreInfoText}" FontFamily="Inter" FontSize="12"
                                       TextColor="#B7CBDD" LineHeight="1.4"
                                       MaxLines="{Binding MoreInfoMaxLines}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding MoreInfoToggleText}" FontFamily="InterSemiBold" FontSize="11"
                                       TextColor="#7AB4FF" MaxLines="1"
                                       IsVisible="{Binding MoreInfoToggleVisible}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMoreInfoTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="ON MAL" Style="{StaticResource SectionLabelStyle}"
                               IsVisible="{Binding MalStatsVisible}" />
                        <Border Style="{StaticResource PanelStyle}" Padding="12"
                                IsVisible="{Binding MalStatsVisible}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MalStatRows}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="96,*" Padding="0,4" ColumnSpacing="10">
                                            <Label Text="{Binding Item1}" FontFamily="Inter" FontSize="12"
                                                   TextColor="#8FA8C0" MaxLines="1" />
                                            <Label Grid.Column="1" Text="{Binding Item2}" FontFamily="Inter" FontSize="12"
                                                   TextColor="{StaticResource BrushText}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="LINKS" Style="{StaticResource SectionLabelStyle}"
                               IsVisible="{Binding LinksVisible}" />
                        <Border Style="{StaticResource PanelStyle}" Padding="12"
                                IsVisible="{Binding LinksVisible}">
                            <FlexLayout BindableLayout.ItemsSource="{Binding LinkChips}"
                                        Wrap="Wrap" Direction="Row" JustifyContent="Start"
                                        AlignItems="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Stroke="#1E3A52" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                                Padding="9,5" Margin="0,0,6,6">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnExternalLinkTapped"
                                                                      CommandParameter="{Binding Url}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Label}" FontFamily="Inter" FontSize="12"
                                                   TextColor="#8FB8E8" MaxLines="1" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </Border>

                        <Label Text="ALT. TITLES" Style="{StaticResource SectionLabelStyle}"
                               IsVisible="{Binding AltTitlesVisible}" />
                        <Border Style="{StaticResource PanelStyle}" Padding="12"
                                IsVisible="{Binding AltTitlesVisible}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding AltTitleRows}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="96,*" Padding="0,4" ColumnSpacing="10">
                                            <Label Text="{Binding Item1}" FontFamily="Inter" FontSize="12"
                                                   TextColor="#8FA8C0" MaxLines="1" />
                                            <Label Grid.Column="1" Text="{Binding Item2}" FontFamily="Inter" FontSize="12"
                                                   TextColor="{StaticResource BrushText}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- OP/ED got its own tab because it is the one part of a details page people
                         come back for, and it used to sit below two tables of scraped text. All of
                         them are listed: the list is short and a "+N more" would only hide things.
                         A row is a Border with a coloured leading edge, since opening and ending
                         used to be identical chips and the only difference was a text colour. -->
                    <VerticalStackLayout IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=2}"
                                         Padding="12,4,12,32" Spacing="0">
                        <Label Text="OPENING" Style="{StaticResource SectionLabelStyle}"
                               IsVisible="{Binding OpEdVisible}" />
                        <Border Style="{StaticResource PanelStyle}" Padding="12"
                                IsVisible="{Binding OpEdVisible}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding OPs}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <controls:OpEdRow Text="{Binding .}"
                                                          IsOpening="True"
                                                          Command="{Binding Source={x:Reference DetailsPage}, Path=OpEdRowCommand}"
                                                          CommandParameter="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="ENDING" Style="{StaticResource SectionLabelStyle}"
                               IsVisible="{Binding OpEdVisible}" />
                        <Border Style="{StaticResource PanelStyle}" Padding="12"
                                IsVisible="{Binding OpEdVisible}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding EDs}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <controls:OpEdRow Text="{Binding .}"
                                                          IsOpening="False"
                                                          Command="{Binding Source={x:Reference DetailsPage}, Path=OpEdRowCommand}"
                                                          CommandParameter="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="No opening or ending themes listed for this entry."
                               IsVisible="{Binding OpEdEmptyVisible}" Style="{StaticResource StateTextStyle}"
                               Margin="0,18,0,0" />
                    </VerticalStackLayout>

                    <!-- Episodes. This one has to be a CollectionView, not BindableLayout: the
                         latter builds a real view per item and a long-runner like One Piece has
                         well over a thousand episodes, which pinned ~1GB of RSS and got the
                         process killed. CollectionView recycles cells instead. -->
                    <!-- The three state panels sit ON TOP of the list in the same cell rather than above it in
                         their own rows. They used to be three Auto rows with RowSpacing, and an
                         Auto row does not collapse to nothing when it is invisible: measured on a
                         device, a phantom ViewGroup of 208px stayed between the tab strip and the
                         first card, so these tabs opened with roughly twice the gap the others
                         have. Same content, no dead space. -->
                    <Grid IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=1}"
                          Padding="0,8,0,32">
                        <CollectionView IsVisible="{Binding Source={x:Reference DetailsPage}, Path=EpisodesContentVisible}"
                                        ItemsSource="{Binding Source={x:Reference DetailsPage}, Path=DisplayedEpisodes}"
                                        ItemTemplate="{StaticResource EpisodeTemplate}"
                                        RemainingItemsThreshold="6">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                            </CollectionView.ItemsLayout>
                        </CollectionView>
                        <Border IsVisible="{Binding LoadingEpisodes}" Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingEpisodes}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading episodes..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=EpisodesErrorVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=EpisodesErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=EpisodesEmptyVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="No episodes available." Style="{StaticResource StateTextStyle}" />
                        </Border>
                    </Grid>

                    <!-- Reviews and Recommendations are CollectionViews for the same reason the
                         episode list is: BindableLayout builds a real view per item the moment the
                         tab becomes visible, and doing that synchronously on the tap is what made
                         switching tabs feel like it hung. -->
                    <Grid IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=3}"
                          Padding="0,8,0,32">
                        <CollectionView IsVisible="{Binding Source={x:Reference DetailsPage}, Path=ReviewsContentVisible}"
                                        ItemsSource="{Binding Source={x:Reference DetailsPage}, Path=DisplayedReviews}"
                                        ItemTemplate="{StaticResource ReviewTemplate}"
                                        RemainingItemsThreshold="4">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                            </CollectionView.ItemsLayout>
                        </CollectionView>
                        <Border IsVisible="{Binding LoadingReviews}" Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingReviews}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading reviews..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=ReviewsErrorVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=ReviewsErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=ReviewsEmptyVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="No reviews available." Style="{StaticResource StateTextStyle}" />
                        </Border>
                    </Grid>

                    <Grid IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=4}"
                          Padding="0,8,0,32">
                        <CollectionView IsVisible="{Binding Source={x:Reference DetailsPage}, Path=RecommendationsContentVisible}"
                                        ItemsSource="{Binding Source={x:Reference DetailsPage}, Path=DisplayedRecommendations}"
                                        ItemTemplate="{StaticResource RecommendationTemplate}"
                                        RemainingItemsThreshold="4">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                            </CollectionView.ItemsLayout>
                        </CollectionView>
                        <Border IsVisible="{Binding LoadingRecommendations}" Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingRecommendations}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading recommendations..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=RecommendationsErrorVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=RecommendationsErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=RecommendationsEmptyVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="No recommendations available." Style="{StaticResource StateTextStyle}" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=5}"
                                         Padding="8,8,8,32" Spacing="6">
                        <Border IsVisible="{Binding LoadingRelated}" Margin="4,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingRelated}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading related titles..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=RelatedErrorVisible}"
                                Margin="4,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=RelatedErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=RelatedEmptyVisible}"
                                Margin="4,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="No related titles available." Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <controls:AnimePosterGrid x:Name="RelatedGrid"
                            IsVisible="{Binding Source={x:Reference DetailsPage}, Path=RelatedContentVisible}"
                            ItemsSource="{Binding Source={x:Reference DetailsPage}, Path=DisplayedRelated}"
                            FixedHeight="True">
                            <controls:AnimePosterGrid.CellTemplate>
                                <!-- Same component as the anime grid; only the cell content differs,
                                     with the blue relation chips (Adaptation, Prequel, ...). The tap
                                     is NOT a TapGestureRecognizer on the card: that swallowed the
                                     vertical drag, so the page stopped scrolling after the first
                                     few pixels and the rest of the grid was unreachable. Selection
                                     behaves like the character rows, which scroll fine. -->
                                <DataTemplate>
                                    <controls:AnimePosterCard
                                        HeightRequest="{Binding Source={x:Reference RelatedGrid}, Path=CellHeight}"
                                        PosterUrl="{Binding ImgUrl}"
                                        Title="{Binding Title}"
                                        TitleOverlay="True"
                                        TypeTag="{Binding MediaType}"
                                        BadgeExtra="{Binding AirDayTillBind}"
                                        ChipSource="{Binding Relations}"
                                        ChipTemplate="{StaticResource RelationChipTemplate}" />
                                </DataTemplate>
                            </controls:AnimePosterGrid.CellTemplate>
                        </controls:AnimePosterGrid>
                        <!-- Only reachable past the safety cap on Related, which normally shows
                             everything it has. -->
                        <Button Text="{Binding Source={x:Reference DetailsPage}, Path=RelatedMoreText}"
                                IsVisible="{Binding Source={x:Reference DetailsPage}, Path=RelatedMoreVisible}"
                                Clicked="OnRelatedMoreTapped"
                                Margin="0,10,0,0" HorizontalOptions="Center"
                                FontFamily="InterSemiBold" FontSize="14"
                                BackgroundColor="#141d2b" TextColor="White"
                                BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12"
                                HeightRequest="40" Padding="18,0" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=6}"
                                         Padding="0,8,0,32" Spacing="6">
                        <Border IsVisible="{Binding LoadingCharactersVisibility}" Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingCharactersVisibility}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading characters..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=CharactersErrorVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=CharactersErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=CharactersEmptyVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="No characters available." Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <CollectionView x:Name="CharactersList"
                                        IsVisible="{Binding AnimeMode}"
                                        ItemsSource="{Binding Source={x:Reference DetailsPage}, Path=DisplayedCharacters}"
                                        ItemTemplate="{StaticResource AnimeCharacterTemplate}"
                                        HeightRequest="{Binding Source={x:Reference DetailsPage}, Path=CharactersListHeight}"
                                        SelectionMode="Single"
                                        SelectionChanged="OnCharacterItemSelected" />
                        <CollectionView x:Name="MangaCharactersList"
                                        IsVisible="{Binding AnimeMode, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                        ItemsSource="{Binding Source={x:Reference DetailsPage}, Path=DisplayedMangaCharacters}"
                                        ItemTemplate="{StaticResource MangaCharacterTemplate}"
                                        HeightRequest="{Binding Source={x:Reference DetailsPage}, Path=MangaCharactersListHeight}"
                                        SelectionMode="Single"
                                        SelectionChanged="OnCharacterItemSelected" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=7}"
                                         Padding="0,8,0,32" Spacing="6">
                        <Border IsVisible="{Binding LoadingCharactersVisibility}" Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingCharactersVisibility}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading staff..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=StaffErrorVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=StaffErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=StaffEmptyVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="No staff available." Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <!-- Three across. The staff cap is 200, so one per row was 200 * 108px of scrolling for a
                         list that is mostly one-line credits ("Sound Director"). Span=3 turns that
                         into 67 rows. HeightRequest stays pinned to the row count because this list
                         lives inside the page ScrollView and would otherwise collapse; with the span
                         the number of realised rows is the same order as before, not 3x. -->
                        <CollectionView x:Name="StaffList"
                                        IsVisible="{Binding Source={x:Reference DetailsPage}, Path=StaffContentVisible}"
                                        ItemsSource="{Binding Source={x:Reference DetailsPage}, Path=DisplayedStaff}"
                                        ItemTemplate="{StaticResource StaffTemplate}"
                                        HeightRequest="{Binding Source={x:Reference DetailsPage}, Path=StaffListHeight}"
                                        SelectionMode="Single"
                                        SelectionChanged="OnStaffItemSelected">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Span="3" Orientation="Vertical"
                                                 HorizontalItemSpacing="0" VerticalItemSpacing="0" />
                            </CollectionView.ItemsLayout>
                        </CollectionView>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout x:Name="HeaderFlow" Spacing="0" ZIndex="20" VerticalOptions="Start" HorizontalOptions="Fill"
                             BackgroundColor="{StaticResource EmSheet}">
            <Grid x:Name="HeroContainer" HeightRequest="460" HorizontalOptions="Fill" BackgroundColor="Transparent" IsClippedToBounds="True">
                <Grid x:Name="HeroVisual" HeightRequest="460" IsClippedToBounds="True" VerticalOptions="Start" HorizontalOptions="Fill">
                    <controls:BlurHeroView ImageUrl="{Binding DetailImage}" />
                    <Frame x:Name="PosterContainer"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           WidthRequest="340" HeightRequest="380" Padding="0" HasShadow="False"
                           BackgroundColor="Transparent" BorderColor="Transparent">
                        <Image Source="{Binding DetailImage, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFit" />
                    </Frame>
                    <BoxView BackgroundColor="Transparent" InputTransparent="False">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnHeaderPanUpdated" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView InputTransparent="True">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00051522" Offset="0.0" />
                                <GradientStop Color="#00051522" Offset="0.5" />
                                <GradientStop Color="#B3051522" Offset="1.0" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    <BoxView x:Name="HeroScrim" Opacity="0" InputTransparent="True">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00051522" Offset="0.0" />
                                <GradientStop Color="#4D051522" Offset="0.5" />
                                <GradientStop Color="#B3051522" Offset="1.0" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Start" Margin="0,12,12,0" Spacing="8">
                        <!-- The trailer button used to live here AND in the action bar below, so
                             every entry showed two of them wired to the same handler. The action
                             bar copy stays; this overlay only keeps the loading spinner. -->
                        <ActivityIndicator IsRunning="{Binding LoadingGlobal}" IsVisible="{Binding LoadingGlobal}"
                                           Color="{StaticResource EmAccent}" WidthRequest="28" HeightRequest="28" />
                    </HorizontalStackLayout>
                    <Grid x:Name="TitleSection" VerticalOptions="End" RowDefinitions="Auto,Auto,Auto" Padding="20,24,20,16">
                        <Label Grid.Row="0" x:Name="TitleLabel" Text="{Binding Title}"
                               FontFamily="InterBold" FontSize="26" TextColor="White"
                               MaxLines="2" LineBreakMode="TailTruncation" Margin="0,0,0,4" />
                        <HorizontalStackLayout Grid.Row="1" Spacing="6" Margin="0,0,0,12">
                            <Frame Padding="8,2" CornerRadius="6" HasShadow="False" BackgroundColor="#0066FF" BorderColor="Transparent">
                                <Label Text="{Binding Type}" FontFamily="InterBold" FontSize="11" TextColor="White" />
                            </Frame>
                            <Frame Padding="8,2" CornerRadius="6" HasShadow="False" BackgroundColor="#00C853" BorderColor="Transparent"
                                   IsVisible="{Binding Status, Converter={StaticResource AiringStatus}}">
                                <Label Text="AIRING" FontFamily="InterBold" FontSize="11" TextColor="White" />
                            </Frame>
                            <Frame Padding="8,2" CornerRadius="6" HasShadow="False" BackgroundColor="#FF0000" BorderColor="Transparent">
                                <Frame.IsVisible>
                                    <MultiBinding Converter="{StaticResource MultiAnd}">
                                        <Binding Path="Status" Converter="{StaticResource AiringStatus}" />
                                        <Binding Path="TimeTillNextAir" Converter="{StaticResource BoolVis}" ConverterParameter="nonempty" />
                                    </MultiBinding>
                                </Frame.IsVisible>
                                <Label Text="{Binding TimeTillNextAir}" FontFamily="InterBold" FontSize="11" TextColor="White" />
                            </Frame>
                            <Label Text="•" FontFamily="Inter" FontSize="11" TextColor="#80FFFFFF" VerticalOptions="Center" Margin="6,0" />
                            <Label Text="{Binding StartYear}" FontFamily="Inter" FontSize="12" TextColor="#CCFFFFFF" VerticalOptions="Center" />
                            <Label Text="•" FontFamily="Inter" FontSize="11" TextColor="#80FFFFFF" VerticalOptions="Center" Margin="6,0" />
                            <Label Text="{Binding AllEpisodesBind, StringFormat='{0} Episodes'}" IsVisible="{Binding AnimeMode}"
                                   FontFamily="Inter" FontSize="12" TextColor="#CCFFFFFF" VerticalOptions="Center" />
                            <Label Text="{Binding AllEpisodesBind, StringFormat='{0} Chapters'}"
                                   IsVisible="{Binding AnimeMode, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                   FontFamily="Inter" FontSize="12" TextColor="#CCFFFFFF" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <!-- Two rows instead of a FlexLayout: a flex row aligns the groups by
                                 their own edges, so the value line drifted depending on whether a
                                 group had one line or two. Rows put every header on row 0 and every
                                 value on row 1, which is what makes the values and the stepper
                                 share a baseline. -->
                            <Grid x:Name="HeroMetaLayout" Grid.Column="0" ColumnSpacing="22"
                                  ColumnDefinitions="Auto,Auto,Auto"
                                  RowDefinitions="Auto,Auto" HorizontalOptions="Start"
                                  VerticalOptions="Center">
                                <HorizontalStackLayout x:Name="ScoreHeaderGroup" Grid.Row="0" Grid.Column="0" Spacing="3">
                                    <Label Text="★" FontFamily="InterBold" FontSize="9" TextColor="#FFD700" />
                                    <Label Text="SCORE" FontFamily="InterBold" FontSize="9" TextColor="#80FFFFFF" />
                                </HorizontalStackLayout>
                                <Label x:Name="ScoreMetaGroup" Grid.Row="1" Grid.Column="0"
                                       Text="{Binding GlobalScoreBind}" FontFamily="InterBold" FontSize="14" TextColor="White" />

                                <Label x:Name="StatusHeaderGroup" Grid.Row="0" Grid.Column="1"
                                       Text="STATUS" FontFamily="InterBold" FontSize="9" TextColor="#80FFFFFF" />
                                <Button x:Name="StatusMetaGroup" Grid.Row="1" Grid.Column="1"
                                        Text="{Binding MyStatusBind}" Clicked="OnStatusClicked"
                                        IsEnabled="{Binding AddAnimeVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                        FontFamily="InterBold" FontSize="14" BackgroundColor="Transparent" TextColor="White"
                                        BorderWidth="0" Padding="0" HeightRequest="20" HorizontalOptions="Start" />

                                <Grid x:Name="LastAiredMetaGroup" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding LastAiredHeader}" FontFamily="InterBold" FontSize="9" TextColor="#80FFFFFF">
                                        <Label.IsVisible>
                                            <MultiBinding Converter="{StaticResource MultiAnd}">
                                                <Binding Path="Status" Converter="{StaticResource AiringStatus}" />
                                                <Binding Path="LastAired" Converter="{StaticResource BoolVis}" ConverterParameter="nonempty" />
                                            </MultiBinding>
                                        </Label.IsVisible>
                                    </Label>
                                    <Label Text="{Binding LastAiredValue}" FontFamily="InterBold" FontSize="14" TextColor="White"
                                           MaxLines="1" LineBreakMode="TailTruncation">
                                        <Label.IsVisible>
                                            <MultiBinding Converter="{StaticResource MultiAnd}">
                                                <Binding Path="Status" Converter="{StaticResource AiringStatus}" />
                                                <Binding Path="LastAired" Converter="{StaticResource BoolVis}" ConverterParameter="nonempty" />
                                            </MultiBinding>
                                        </Label.IsVisible>
                                    </Label>
                                </VerticalStackLayout>
                                </Grid>
                            </Grid>

                            <!-- Bottom aligned, not centred: the value under each meta header is what
                                 the eye reads, and a centred stepper floated above the numbers next
                                 to it. AlignItems="End" on the meta row puts all four on one baseline. -->
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="#1A000000" Stroke="#29FFFFFF" StrokeThickness="1"
                                    Padding="0" VerticalOptions="End" HeightRequest="32"
                                    IsVisible="{Binding IsEpisodeStepperVisible}">
                                <Grid ColumnDefinitions="32,Auto,32" ColumnSpacing="0">
                                    <!-- The minus is meaningless at zero and while the entry is not on
                                         the list, so it is hidden rather than shown dead. -->
                                    <Button Grid.Column="0" Command="{Binding DecrementEpsCommand}"
                                            IsVisible="{Binding AddAnimeVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                            FontFamily="InterBold" FontSize="16" Text="−"
                                            BackgroundColor="Transparent" TextColor="#80FFFFFF" BorderWidth="0" CornerRadius="0"
                                            WidthRequest="32" HeightRequest="32" Padding="0" />
                                    <Label Grid.Column="1" Text="{Binding MyEpisodesStepperBind}" FontFamily="InterBold" FontSize="13"
                                           TextColor="White" VerticalOptions="Center" HorizontalOptions="Center" VerticalTextAlignment="Center" Padding="6,0"
                                           IsVisible="{Binding AddAnimeVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEpisodesCounterTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <!-- Off the list the pill becomes the "start watching" control,
                                         which is the route that used to be missing entirely. -->
                                    <Border Grid.Column="1" IsVisible="{Binding AddAnimeVisibility}"
                                            Padding="12,0" VerticalOptions="Center"
                                            BackgroundColor="Transparent">
                                        <Label Text="Start watching" FontFamily="InterBold" FontSize="12"
                                               TextColor="White" VerticalOptions="Center" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnStepperStartTapped" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                    <Button Grid.Column="2" Command="{Binding IncrementEpsCommand}"
                                            IsVisible="{Binding AddAnimeVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                            FontFamily="InterBold" FontSize="16" Text="+"
                                            BackgroundColor="#0066FF" TextColor="White" BorderWidth="0" CornerRadius="0"
                                            WidthRequest="32" HeightRequest="32" Padding="0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Border x:Name="ActionBar" HorizontalOptions="Fill" BackgroundColor="{StaticResource EmSheet}" StrokeShape="RoundRectangle 24,24,0,0" Stroke="Transparent" Padding="14,12,14,8">
                <Grid ColumnDefinitions="*,*,Auto,Auto,Auto" ColumnSpacing="6">
                    <Button Grid.Column="0" Text="Add to List" Command="{Binding AddAnimeCommand}" IsVisible="{Binding AddAnimeVisibility}"
                            IsEnabled="{Binding IsAddAnimeButtonEnabled}" FontFamily="InterSemiBold" FontSize="12" BackgroundColor="#141d2b"
                            TextColor="White" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" Padding="10,0" />
                    <Button Grid.Column="0" Text="★ Unranked" Clicked="OnScoreClicked" FontFamily="InterSemiBold" FontSize="12" BackgroundColor="#141d2b"
                            TextColor="White" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" Padding="10,0">
                        <Button.IsVisible>
                            <MultiBinding Converter="{StaticResource MultiAnd}">
                                <Binding Path="AddAnimeVisibility" Converter="{StaticResource BoolVis}" ConverterParameter="invert" />
                                <Binding Path="IsMyScoreSet" Converter="{StaticResource BoolVis}" ConverterParameter="invert" />
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>
                    <Button Grid.Column="0" Text="{Binding MyScoreBind, StringFormat='★ {0}'}" Clicked="OnScoreClicked" FontFamily="InterSemiBold" FontSize="12"
                            BackgroundColor="#141d2b" TextColor="White" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" Padding="10,0">
                        <Button.IsVisible>
                            <MultiBinding Converter="{StaticResource MultiAnd}">
                                <Binding Path="AddAnimeVisibility" Converter="{StaticResource BoolVis}" ConverterParameter="invert" />
                                <Binding Path="IsMyScoreSet" />
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>
                    <Button Grid.Column="1" x:Name="FavouriteButton" Text="♥ Favorite" Command="{Binding ToggleFavouriteCommand}"
                            IsEnabled="{Binding IsFavouriteButtonEnabled}" FontFamily="InterSemiBold" FontSize="12" BackgroundColor="#141d2b"
                            TextColor="White" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" Padding="10,0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFavourite}" Value="True">
                                <Setter Property="Text" Value="♥ Favourited" />
                                <Setter Property="TextColor" Value="{StaticResource EmAccent}" />
                                <Setter Property="BorderColor" Value="{StaticResource EmAccent}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="▶" Clicked="OnTrailerClicked" IsVisible="{Binding HasTrailer}" FontFamily="InterBold" FontSize="14"
                            BackgroundColor="#141d2b" TextColor="#FF6B00" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" WidthRequest="40" Padding="0" />
                    <Button Grid.Column="3" Text="↻" Command="{Binding RefreshCommand}" FontFamily="InterBold" FontSize="14" BackgroundColor="#141d2b"
                            TextColor="White" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" WidthRequest="40" Padding="0" />
                    <Button Grid.Column="4" Text="⋯" Command="{Binding ShowMoreCommand}" FontFamily="InterBold" FontSize="18" BackgroundColor="#141d2b"
                            TextColor="White" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" WidthRequest="40" Padding="0" />
                </Grid>
            </Border>

            <ScrollView x:Name="TabStripScroll" HorizontalOptions="Fill" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        Margin="0,0,0,0" Padding="14,4,14,0" BackgroundColor="{StaticResource EmSheet}">
                <HorizontalStackLayout Spacing="20">
                    <Label x:Name="TabGeneral" Text="Overview" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="0" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabEpisodes" Text="Episodes" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="1" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabOpEd" Text="OP/ED" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="2" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabReviews" Text="Reviews" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="3" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabRecs" Text="Recommendations" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="4" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabRelated" Text="Related" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="5" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabCharacters" Text="Characters" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="6" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabStaff" Text="Staff" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="7" /></Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <Grid IsVisible="{Binding LoadingGlobal}" BackgroundColor="#CC000510" ZIndex="100">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <ActivityIndicator IsRunning="True" Color="#0066FF" WidthRequest="40" HeightRequest="40" />
                <Label Text="Loading..." FontFamily="Inter" FontSize="12" TextColor="White" MaxLines="1" />
            </VerticalStackLayout>
        </Grid>

        <Grid x:Name="VideoOverlay" IsVisible="False" BackgroundColor="#000000" ZIndex="110">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Same two round buttons on every page that plays video: full screen on the left, close
                 on the right. They share one size and colour so the three overlays look the same. -->
            <Border x:Name="FullscreenButton" Grid.Row="0" HorizontalOptions="Start" VerticalOptions="Center"
                    Margin="10,10,0,0" WidthRequest="40" HeightRequest="40"
                    BackgroundColor="#B3051522" Stroke="#4DFFFFFF" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnToggleFullscreen" />
                </Border.GestureRecognizers>
                <Image x:Name="FullscreenIcon" Source="icon_fullscreen" WidthRequest="22" HeightRequest="22"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Border x:Name="VideoCloseButton" Grid.Row="0" HorizontalOptions="End" VerticalOptions="Center"
                    Margin="0,10,10,0" WidthRequest="40" HeightRequest="40"
                    BackgroundColor="#B3051522" Stroke="#4DFFFFFF" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="CloseVideoOverlay" />
                </Border.GestureRecognizers>
                <Label Text="✕" FontFamily="InterBold" FontSize="18" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
<!-- Direct media (AnimeThemes WebM) plays on ExoPlayer here. The WebView below handles YouTube,
                   which ExoPlayer cannot load at all because a watch page is HTML with an iframe.
                   The WebView is created by ShowVideoOverlay rather than declared here: an Android
                   WebView spawns a Chromium child process and costs 100-400ms plus tens of MB,
                   and MAUI builds handlers for the whole tree when the page attaches, so declaring
                   it stalled EVERY details open for a video nobody played. -->
                <controls:NativeVideoView x:Name="DirectVideoPlayer" Grid.Row="1" IsVisible="False"
                                           VerticalOptions="Fill" HorizontalOptions="Fill"
                                           PlayFailed="OnDirectVideoFailed" />

            </Grid>

            <!-- The overflow menu. Inside this Grid on purpose: a ContentPage holds one child, so
                 declaring this as a second child of the page made it the page's content and the whole
                 entry rendered as nothing at all. -->
            <controls:OptionsSheet x:Name="DetailsSheet" ZIndex="300" />
        </Grid>
  </ContentPage>

