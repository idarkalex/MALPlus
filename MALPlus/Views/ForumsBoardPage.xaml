<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:mforumsitems="clr-namespace:MALPlus.XShared.ViewModels.Forums.Items;assembly=MALPlus.Core"
             xmlns:mforums="clr-namespace:MALPlus.XShared.ViewModels.Forums;assembly=MALPlus.Core"
x:Class="MALPlus.Views.ForumsBoardPage"
               x:Name="BoardPageRoot"
               x:DataType="mforums:ForumBoardViewModel"
               BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding LoadingTopics}" BackgroundColor="#80000000" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>

<Grid RowDefinitions="Auto,Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,10,12,4">
                  <Label Grid.Column="0" Text="{Binding Title}" FontFamily="InterBold" FontSize="22"
                         TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                  <!-- A Border rather than a Button: Button has no StrokeShape, and a Border
                       carries a real background so it stays hit tested. -->
                  <Border Grid.Column="1" Padding="14,7" StrokeThickness="1"
                          StrokeShape="RoundRectangle 8"
                          BackgroundColor="{StaticResource EmSheet}"
                          Stroke="{StaticResource EmBorder}" VerticalOptions="Center">
                      <Border.GestureRecognizers>
                          <TapGestureRecognizer Tapped="OnNewTopicTapped" />
                      </Border.GestureRecognizers>
                      <Label Text="New topic" FontFamily="InterSemiBold" FontSize="13"
                             TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                  </Border>
              </Grid>

              <!-- Entry boards are MAL's own anime/manga discussion, where a topic can only be
                   started against the media id. The global boards have no entry, so the button is
                   hidden there rather than posting into an arbitrary board. -->
              <Border Grid.Row="1" Margin="16,0,16,8" Padding="14,11" StrokeThickness="1"
                      StrokeShape="RoundRectangle 8"
                      BackgroundColor="{StaticResource EmSheet}"
                      Stroke="{StaticResource EmBorder}"
                      IsVisible="{Binding Source={x:Reference BoardPageRoot}, Path=CanStartTopicHere}">
                  <Border.GestureRecognizers>
                      <TapGestureRecognizer Tapped="OnNewTopicTapped" />
                  </Border.GestureRecognizers>
                  <Label Text="Start a topic in this discussion" FontFamily="InterSemiBold" FontSize="14"
                         TextColor="{StaticResource EmAccent}" />
              </Border>

            <RefreshView Grid.Row="2" IsRefreshing="{Binding LoadingTopics}" Refreshing="OnRefreshing">
                <CollectionView ItemsSource="{Binding Topics}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="Could not load this board" FontFamily="InterSemiBold" FontSize="14"
                                   TextColor="{StaticResource EmAccent}" HorizontalOptions="Center" />
                            <Label Text="MyAnimeList is not returning the topic list to the app right now."
                                   FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF"
                                   HorizontalOptions="Center" />
                            <Label Text="Pull down to retry" FontFamily="Inter" FontSize="12"
                                   TextColor="#80FFFFFF" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate
                        x:DataType="mforumsitems:ForumTopicEntryViewModel">
                            <Border Margin="16,4" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTopicRowTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Text="{Binding Data.Title}" FontFamily="InterBold" FontSize="14"
                                           TextColor="{StaticResource BrushText}" MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Grid.Row="1" Spacing="8">
                                        <Label Text="{Binding Data.Op}" FontFamily="Inter" FontSize="11"
                                               TextColor="{StaticResource EmAccent}" />
                                        <Label Text="·" FontFamily="Inter" FontSize="11" TextColor="#80FFFFFF" />
                                        <Label Text="{Binding Data.Replies}" FontFamily="Inter" FontSize="11"
                                               TextColor="#80FFFFFF" />
                                        <Label Text="replies" FontFamily="Inter" FontSize="11" TextColor="#80FFFFFF" />
                                        <Label Text="·" FontFamily="Inter" FontSize="11" TextColor="#80FFFFFF" />
                                        <Label Text="{Binding Data.LastPostDate}" FontFamily="Inter" FontSize="11"
                                               TextColor="#80FFFFFF" MaxLines="1" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
