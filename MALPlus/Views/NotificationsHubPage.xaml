<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             xmlns:vm="clr-namespace:MALPlus.XShared.ViewModels.Main;assembly=MALPlus.Core"
             xmlns:mnotifications="clr-namespace:MALPlus.Models.Models.Notifications;assembly=MALPlus.Core"
             x:Class="MALPlus.Views.NotificationsHubPage"
             x:DataType="vm:NotificationsHubViewModel"
             BackgroundColor="{DynamicResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:IntEqualityConverter x:Key="IntEq" />
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding Loading}" BackgroundColor="#80000000" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>

        <Grid RowDefinitions="Auto,Auto,*">
            <Grid Grid.Row="0" Padding="16,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="Notifications" FontFamily="InterBold" FontSize="22"
                       TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                <controls:WindowsRefreshButton Grid.Column="1" Clicked="OnRefreshing" />
                <Button Grid.Column="2" Text="✓ All read" Command="{Binding MarkAllAsReadCommand}"
                        FontFamily="InterSemiBold" FontSize="11"
                        BackgroundColor="{DynamicResource TabChipInactiveBg}" TextColor="{StaticResource BrushText}"
                        BorderColor="{DynamicResource EmBorder}" BorderWidth="1" CornerRadius="8"
                        HeightRequest="32" Padding="10,0" />
            </Grid>

            <!-- Tab strip -->
            <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        Padding="16,0,16,10">
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="TabAll" Text="All" Clicked="OnTabButtonClicked" CommandParameter="0"
                            Style="{StaticResource TabChipActiveButtonStyle}" />
                    <Button x:Name="TabAiring" Text="Airing" Clicked="OnTabButtonClicked" CommandParameter="1"
                            Style="{StaticResource TabChipButtonStyle}" />
                    <Button x:Name="TabReplies" Text="Replies" Clicked="OnTabButtonClicked" CommandParameter="2"
                            Style="{StaticResource TabChipButtonStyle}" />
                    <Button x:Name="TabMessages" Text="Messages" Clicked="OnTabButtonClicked" CommandParameter="3"
                            Style="{StaticResource TabChipButtonStyle}" />
                    <Button x:Name="TabOthers" Text="Others" Clicked="OnTabButtonClicked" CommandParameter="4"
                            Style="{StaticResource TabChipButtonStyle}" />
                </HorizontalStackLayout>
            </ScrollView>

            <RefreshView Grid.Row="2" IsRefreshing="{Binding Loading, Mode=OneWay}" Refreshing="OnRefreshing">
                <CollectionView x:Name="NotificationList" ItemsSource="{Binding Notifications}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No notifications" FontFamily="Inter" FontSize="13"
                               TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="mnotifications:MalNotification">
                            <Border Margin="16,4" BackgroundColor="{DynamicResource EmSheet}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNotificationItemTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                     <Image Grid.Column="0"
                                            Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                            Aspect="AspectFill" WidthRequest="36" HeightRequest="36">
                                         <Image.Triggers>
                                             <DataTrigger TargetType="Image"
                                                          Binding="{Binding HasImage}"
                                                          Value="False">
                                                 <Setter Property="Source" Value="{Binding TypeIcon}" />
                                             </DataTrigger>
                                         </Image.Triggers>
                                     </Image>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Header}" FontFamily="InterBold" FontSize="13"
                                               TextColor="{StaticResource BrushText}" MaxLines="2"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Content}" FontFamily="Inter" FontSize="12"
                                               TextColor="#C0FFFFFF" MaxLines="3"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Date}" FontFamily="Inter" FontSize="11"
                                           TextColor="#80FFFFFF" VerticalOptions="Center"
                                           MaxLines="2" LineBreakMode="TailTruncation" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
