<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             x:Name="SettingsPageRoot"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.SettingsPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,36" Spacing="14">

            <Label Text="Settings" FontFamily="InterBold" FontSize="22"
                   TextColor="{StaticResource BrushText}" />

            <!-- General & Display -->
            <Border Style="{StaticResource PanelStyle}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="GENERAL &amp; DISPLAY" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />

                    <!-- Prefer English titles -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Prefer English titles" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Use English localized titles when available instead of Japanese Romaji"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding PreferEnglishTitles}"
                                OnColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Show format chip -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Show media format chip" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Display format chip on posters (TV, Movie, OVA, Manga, etc.)"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding ShowFormatTag}"
                                OnColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Score chip display mode -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Score chip on posters" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Display community rating, personal rating, or hide score chip"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Picker Grid.Column="1" Title="Score chip" WidthRequest="185"
                                ItemsSource="{Binding PosterScoreDisplayOptions}"
                                SelectedIndex="{Binding PosterScoreDisplayIndex, Mode=TwoWay}"
                                TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Show season chip -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Show release season chip" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Display release season chip beneath score on anime posters (e.g. 'Fall 24')"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding DisplaySeasonWithType}"
                                OnColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Default start page -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Default start page" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Screen opened automatically when launching the app"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Picker Grid.Column="1" Title="Start page" WidthRequest="130"
                                ItemsSource="{Binding StartPageOptions}"
                                SelectedItem="{Binding StartPageOption, Mode=TwoWay}"
                                TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Content rating filter -->
                    <VerticalStackLayout Spacing="4" Margin="0,4,0,0">
                        <Label Text="Content rating filter" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" />
                        <Label Text="Filter mature or adult content across search, discovery, and library"
                               FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        <Picker x:Name="ContentFilterPicker" Title="Content filter"
                                FontFamily="Inter" FontSize="14"
                                TextColor="{StaticResource BrushText}"
                                SelectedIndex="{Binding ContentFilterIndex, Mode=TwoWay}"
                                Margin="0,2,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Tracking & Library -->
            <Border Style="{StaticResource PanelStyle}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="TRACKING &amp; LIBRARY" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />

                    <!-- Prompt for score on completion -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Prompt for score on completion" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Automatically ask for a score (1–10) when moving an entry to Completed"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding DisplayScoreDialogAfterCompletion}"
                                OnColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Auto set start date -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Auto set start date" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Automatically set today as start date when moving to Watching or Reading"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding SetStartDateOnWatching}"
                                OnColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Auto set finish date -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Auto set finish date" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Automatically set today as finish date when moving an entry to Completed"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding SetEndDateOnCompleted}"
                                OnColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Manga progress by volumes -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Manga progress by volumes" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Track and display read volumes instead of chapters for manga"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding MangaFocusVolumes}"
                                OnColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Default descending sort -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Default to descending sort" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Order library lists by highest score or newest date first"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding AutoDescendingSorting}"
                                OnColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Broadcast Calendar -->
            <Border Style="{StaticResource PanelStyle}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="BROADCAST CALENDAR" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />

                    <!-- Include Watching -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Include Watching" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Show anime currently in your Watching list on their airing days"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarIncludeWatching}"
                                OnColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Include Planned -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Include Plan to Watch" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Show anime in your Plan to Watch list on their airing days"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarIncludePlanned}"
                                OnColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Start week on -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Start week on" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="First day column shown in the weekly calendar"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Picker Grid.Column="1" ItemsSource="{Binding CalendarWeekStartOptions}"
                                SelectedIndex="{Binding CalendarWeekStartIndex, Mode=TwoWay}"
                                TitleColor="#A0FFFFFF" TextColor="{StaticResource BrushText}"
                                WidthRequest="120" HorizontalOptions="End" VerticalOptions="Center" />
                    </Grid>

                    <!-- Open on today's day -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Jump to current day" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Automatically scroll to today's column when opening the calendar"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarStartOnToday}"
                                OnColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Hide empty days -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Hide empty days" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Omit calendar days with no scheduled broadcasts"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarRemoveEmptyDays}"
                                OnColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Max series per day -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Maximum series per day" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Limit the number of series displayed under each day column"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <Entry Grid.Column="1" Text="{Binding CalendarMaxItems}" Keyboard="Numeric"
                               WidthRequest="72" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}"
                               BackgroundColor="{StaticResource EmBackground}"
                               PlaceholderColor="#A0FFFFFF" VerticalOptions="Center" />
                    </Grid>

                    <!-- Broadcast time zone -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Broadcast time zone" FontFamily="Inter" FontSize="14"
                                   TextColor="{StaticResource BrushText}" />
                            <Label Text="Time zone used to align airing times into day columns"
                                   FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End"
                                             WidthRequest="180">
                            <Picker ItemsSource="{Binding CalendarTimeZoneOptions}"
                                    SelectedIndex="{Binding CalendarTimeZoneIndex, Mode=TwoWay}"
                                    Title="Time zone"
                                    TitleColor="#A0FFFFFF" TextColor="{StaticResource BrushText}" />
                            <Label Text="{Binding CalendarTimeZoneLabel}" FontFamily="Inter" FontSize="11"
                                   TextColor="#A0FFFFFF" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Cache & Storage -->
            <Border Style="{StaticResource PanelStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="CACHE &amp; STORAGE" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Label x:Name="CacheCountLabel" Text="No cached files yet"
                           FontFamily="Inter" FontSize="13" TextColor="#80FFFFFF" />
                    <Label Text="Removes locally cached API responses and metadata to force a fresh fetch."
                           FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                    <Button Text="Clear caches" Clicked="OnClearCachesClicked"
                            FontFamily="InterSemiBold" FontSize="13"
                            BackgroundColor="#FF6B00" TextColor="White"
                            CornerRadius="8" HeightRequest="38" Padding="16,0"
                            HorizontalOptions="Start" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Diagnostics & Logs -->
            <Border Style="{StaticResource PanelStyle}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="DIAGNOSTICS &amp; LOGS" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Label Text="100% local on-device logging. Zero telemetry, tracking, or personal data are ever sent over the network."
                           FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF" />
                    <Label x:Name="LogSizeLabel" Text="Local logs active"
                           FontFamily="InterMedium" FontSize="13" TextColor="{StaticResource BrushText}" />
                    <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                        <Button Text="Export logs" Clicked="OnExportLogsClicked"
                                FontFamily="InterSemiBold" FontSize="13"
                                BackgroundColor="#0066FF" TextColor="White"
                                CornerRadius="8" HeightRequest="38" Padding="16,0" />
                        <Button Text="Clear logs" Clicked="OnClearLogsClicked"
                                FontFamily="InterSemiBold" FontSize="13"
                                BackgroundColor="#14293D" TextColor="#F87171"
                                CornerRadius="8" HeightRequest="38" Padding="14,0" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource PanelStyle}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="UPDATES" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Label x:Name="VersionLabel" Text="MAL+ v0.7.0 (Build 201)"
                           FontFamily="InterMedium" FontSize="14" TextColor="{StaticResource BrushText}" />
                    <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                        <Button Text="Check for updates" Clicked="OnCheckUpdatesClicked"
                                FontFamily="InterSemiBold" FontSize="13"
                                BackgroundColor="#0066FF" TextColor="White"
                                CornerRadius="8" HeightRequest="38" Padding="16,0" />
                        <Button Text="View release notes" Clicked="OnViewChangelogClicked"
                                FontFamily="InterSemiBold" FontSize="13"
                                BackgroundColor="#14293D" TextColor="#8FB8E8"
                                CornerRadius="8" HeightRequest="38" Padding="14,0" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource PanelStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ABOUT" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Label Text="MAL+ for Android" FontFamily="InterBold" FontSize="15"
                           TextColor="{StaticResource BrushText}" />
                    <Label Text="A modern, high-performance MyAnimeList client built with .NET 11 and .NET MAUI. Port of MALClient by Drutol, maintained and modernized by idarkalex."
                           FontFamily="Inter" FontSize="12" TextColor="#B0C4DE" />
                    <Label Text="Powered by Tenrai API &amp; AnimeThemes. Released under the GNU General Public License v3."
                           FontFamily="Inter" FontSize="11" TextColor="#708090" />
                </VerticalStackLayout>
            </Border>

            <!-- Account -->
            <Border Style="{StaticResource PanelStyle}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ACCOUNT" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Label x:Name="AccountNameLabel" FontFamily="InterBold" FontSize="14"
                           TextColor="{StaticResource BrushText}" />
                    <Button x:Name="LogOutButton" Text="Sign out" Clicked="OnLogOutClicked"
                            IsVisible="{Binding LogOutButtonVisibility, Source={x:Reference SettingsPageRoot}}"
                            FontFamily="InterSemiBold" FontSize="13" TextColor="White"
                            BackgroundColor="#141d2b" BorderColor="#29FFFFFF" BorderWidth="1"
                            CornerRadius="10" HeightRequest="44" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
