<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             x:Name="SettingsPageRoot"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.SettingsPage"
             BackgroundColor="{DynamicResource EmBackground}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolVis" />

            <!-- Cabecera de seccion -->
            <Style x:Key="SectionHeader" TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="8" />
                <Setter Property="Margin" Value="4,18,4,8" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style x:Key="SectionAccent" TargetType="BoxView">
                <Setter Property="WidthRequest" Value="3" />
                <Setter Property="HeightRequest" Value="14" />
                <Setter Property="Color" Value="{StaticResource EmAccent}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="InterBold" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="1.2" />
                <Setter Property="TextTransform" Value="Uppercase" />
                <Setter Property="TextColor" Value="{DynamicResource TabChipInactiveText}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>

            <!-- Tarjeta de ajustes -->
            <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Grupo de categorias para el Hub -->
            <Style x:Key="SectionGroup" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource EmSheet}" />
                <Setter Property="Stroke" Value="{DynamicResource EmBorderBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="RowLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource BrushText}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="SettingTitle" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource BrushText}" />
            </Style>
            <Style x:Key="SettingDesc" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{DynamicResource TabChipInactiveText}" />
            </Style>
            <Style x:Key="SettingDivider" TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="#1AFFFFFF" />
                <Setter Property="Margin" Value="16,0" />
            </Style>

            <!-- Selector chips following MAL+ Option A squircle 8dp standard -->
            <Style x:Key="SettingSelectChip" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource TabChipInactiveBg}" />
                <Setter Property="Stroke" Value="{DynamicResource EmBorderBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="MaximumWidthRequest" Value="180" />
            </Style>
            <Style x:Key="SettingChipText" TargetType="Label">
                <Setter Property="FontFamily" Value="InterMedium" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource BrushText}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
            <Style x:Key="SettingChipChevron" TargetType="Label">
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{DynamicResource TabChipInactiveText}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Margin" Value="4,0,0,0" />
            </Style>

            <!-- Interruptores -->
            <Style TargetType="Switch">
                <Setter Property="OnColor" Value="{StaticResource EmAccent}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Botones -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource TabChipActiveButtonStyle}">
                <Setter Property="HeightRequest" Value="40" />
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource TabChipButtonStyle}">
                <Setter Property="HeightRequest" Value="40" />
            </Style>
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="TextColor" Value="#F87171" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- ================================================================= -->
        <!-- 1. HUB VIEW (Pantalla Principal de Settings)                      -->
        <!-- ================================================================= -->
        <ScrollView x:Name="HubScrollView" IsVisible="True">
            <VerticalStackLayout Padding="14,18,14,36" Spacing="0">

                <Label Text="Settings" FontFamily="InterBold" FontSize="24"
                       TextColor="{StaticResource BrushText}" />
                <Label Text="Preferences, display, and personalization"
                       FontFamily="Inter" FontSize="13"
                       TextColor="{DynamicResource TabChipInactiveText}" Margin="0,4,0,14" />

                <!-- Featured Quick Visual Customizer Card -->
                <Border BackgroundColor="{DynamicResource EmSheet}"
                        Stroke="#660066FF" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 14" Padding="14,12" Margin="0,0,0,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOpenVisualSetupClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" InputTransparent="True">
                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                BackgroundColor="#1F0066FF" Stroke="#4D0066FF" StrokeThickness="1"
                                StrokeShape="RoundRectangle 11" VerticalOptions="Center">
                            <Label Text="&#xf06e;" FontFamily="FontAwesome" FontSize="17"
                                   TextColor="#60A5FA"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="Visual Studio" FontFamily="InterBold" FontSize="15"
                                       TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                                <Border Padding="6,1" StrokeShape="RoundRectangle 5"
                                        BackgroundColor="#1F0066FF" StrokeThickness="0" VerticalOptions="Center">
                                    <Label Text="LIVE PREVIEW" FontFamily="InterBold" FontSize="8"
                                           CharacterSpacing="0.8" TextColor="#60A5FA" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="Customize theme, grid columns, spacing &amp; poster badges live"
                                   FontFamily="Inter" FontSize="11"
                                   TextColor="{DynamicResource TabChipInactiveText}"
                                   MaxLines="2" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="#0066FF" StrokeThickness="0"
                                StrokeShape="RoundRectangle 8" HeightRequest="30" Padding="11,0"
                                VerticalOptions="Center">
                            <Label Text="Open" FontFamily="InterSemiBold" FontSize="12"
                                   TextColor="White" VerticalOptions="Center" HorizontalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Grupo de Categorias Principales -->
                <Border Style="{StaticResource SectionGroup}">
                    <VerticalStackLayout Spacing="0">

                        <!-- Categoria 1: Apariencia & Visualizacion -->
                        <Grid HeightRequest="66" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryAppearanceTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    BackgroundColor="{DynamicResource TabChipInactiveBg}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                <Label Text="&#xf53f;" FontFamily="FontAwesome" FontSize="16"
                                       TextColor="{StaticResource EmAccent}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Appearance &amp; Display" Style="{StaticResource RowLabel}" />
                                <Label Text="{OnPlatform WinUI='Theme, start page, language', Default='Theme, grid columns, start page, language'}" Style="{StaticResource SettingDesc}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="icon_chevron_right" WidthRequest="16" HeightRequest="16"
                                   Opacity="0.4" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingDivider}" Margin="68,0,16,0" />

                        <!-- Categoria 2: Tarjetas & Pildoras en Poster -->
                        <Grid HeightRequest="66" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryPostersTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    BackgroundColor="{DynamicResource TabChipInactiveBg}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                <Label Text="&#xf02b;" FontFamily="FontAwesome" FontSize="16"
                                       TextColor="{StaticResource EmAccent}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Poster Cards &amp; Badges" Style="{StaticResource RowLabel}" />
                                <Label Text="Score chip, media format, season, badges" Style="{StaticResource SettingDesc}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="icon_chevron_right" WidthRequest="16" HeightRequest="16"
                                   Opacity="0.4" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingDivider}" Margin="68,0,16,0" />

                        <!-- Categoria 3: Biblioteca & Seguimiento -->
                        <Grid HeightRequest="66" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryLibraryTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    BackgroundColor="{DynamicResource TabChipInactiveBg}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                <Label Text="&#xf02d;" FontFamily="FontAwesome" FontSize="16"
                                       TextColor="{StaticResource EmAccent}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Library &amp; Tracking" Style="{StaticResource RowLabel}" />
                                <Label Text="List sort, per-list ordering, auto-dates" Style="{StaticResource SettingDesc}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="icon_chevron_right" WidthRequest="16" HeightRequest="16"
                                   Opacity="0.4" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingDivider}" Margin="68,0,16,0" />

                        <!-- Categoria 4: Calendario de Emision -->
                        <Grid HeightRequest="66" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryCalendarTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    BackgroundColor="{DynamicResource TabChipInactiveBg}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                <Label Text="&#xf073;" FontFamily="FontAwesome" FontSize="16"
                                       TextColor="{StaticResource EmAccent}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Broadcast Calendar" Style="{StaticResource RowLabel}" />
                                <Label Text="Time zone, week start, day filters and limits" Style="{StaticResource SettingDesc}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="icon_chevron_right" WidthRequest="16" HeightRequest="16"
                                   Opacity="0.4" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingDivider}" Margin="68,0,16,0" />

                        <!-- Categoria 5: Compartir & Redes -->
                        <Grid HeightRequest="66" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategorySharingTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    BackgroundColor="{DynamicResource TabChipInactiveBg}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                <Label Text="&#xf1e0;" FontFamily="FontAwesome" FontSize="16"
                                       TextColor="{StaticResource EmAccent}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Sharing &amp; Social" Style="{StaticResource RowLabel}" />
                                <Label Text="Floating share button, post templates" Style="{StaticResource SettingDesc}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="icon_chevron_right" WidthRequest="16" HeightRequest="16"
                                   Opacity="0.4" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingDivider}" Margin="68,0,16,0" />

                        <!-- Categoria 6: Datos & Diagnosticos -->
                        <Grid HeightRequest="66" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryDataTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    BackgroundColor="{DynamicResource TabChipInactiveBg}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                <Label Text="&#xf013;" FontFamily="FontAwesome" FontSize="16"
                                       TextColor="{StaticResource EmAccent}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Data &amp; Storage" Style="{StaticResource RowLabel}" />
                                <Label Text="Clear caches, local logs, updates" Style="{StaticResource SettingDesc}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="icon_chevron_right" WidthRequest="16" HeightRequest="16"
                                   Opacity="0.4" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ============ ACCOUNT (EN LA PAGINA PRINCIPAL) ============ -->
                <HorizontalStackLayout Style="{StaticResource SectionHeader}" Margin="4,24,4,8">
                    <BoxView Style="{StaticResource SectionAccent}" />
                    <Label Text="ACCOUNT" Style="{StaticResource SectionLabel}" />
                </HorizontalStackLayout>

                <Border Style="{StaticResource SettingsCard}">
                    <VerticalStackLayout Spacing="12" Padding="16,14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Border WidthRequest="38" HeightRequest="38"
                                    BackgroundColor="{DynamicResource TabChipInactiveBg}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 19" VerticalOptions="Center">
                                <Label Text="&#xf007;" FontFamily="FontAwesome" FontSize="16"
                                       TextColor="{StaticResource EmAccent}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="AccountNameLabel" FontFamily="InterBold" FontSize="15"
                                       TextColor="{StaticResource BrushText}" />
                                <Label Text="Connected to MyAnimeList"
                                       FontFamily="Inter" FontSize="12" TextColor="{DynamicResource TabChipInactiveText}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView Style="{StaticResource SettingDivider}" Margin="0,2,0,2" />

                        <!-- Boton Sign out centrado, largo y con altura tactil -->
                        <Button x:Name="LogOutButton" Text="Sign out" Clicked="OnLogOutClicked"
                                IsVisible="{Binding LogOutButtonVisibility, Source={x:Reference SettingsPageRoot}}"
                                Style="{StaticResource DangerButton}"
                                HorizontalOptions="Fill" HeightRequest="44"
                                FontFamily="InterSemiBold" FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ ABOUT & FEEDBACK (EN LA PAGINA PRINCIPAL) ============ -->
                <HorizontalStackLayout Style="{StaticResource SectionHeader}" Margin="4,24,4,8">
                    <BoxView Style="{StaticResource SectionAccent}" />
                    <Label Text="ABOUT &amp; FEEDBACK" Style="{StaticResource SectionLabel}" />
                </HorizontalStackLayout>

                <Border Style="{StaticResource SettingsCard}">
                    <VerticalStackLayout Spacing="10" Padding="16,14">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="MAL+ for Android" FontFamily="InterBold" FontSize="16"
                                       TextColor="{StaticResource BrushText}" />
                                <Label Text="Developed by idarkalex"
                                       FontFamily="InterMedium" FontSize="13" TextColor="{StaticResource EmAccent}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" x:Name="VersionLabel" Text="v0.8.0"
                                   FontFamily="InterMedium" FontSize="12" TextColor="{DynamicResource TabChipInactiveText}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Label Text="A modern, high-performance MyAnimeList client built with .NET 11 &amp; .NET MAUI."
                               FontFamily="Inter" FontSize="12" TextColor="{StaticResource BrushTextSecondary}" />

                        <BoxView Style="{StaticResource SettingDivider}" Margin="0,4,0,2" />

                        <!-- GitHub Star Button -->
                        <Border BackgroundColor="{DynamicResource TabChipInactiveBg}" Stroke="{DynamicResource EmBorderBrush}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                HeightRequest="42" Padding="14,0" HorizontalOptions="Fill" Margin="0,2,0,2">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGitHubStarClicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="&#xf005;" FontFamily="FontAwesome" FontSize="17"
                                       TextColor="#FBBF24" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Star MAL+ on GitHub" FontFamily="InterSemiBold" FontSize="13"
                                       TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="&#xf08e;" FontFamily="FontAwesome" FontSize="12"
                                       TextColor="{DynamicResource TabChipInactiveText}" VerticalOptions="Center" Opacity="0.7" />
                            </Grid>
                        </Border>

                        <!-- GitHub Issues Button -->
                        <Border BackgroundColor="{DynamicResource TabChipInactiveBg}" Stroke="{DynamicResource EmBorderBrush}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                HeightRequest="42" Padding="14,0" HorizontalOptions="Fill" Margin="0,2,0,2">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGitHubIssuesClicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="&#xf09b;" FontFamily="FontAwesome" FontSize="18"
                                       TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Report a bug / Suggest a feature (GitHub)" FontFamily="InterSemiBold" FontSize="13"
                                       TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="&#xf08e;" FontFamily="FontAwesome" FontSize="12"
                                       TextColor="{DynamicResource TabChipInactiveText}" VerticalOptions="Center" Opacity="0.7" />
                            </Grid>
                        </Border>

                        <BoxView Style="{StaticResource SettingDivider}" Margin="0,4,0,2" />

                        <Label Text="Based on MALClient originally created by Drutol. Powered by Tenrai API &amp; AnimeThemes. Released under the GNU General Public License v3."
                               Style="{StaticResource SettingDesc}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ================================================================= -->
        <!-- 2. DETAIL VIEW (Subcategoria Seleccionada)                        -->
        <!-- ================================================================= -->
        <ScrollView x:Name="DetailScrollView" IsVisible="False">
            <VerticalStackLayout Padding="14,14,14,36" Spacing="0">

                <!-- Boton Volver a Settings -->
                <HorizontalStackLayout Spacing="8" Margin="0,4,0,14" VerticalOptions="Center">
                    <Border BackgroundColor="{DynamicResource TabChipInactiveBg}"
                            Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" HeightRequest="36" Padding="12,0"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackToHubClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="&#xf060;" FontFamily="FontAwesome" FontSize="12"
                                   TextColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                            <Label Text="Settings" FontFamily="InterSemiBold" FontSize="13"
                                   TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>

                <Label x:Name="DetailTitleLabel" Text="Category Title" FontFamily="InterBold" FontSize="22"
                       TextColor="{StaticResource BrushText}" />
                <Label x:Name="DetailDescLabel" Text="Category description" FontFamily="Inter" FontSize="13"
                       TextColor="{DynamicResource TabChipInactiveText}" Margin="0,3,0,10" />

                <!-- ==================== SUBCATEGORIA 1: APARIENCIA ==================== -->
                <VerticalStackLayout x:Name="CategoryAppearanceContent" IsVisible="False" Spacing="0">
                    <!-- Quick Visual Studio entry at top of Appearance -->
                    <Border BackgroundColor="{DynamicResource EmSheet}"
                            Stroke="#660066FF" StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 14" Padding="14,12" Margin="0,6,0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenVisualSetupClicked" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" InputTransparent="True">
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    BackgroundColor="#1F0066FF" Stroke="#4D0066FF" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                <Label Text="&#xf06e;" FontFamily="FontAwesome" FontSize="15"
                                       TextColor="#60A5FA" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Interactive Visual Studio" FontFamily="InterBold" FontSize="14"
                                       TextColor="{StaticResource BrushText}" />
                                <Label Text="Preview theme, grid &amp; poster badges side-by-side" Style="{StaticResource SettingDesc}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="#0066FF" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" HeightRequest="28" Padding="10,0"
                                    VerticalOptions="Center">
                                <Label Text="Preview" FontFamily="InterSemiBold" FontSize="11"
                                       TextColor="White" VerticalOptions="Center" HorizontalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Style="{StaticResource SectionHeader}">
                        <BoxView Style="{StaticResource SectionAccent}" />
                        <Label Text="THEME &amp; LAYOUT" Style="{StaticResource SectionLabel}" />
                    </HorizontalStackLayout>

                    <Border Style="{StaticResource SettingsCard}">
                        <VerticalStackLayout Spacing="0">
                            <!-- Theme -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPickThemeClicked" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" InputTransparent="True">
                                    <Label Text="Theme" Style="{StaticResource SettingTitle}" />
                                    <Label Text="Visual style and OLED black level" Style="{StaticResource SettingDesc}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource SettingSelectChip}" InputTransparent="True">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label x:Name="ThemeValueLabel" Style="{StaticResource SettingChipText}" />
                                        <Label Text="▾" Style="{StaticResource SettingChipChevron}" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                            <BoxView Style="{StaticResource SettingDivider}" />

                            <!-- Grid columns (mobile/Android only; Windows scales columns automatically by window width) -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12"
                                  IsVisible="{OnPlatform WinUI=False, Default=True}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPickGridColumnsClicked" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" InputTransparent="True">
                                    <Label Text="Grid columns" Style="{StaticResource SettingTitle}" />
                                    <Label Text="Number of poster columns displayed in anime and manga grids" Style="{StaticResource SettingDesc}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource SettingSelectChip}" InputTransparent="True">
