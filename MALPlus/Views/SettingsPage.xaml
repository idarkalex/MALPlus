<?xml version="1.0" encoding="utf-8" ?>
  <ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             x:Name="SettingsPageRoot"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.SettingsPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="14">

            <Label Text="Settings" FontFamily="InterBold" FontSize="22"
                   TextColor="{StaticResource BrushText}" />

            <!-- General -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="GENERAL" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Prefer English titles" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding PreferEnglishTitles}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>

                    <!-- Content is a three-way choice and not a switch, because a switch cannot
                         express the middle option that is the point of this setting. Measured over one
                         band of the top anime ranking: the source's own filter removes every entry rated
                         "R+ - Mild Nudity" (twelve, among them Tokyo Godfathers, Evangelion Movie 2 and
                         Berserk III) while letting through fifty nine rated "R - 17+". So it is keyed on
                         the content rating and cuts the mild tier, not the explicit one. Three states
                         drawn from that rating are answerable; on/off is not, because switching it off
                         only ever means "including hentai".

                         One picker rather than two switches for the same reason: two toggles for one
                         three-valued decision can be set in a combination that means nothing. -->
                    <Label Text="CONTENT" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" Margin="0,10,0,0" />
                    <Picker x:Name="ContentFilterPicker" Title="Content"
                            FontFamily="Inter" FontSize="14"
                            TextColor="{StaticResource BrushText}"
                            SelectedIndex="{Binding ContentFilterIndex, Mode=TwoWay}" />
                    <Label Text="Safe hides mild nudity. Mature keeps it and drops the explicit tier.
Allow adult content removes the filter from the catalogue, your library and search."
                          FontFamily="Inter" FontSize="11" TextColor="#A0FFFFFF" />
                </VerticalStackLayout>
            </Border>

            <!-- Homepage -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="HOMEPAGE" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Lock display mode" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding LockDisplayMode}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Show season with type" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding DisplaySeasonWithType}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Start page" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <!-- The picker had no ItemsSource and no SelectedItem, so the setting was
                             unreachable from the UI even though App.xaml.cs honoured it: the
                             stored value could only ever be the "anime" default. -->
                        <Picker Grid.Column="1" Title="Start page" WidthRequest="130"
                                ItemsSource="{Binding StartPageOptions}"
                                SelectedItem="{Binding StartPageOption, Mode=TwoWay}"
                                TextColor="{StaticResource BrushText}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

             <!-- Feeds: removed. Nothing read the stored preference, in this build or the old one,
                  so the switch changed nothing about which profiles' activity was shown. -->


            <!-- Calendar -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="CALENDAR" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Include watching" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarIncludeWatching}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Include planned" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarIncludePlanned}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <!-- Says what the switch does. The getter is a negation of Sunday-first, so the
                         row used to read "Monday" while putting Sunday first: a label carried over
                         from the old build, where it said "Make Sunday first day of the week". -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Start week on Sunday" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarSwitchMonSun}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Open on today's day" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarStartOnToday}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Hide days with nothing airing" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarRemoveEmptyDays}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Max series in My List" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding CalendarMaxItems}" Keyboard="Numeric"
                               WidthRequest="72" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}"
                               BackgroundColor="{StaticResource EmBackground}"
                               PlaceholderColor="#A0FFFFFF" />
                    </Grid>
                     <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                         <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                             <Label Text="Broadcast time zone" FontFamily="Inter" FontSize="14"
                                    TextColor="{StaticResource BrushText}" />
                             <Label Text="Which day an airing is filed under" FontFamily="Inter" FontSize="11"
                                    TextColor="#A0FFFFFF" />
                         </VerticalStackLayout>
                         <!-- Title is not decoration here: a Picker with nothing selected renders as an
                              empty box, which is why this row looked like it had no value at all.
                              The label under it reads what the stored choice actually is, since the Picker
                              itself only shows the option text once one has been tapped.
                              ItemDisplayBinding is left out on purpose. The options override ToString, so
                              the binding was only a second path to the same text, and it is the one that
                              renders nothing when it does not resolve. -->
                         <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End"
                                              WidthRequest="180">
                             <Picker ItemsSource="{Binding CalendarTimeZoneOptions}"
                                     SelectedIndex="{Binding CalendarTimeZoneIndex, Mode=TwoWay}"
                                     Title="Time zone"
                                     TitleColor="#A0FFFFFF" TextColor="{StaticResource BrushText}" />
                             <Label Text="{Binding CalendarTimeZoneLabel}" FontFamily="Inter" FontSize="11"
                                    TextColor="#A0FFFFFF" HorizontalOptions="End" />
                         </VerticalStackLayout>
                     </Grid>
                 </VerticalStackLayout>
             </Border>

             <!-- Notifications: removed. Every manager behind this row was an empty stub, so the
                  switch could not start or stop anything, and there is no notifications page for it
                  to lead to. Left in place it was a row that did nothing at all. -->

             <!-- Articles: removed. Nothing in the app read the stored preference, so the switch
                  never changed where a link went. -->


            <!-- Forums -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="FORUMS" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Pull peek posts on startup" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding PullPeekPostsOnStartup}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Cache -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                 <VerticalStackLayout Spacing="8">
                     <Label Text="CACHE" FontFamily="InterBold" FontSize="11"
                            TextColor="#A0FFFFFF" />
                     <Label x:Name="CacheCountLabel" Text="No cached files yet"
                            FontFamily="Inter" FontSize="13" TextColor="#80FFFFFF" />
                    <Button Text="Clear caches" Clicked="OnClearCachesClicked"
                            FontFamily="InterSemiBold" FontSize="13"
                            BackgroundColor="#FF6B00" TextColor="White"
                            CornerRadius="8" HeightRequest="36" Padding="14,0"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- About -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ABOUT" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
<Label Text="MAL+ MAUI" FontFamily="InterBold" FontSize="14"
                             TextColor="{StaticResource BrushText}" />
                      <Label Text="A .NET MAUI port of MALClient by Drutol, forked by idarkalex"
                             FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF" />
                      <Label Text="Released under the GNU GPL v3"
                              FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF" />
                </VerticalStackLayout>
            </Border>

            <!-- Account: signing out is the only way to get back to the login form, and the
                 website session cookies that the community sections need are dropped with it. -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ACCOUNT" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Label x:Name="AccountNameLabel" FontFamily="InterBold" FontSize="14"
                           TextColor="{StaticResource BrushText}" />
                    <Button x:Name="LogOutButton" Text="Sign out" Clicked="OnLogOutClicked"
                            IsVisible="{Binding LogOutButtonVisibility, Source={x:Reference SettingsPageRoot}}"
                            FontFamily="InterSemiBold" FontSize="13" TextColor="White"
                            BackgroundColor="#141d2b" BorderColor="#29FFFFFF" BorderWidth="1"
                            CornerRadius="10" HeightRequest="44" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
