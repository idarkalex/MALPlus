<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             x:Name="SettingsPageRoot"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.SettingsPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolVis" />

            <!-- Cabecera de seccion: el mismo marcador y etiqueta que More y Discover. Estos tres
                 estilos estan repetidos en More; si los subes a App.xaml, borra las copias. -->
            <Style x:Key="SectionHeader" TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="8" />
                <Setter Property="Margin" Value="4,18,4,8" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style x:Key="SectionAccent" TargetType="BoxView">
                <Setter Property="WidthRequest" Value="3" />
                <Setter Property="HeightRequest" Value="14" />
                <Setter Property="Color" Value="{StaticResource EmAccent}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="InterBold" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="1.2" />
                <Setter Property="TextTransform" Value="Uppercase" />
                <Setter Property="TextColor" Value="{StaticResource TabChipInactiveText}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>

            <!-- La tarjeta es PanelStyle; aqui solo se quita el padding, que lo llevan las filas. -->
            <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="SettingTitle" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource BrushText}" />
            </Style>
            <Style x:Key="SettingDesc" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource TabChipInactiveText}" />
            </Style>
            <Style x:Key="SettingDivider" TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="#1AFFFFFF" />
                <Setter Property="Margin" Value="16,0" />
            </Style>

            <!-- Selector chips following MAL+ Option A squircle 8dp standard -->
            <Style x:Key="SettingSelectChip" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource TabChipInactiveBg}" />
                <Setter Property="Stroke" Value="{DynamicResource EmBorderBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="MaximumWidthRequest" Value="180" />
            </Style>
            <Style x:Key="SettingChipText" TargetType="Label">
                <Setter Property="FontFamily" Value="InterMedium" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource BrushText}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
            <Style x:Key="SettingChipChevron" TargetType="Label">
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource TabChipInactiveText}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Margin" Value="4,0,0,0" />
            </Style>

            <!-- Todos los interruptores comparten color y alineacion. -->
            <Style TargetType="Switch">
                <Setter Property="OnColor" Value="{StaticResource EmAccent}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Botones: primario, secundario y peligro salen de los chips de pestaña de App.xaml
                 (TabChipActiveButtonStyle / TabChipButtonStyle), asi que son los mismos que en
                 Recommendations. Solo se sube la altura a 40 para el dedo. -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource TabChipActiveButtonStyle}">
                <Setter Property="HeightRequest" Value="40" />
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource TabChipButtonStyle}">
                <Setter Property="HeightRequest" Value="40" />
            </Style>
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="TextColor" Value="#F87171" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="14,18,14,36" Spacing="0">

            <Label Text="Settings" FontFamily="InterBold" FontSize="22"
                   TextColor="{StaticResource BrushText}" />

            <!-- ============ GENERAL ============ -->
            <HorizontalStackLayout Style="{StaticResource SectionHeader}">
                <BoxView Style="{StaticResource SectionAccent}" />
                <Label Text="GENERAL" Style="{StaticResource SectionLabel}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="0">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickThemeClicked" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" InputTransparent="True">
                            <Label Text="Theme" Style="{StaticResource SettingTitle}" />
                            <Label Text="Visual style and OLED black level"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource SettingSelectChip}" InputTransparent="True">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label x:Name="ThemeValueLabel" Style="{StaticResource SettingChipText}" />
                                <Label Text="▾" Style="{StaticResource SettingChipChevron}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickStartPageClicked" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" InputTransparent="True">
                            <Label Text="Default start page" Style="{StaticResource SettingTitle}" />
                            <Label Text="Screen opened automatically when launching the app"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource SettingSelectChip}" InputTransparent="True">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label x:Name="StartPageValueLabel" Style="{StaticResource SettingChipText}" />
                                <Label Text="▾" Style="{StaticResource SettingChipChevron}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickContentFilterClicked" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" InputTransparent="True">
                            <Label Text="Content rating filter" Style="{StaticResource SettingTitle}" />
                            <Label Text="Filter mature or adult content across search, discovery, and library"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource SettingSelectChip}" InputTransparent="True">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label x:Name="ContentFilterValueLabel" Style="{StaticResource SettingChipText}" />
                                <Label Text="▾" Style="{StaticResource SettingChipChevron}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Prefer English titles" Style="{StaticResource SettingTitle}" />
                            <Label Text="Use English localized titles when available instead of Japanese Romaji"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding PreferEnglishTitles}"
                                SemanticProperties.Description="Prefer English titles" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ============ POSTER CARDS & BADGES ============ -->
            <HorizontalStackLayout Style="{StaticResource SectionHeader}">
                <BoxView Style="{StaticResource SectionAccent}" />
                <Label Text="POSTER CARDS &amp; BADGES" Style="{StaticResource SectionLabel}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="0">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickScoreChipClicked" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" InputTransparent="True">
                            <Label Text="Score chip on posters" Style="{StaticResource SettingTitle}" />
                            <Label Text="Display community rating, personal rating, or hide score chip"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource SettingSelectChip}" InputTransparent="True">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label x:Name="ScoreChipValueLabel" Style="{StaticResource SettingChipText}" />
                                <Label Text="▾" Style="{StaticResource SettingChipChevron}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Show media format chip" Style="{StaticResource SettingTitle}" />
                            <Label Text="Display format chip on posters (TV, Movie, OVA, Manga, etc.)"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding ShowFormatTag}"
                                SemanticProperties.Description="Show media format chip" />
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Show release season chip" Style="{StaticResource SettingTitle}" />
                            <Label Text="Display release season chip beneath score on anime posters (e.g. 'Fall 24')"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding DisplaySeasonWithType}"
                                SemanticProperties.Description="Show release season chip" />
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Show aired episodes badge" Style="{StaticResource SettingTitle}" />
                            <Label Text="Display number of aired episodes for airing anime (e.g. 'EP 8/12')"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding ShowAiredEpisodes}"
                                SemanticProperties.Description="Show aired episodes badge" />
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Show airing countdown badge" Style="{StaticResource SettingTitle}" />
                            <Label Text="Display broadcast countdown or 'Airing' tag on posters (e.g. '1D', 'Airing')"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding ShowAiringCountdown}"
                                SemanticProperties.Description="Show airing countdown badge" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ============ LIBRARY & LISTS ============ -->
            <HorizontalStackLayout Style="{StaticResource SectionHeader}">
                <BoxView Style="{StaticResource SectionAccent}" />
                <Label Text="LIBRARY &amp; LISTS" Style="{StaticResource SectionLabel}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="0">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickLibrarySortClicked" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" InputTransparent="True">
                            <Label Text="Default library sort" Style="{StaticResource SettingTitle}" />
                            <Label Text="Default ordering applied to anime and manga lists"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource SettingSelectChip}" InputTransparent="True">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label x:Name="LibrarySortValueLabel" Text="Title (A → Z)"
                                       Style="{StaticResource SettingChipText}" />
                                <Label Text="▾" Style="{StaticResource SettingChipChevron}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Remember sort per list" Style="{StaticResource SettingTitle}" />
                            <Label Text="Keep independent sorting orders for Watching, Completed, Planned, etc."
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding IndividualSortPerList}"
                                SemanticProperties.Description="Remember sort per list" />
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" IsVisible="{Binding IndividualSortPerList}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12" IsVisible="{Binding IndividualSortPerList}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnResetPerListSortsClicked" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" InputTransparent="True">
                            <Label Text="Reset per-list sorts" Style="{StaticResource SettingTitle}" />
                            <Label Text="Revert individual list sorting back to default library sort"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="Reset" TextColor="#FF5555" FontFamily="InterSemiBold"
                               FontSize="13" VerticalOptions="Center" InputTransparent="True" />
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Manga progress by volumes" Style="{StaticResource SettingTitle}" />
                            <Label Text="Track and display read volumes instead of chapters for manga"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding MangaFocusVolumes}"
                                SemanticProperties.Description="Manga progress by volumes" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ============ TRACKING & AUTO-DATES ============ -->
            <HorizontalStackLayout Style="{StaticResource SectionHeader}">
                <BoxView Style="{StaticResource SectionAccent}" />
                <Label Text="TRACKING &amp; AUTO-DATES" Style="{StaticResource SectionLabel}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="0">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Prompt for score on completion" Style="{StaticResource SettingTitle}" />
                            <Label Text="Automatically ask for a score (1–10) when moving an entry to Completed"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding DisplayScoreDialogAfterCompletion}"
                                SemanticProperties.Description="Prompt for score on completion" />
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Auto set start date" Style="{StaticResource SettingTitle}" />
                            <Label Text="Automatically set today as start date when moving to Watching or Reading"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding SetStartDateOnWatching}"
                                SemanticProperties.Description="Auto set start date" />
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Auto set finish date" Style="{StaticResource SettingTitle}" />
                            <Label Text="Automatically set today as finish date when moving an entry to Completed"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding SetEndDateOnCompleted}"
                                SemanticProperties.Description="Auto set finish date" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ============ SHARING & SOCIAL ============ -->
            <HorizontalStackLayout Style="{StaticResource SectionHeader}">
                <BoxView Style="{StaticResource SectionAccent}" />
                <Label Text="SHARING &amp; SOCIAL" Style="{StaticResource SectionLabel}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="0">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Enable floating share button" Style="{StaticResource SettingTitle}" />
                            <Label Text="Shows a quick share button after updating progress or rating"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding EnableShareButton}"
                                SemanticProperties.Description="Enable floating share button" />
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickShareDurationClicked" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" InputTransparent="True">
                            <Label Text="Share button duration" Style="{StaticResource SettingTitle}" />
                            <Label Text="How long the floating share button stays on screen before auto-dismissing"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource SettingSelectChip}" InputTransparent="True">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label x:Name="ShareDurationValueLabel" Style="{StaticResource SettingChipText}" />
                                <Label Text="▾" Style="{StaticResource SettingChipChevron}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <VerticalStackLayout Spacing="6" Padding="16,12">
                        <Label Text="Episode progress template" Style="{StaticResource SettingTitle}" />
                        <Label Text="Available tags: {title}, {ep}, {total}, {score}, {url}" Style="{StaticResource SettingDesc}" />
                        <Border Style="{StaticResource SettingSelectChip}" Padding="10,4" HorizontalOptions="Fill">
                            <Entry Text="{Binding ShareTemplateWatched}"
                                   FontFamily="Inter" FontSize="13"
                                   TextColor="{StaticResource BrushText}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <VerticalStackLayout Spacing="6" Padding="16,12">
                        <Label Text="Chapter progress template (Manga)" Style="{StaticResource SettingTitle}" />
                        <Label Text="Available tags: {title}, {ep}, {total}, {score}, {url}" Style="{StaticResource SettingDesc}" />
                        <Border Style="{StaticResource SettingSelectChip}" Padding="10,4" HorizontalOptions="Fill">
                            <Entry Text="{Binding ShareTemplateRead}"
                                   FontFamily="Inter" FontSize="13"
                                   TextColor="{StaticResource BrushText}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <VerticalStackLayout Spacing="6" Padding="16,12">
                        <Label Text="Completion template" Style="{StaticResource SettingTitle}" />
                        <Label Text="Available tags: {title}, {score}, {status}, {url}" Style="{StaticResource SettingDesc}" />
                        <Border Style="{StaticResource SettingSelectChip}" Padding="10,4" HorizontalOptions="Fill">
                            <Entry Text="{Binding ShareTemplateCompleted}"
                                   FontFamily="Inter" FontSize="13"
                                   TextColor="{StaticResource BrushText}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <VerticalStackLayout Spacing="6" Padding="16,12">
                        <Label Text="Recommendation template (Details)" Style="{StaticResource SettingTitle}" />
                        <Label Text="Available tags: {title}, {score}, {type}, {total}, {url}" Style="{StaticResource SettingDesc}" />
                        <Border Style="{StaticResource SettingSelectChip}" Padding="10,4" HorizontalOptions="Fill">
                            <Entry Text="{Binding ShareTemplateRecommend}"
                                   FontFamily="Inter" FontSize="13"
                                   TextColor="{StaticResource BrushText}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <VerticalStackLayout Spacing="6" Padding="16,12">
                        <Label Text="App hashtag / suffix" Style="{StaticResource SettingTitle}" />
                        <Label Text="Appended to shared updates (#MALPlus by default, or leave empty)" Style="{StaticResource SettingDesc}" />
                        <Border Style="{StaticResource SettingSelectChip}" Padding="10,4" HorizontalOptions="Fill">
                            <Entry Text="{Binding ShareCustomSuffix}"
                                   Placeholder="#MALPlus"
                                   PlaceholderColor="{StaticResource TabChipInactiveText}"
                                   FontFamily="Inter" FontSize="13"
                                   TextColor="{StaticResource BrushText}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid Padding="16,12">
                        <Button Text="Reset templates to default"
                                Clicked="OnResetShareTemplatesClicked"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalOptions="Start" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ============ BROADCAST CALENDAR ============ -->
            <HorizontalStackLayout Style="{StaticResource SectionHeader}">
                <BoxView Style="{StaticResource SectionAccent}" />
                <Label Text="BROADCAST CALENDAR" Style="{StaticResource SectionLabel}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="0">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickCalendarWeekStartClicked" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" InputTransparent="True">
                            <Label Text="Start week on" Style="{StaticResource SettingTitle}" />
                            <Label Text="First day column shown in the weekly calendar"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource SettingSelectChip}" InputTransparent="True">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label x:Name="WeekStartValueLabel" Style="{StaticResource SettingChipText}" />
                                <Label Text="▾" Style="{StaticResource SettingChipChevron}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Jump to current day" Style="{StaticResource SettingTitle}" />
                            <Label Text="Automatically scroll to today's column when opening the calendar"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarStartOnToday}"
                                SemanticProperties.Description="Jump to current day" />
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickCalendarTimeZoneClicked" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" InputTransparent="True">
                            <Label Text="Broadcast time zone" Style="{StaticResource SettingTitle}" />
                            <Label Text="Time zone used to align airing times into day columns"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource SettingSelectChip}" HorizontalOptions="End" VerticalOptions="Center" InputTransparent="True">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label x:Name="TimeZoneValueLabel" Style="{StaticResource SettingChipText}" />
                                <Label Text="▾" Style="{StaticResource SettingChipChevron}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Include Watching" Style="{StaticResource SettingTitle}" />
                            <Label Text="Show anime currently in your Watching list on their airing days"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarIncludeWatching}"
                                SemanticProperties.Description="Include Watching" />
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Include Plan to Watch" Style="{StaticResource SettingTitle}" />
                            <Label Text="Show anime in your Plan to Watch list on their airing days"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarIncludePlanned}"
                                SemanticProperties.Description="Include Plan to Watch" />
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Hide empty days" Style="{StaticResource SettingTitle}" />
                            <Label Text="Omit calendar days with no scheduled broadcasts"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarRemoveEmptyDays}"
                                SemanticProperties.Description="Hide empty days" />
                    </Grid>
                    <BoxView Style="{StaticResource SettingDivider}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Maximum series per day" Style="{StaticResource SettingTitle}" />
                            <Label Text="Limit the number of series displayed under each day column"
                                   Style="{StaticResource SettingDesc}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource SettingSelectChip}" WidthRequest="56" Padding="4,0" HorizontalOptions="End">
                            <Entry x:Name="CalendarMaxItemsEntry"
                                   Text="{Binding CalendarMaxItems}" Keyboard="Numeric"
                                   FontFamily="InterSemiBold" FontSize="14"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   TextColor="{StaticResource BrushText}"
                                   BackgroundColor="Transparent"
                                   HeightRequest="30"
                                   Completed="OnCalendarMaxItemsCompleted"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ============ CACHE & STORAGE ============ -->
            <HorizontalStackLayout Style="{StaticResource SectionHeader}">
                <BoxView Style="{StaticResource SectionAccent}" />
                <Label Text="CACHE &amp; STORAGE" Style="{StaticResource SectionLabel}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="8" Padding="16,14">
                    <Label x:Name="CacheCountLabel" Text="No cached files yet"
                           FontFamily="InterMedium" FontSize="13" TextColor="{StaticResource BrushText}" />
                    <Label Text="Removes locally cached API responses and metadata to force a fresh fetch."
                           Style="{StaticResource SettingDesc}" />
                    <Button Text="Clear caches" Clicked="OnClearCachesClicked"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalOptions="Start" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ DIAGNOSTICS & LOGS ============ -->
            <HorizontalStackLayout Style="{StaticResource SectionHeader}">
                <BoxView Style="{StaticResource SectionAccent}" />
                <Label Text="DIAGNOSTICS &amp; LOGS" Style="{StaticResource SectionLabel}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="8" Padding="16,14">
                    <Label Text="100% local on-device logging. Zero telemetry, tracking, or personal data are ever sent over the network."
                           FontFamily="Inter" FontSize="12" TextColor="{StaticResource TabChipInactiveText}" />
                    <Label x:Name="LogSizeLabel" Text="Local logs active"
                           FontFamily="InterMedium" FontSize="13" TextColor="{StaticResource BrushText}" />
                    <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                        <Button Text="Export logs" Clicked="OnExportLogsClicked"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Text="Clear logs" Clicked="OnClearLogsClicked"
                                Style="{StaticResource DangerButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ============ UPDATES ============ -->
            <HorizontalStackLayout Style="{StaticResource SectionHeader}">
                <BoxView Style="{StaticResource SectionAccent}" />
                <Label Text="UPDATES" Style="{StaticResource SectionLabel}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="8" Padding="16,14">
                    <Label x:Name="VersionLabel" Text="MAL+ v0.7.0 (Build 201)"
                           FontFamily="InterMedium" FontSize="14" TextColor="{StaticResource BrushText}" />
                    <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                        <Button Text="Check for updates" Clicked="OnCheckUpdatesClicked"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Text="View release notes" Clicked="OnViewChangelogClicked"
                                Style="{StaticResource SecondaryButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ============ ABOUT ============ -->
            <HorizontalStackLayout Style="{StaticResource SectionHeader}">
                <BoxView Style="{StaticResource SectionAccent}" />
                <Label Text="ABOUT" Style="{StaticResource SectionLabel}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="10" Padding="16,14">
                    <Label Text="MAL+ for Android" FontFamily="InterBold" FontSize="16"
                           TextColor="{StaticResource BrushText}" />
                    <Label Text="Developed by idarkalex"
                           FontFamily="InterMedium" FontSize="13" TextColor="{StaticResource EmAccent}" />
                    <Label Text="A modern, high-performance MyAnimeList client built with .NET 11 &amp; .NET MAUI."
                           FontFamily="Inter" FontSize="12" TextColor="{StaticResource BrushTextSecondary}" />

                    <BoxView Style="{StaticResource SettingDivider}" Margin="0,4,0,2" />

                    <Label Text="FEEDBACK &amp; ISSUES" FontFamily="InterBold" FontSize="11"
                           CharacterSpacing="1.2" TextColor="{StaticResource TabChipInactiveText}" />
                    <Label Text="Encountered a bug or have a suggestion? Share your feedback or open an issue on GitHub."
                           Style="{StaticResource SettingDesc}" />

                    <Border BackgroundColor="{StaticResource TabChipInactiveBg}" Stroke="{StaticResource EmBorder}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 8"
                            HeightRequest="40" Padding="14,0" HorizontalOptions="Start" Margin="0,2,0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGitHubIssuesClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="&#xf09b;" FontFamily="FontAwesome" FontSize="18"
                                   TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                            <Label Text="GitHub Issues" FontFamily="InterSemiBold" FontSize="13"
                                   TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                            <Label Text="&#xf08e;" FontFamily="FontAwesome" FontSize="11"
                                   TextColor="{StaticResource TabChipInactiveText}" VerticalOptions="Center" Opacity="0.7" />
                        </HorizontalStackLayout>
                    </Border>

                    <BoxView Style="{StaticResource SettingDivider}" Margin="0,4,0,2" />

                    <Label Text="CREDITS &amp; LICENSES" FontFamily="InterBold" FontSize="11"
                           CharacterSpacing="1.2" TextColor="{StaticResource TabChipInactiveText}" />
                    <Label Text="Based on MALClient originally created by Drutol. Powered by Tenrai API &amp; AnimeThemes. Released under the GNU General Public License v3."
                           Style="{StaticResource SettingDesc}" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ ACCOUNT ============ -->
            <HorizontalStackLayout Style="{StaticResource SectionHeader}">
                <BoxView Style="{StaticResource SectionAccent}" />
                <Label Text="ACCOUNT" Style="{StaticResource SectionLabel}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="8" Padding="16,14">
                    <Label x:Name="AccountNameLabel" FontFamily="InterBold" FontSize="14"
                           TextColor="{StaticResource BrushText}" />
                    <Button x:Name="LogOutButton" Text="Sign out" Clicked="OnLogOutClicked"
                            IsVisible="{Binding LogOutButtonVisibility, Source={x:Reference SettingsPageRoot}}"
                            Style="{StaticResource DangerButton}"
                            HorizontalOptions="Start" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
