<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MALPlus.Views"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.CalendarPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:IntEqualityConverter x:Key="IntEq" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- Modern Header: Back button, Title & Subtitle, and Mode Switch Chip -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="14,10,14,4">
            <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                    StrokeShape="RoundRectangle 18" BackgroundColor="#14FFFFFF"
                    VerticalOptions="Center" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Label Text="&#xf053;" FontFamily="FontAwesome" FontSize="14"
                       TextColor="{StaticResource BrushText}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0,8,0">
                <Label x:Name="CalendarTitleLabel" Text="Broadcast Calendar"
                       FontFamily="InterBold" FontSize="18"
                       TextColor="{StaticResource BrushText}" />
                <Label x:Name="CalendarSubtitleLabel" Text="Weekly TV &amp; ONA broadcast schedule"
                       FontFamily="Inter" FontSize="11"
                       TextColor="{StaticResource TabChipInactiveText}" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <!-- Mode Switch Chip (Allows easily jumping between Global and My List) -->
            <Button Grid.Column="2" x:Name="ModeSwitchButton"
                    Text="My List" Clicked="OnToggleModeClicked"
                    Style="{StaticResource TabChipButtonStyle}"
                    HeightRequest="32" Padding="12,0" FontSize="12"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Option A Day Chips (Mon, Tue, Wed, Thu, Fri, Sat, Sun, All) -->
        <ScrollView Grid.Row="1" x:Name="DayChipsScroll" Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never" Padding="12,4,12,6">
            <HorizontalStackLayout x:Name="DayChipsLayout" Spacing="8" VerticalOptions="Center" />
        </ScrollView>

        <!-- Loading overlay -->
        <Grid Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding CalendarBuildingVisibility}"
              BackgroundColor="#80000000" VerticalOptions="Fill" HorizontalOptions="Fill">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                                   WidthRequest="36" HeightRequest="36" />
                <Label Text="Building calendar..." FontFamily="Inter" FontSize="13"
                       TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Calendar Content (pivot) -->
        <Grid Grid.Row="3" IsVisible="{Binding CalendarVisibility}">
            <!-- Swipe turns the day, and the strip above follows the pager through the
                 PositionChanged subscription. Vertical drags stay with the poster grid. -->
            <Label Text="{Binding BuildError}" IsVisible="{Binding BuildError, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}"
                   FontFamily="Inter" FontSize="12" TextColor="#FF6B6B"
                   Padding="16,4" LineBreakMode="CharacterWrap" />

            <CarouselView x:Name="CalendarCarousel"
                          ItemsSource="{Binding CalendarData}"
                          Position="0"
                          IsSwipeEnabled="False"
                          Loop="False">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <!-- No day header here: the fixed strip above already names the day
                             and shows its count. Edge-to-edge poster grid matches the rest of the app. -->
                        <Grid Loaded="OnDayPageLoaded">
                            <controls:AnimePosterGrid x:Name="DayGrid"
                                ItemsSource="{Binding Items}"
                                ItemTapped="OnGridItemTapped" />

                            <Label Text="Nothing airing today" FontFamily="Inter" FontSize="14"
                                   TextColor="#80FFFFFF" HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding Source={x:Reference DayGrid}, Path=IsEmpty}" />
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
        </Grid>
    </Grid>
</ContentPage>
