<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:vm="clr-namespace:MALPlus.XShared.ViewModels.Main;assembly=MALPlus.Core"
             xmlns:tmodels="clr-namespace:MALPlus.Models.Models;assembly=MALPlus.Core"
             xmlns:tviewmodels="clr-namespace:MALPlus.XShared.ViewModels;assembly=MALPlus.Core"
             x:Class="MALPlus.Views.ProfilePage"
             x:DataType="vm:ProfilePageViewModel"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:IntEqualityConverter x:Key="IntEq" />

        <Style x:Key="ProfileTabButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="InterSemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>

        <Style x:Key="ProfileSectionHeader" TargetType="Label">
            <Setter Property="FontFamily" Value="InterBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="1.2" />
            <Setter Property="TextColor" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource EmSheet}" />
            <Setter Property="Stroke" Value="{StaticResource EmBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="InterSemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BackgroundColor" Value="#141D2B" />
            <Setter Property="TextColor" Value="{StaticResource BrushText}" />
            <Setter Property="BorderColor" Value="#1FFFFFFF" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="38" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <!-- Loading overlay -->
        <Grid IsVisible="{Binding LoadingVisibility}" BackgroundColor="#80000000"
              VerticalOptions="Fill" HorizontalOptions="Fill" ZIndex="99">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                                   WidthRequest="36" HeightRequest="36" />
                <Label Text="Loading profile..." FontFamily="Inter" FontSize="13"
                       TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Error view -->
        <VerticalStackLayout IsVisible="{Binding LoadErrorVisibility}" ZIndex="98"
                             HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="32">
            <Label Text="Could not load this profile" FontFamily="InterBold" FontSize="17"
                   TextColor="{StaticResource EmAccent}" HorizontalOptions="Center" />
            <Label Text="The user may not exist, or their profile is private." FontFamily="Inter"
                   FontSize="13" TextColor="#B3FFFFFF" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Button Text="Go back" Clicked="OnBackClicked" Margin="0,12,0,0"
                    BackgroundColor="#141D2B" TextColor="{StaticResource BrushText}"
                    BorderColor="#1FFFFFFF" BorderWidth="1" CornerRadius="8" Padding="20,10" />
        </VerticalStackLayout>

        <!-- Main RefreshView with ONE single outer ScrollView -->
        <RefreshView IsRefreshing="{Binding LoadingVisibility}" Refreshing="OnRefreshing"
                     IsVisible="{Binding LoadingVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <ScrollView>
                <VerticalStackLayout Spacing="14" Padding="16,8,16,36">

                    <!-- Header Card: Avatar + User Info + External MAL Link Arrow -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                        <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                            <!-- Avatar -->
                            <Border Grid.Column="0" WidthRequest="72" HeightRequest="72"
                                    StrokeShape="RoundRectangle 36"
                                    Stroke="{StaticResource EmAccent}" StrokeThickness="2"
                                    BackgroundColor="{StaticResource EmBackground}">
                                <Image Source="{Binding CurrentData.User.ImgUrl, Converter={StaticResource ImageConverter}}"
                                       Aspect="AspectFill" />
                            </Border>

                            <!-- User Info -->
                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding CurrentData.User.Name}" FontFamily="InterBold" FontSize="20"
                                       TextColor="{StaticResource BrushText}" MaxLines="1" LineBreakMode="TailTruncation" />
                                
                                <HorizontalStackLayout Spacing="8">
                                    <Border BackgroundColor="#141D2B" Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6" Padding="8,3"
                                            IsVisible="{Binding CurrentData.AnimeCompleted, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}">
                                        <Label Text="{Binding CurrentData.AnimeCompleted, StringFormat='{0} anime'}"
                                               FontFamily="InterSemiBold" FontSize="11" TextColor="{StaticResource EmAccent}" />
                                    </Border>
                                    <Border BackgroundColor="#141D2B" Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6" Padding="8,3"
                                            IsVisible="{Binding CurrentData.MangaCompleted, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}">
                                        <Label Text="{Binding CurrentData.MangaCompleted, StringFormat='{0} manga'}"
                                               FontFamily="InterSemiBold" FontSize="11" TextColor="#22C55E" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- External MAL Link (Arrow ↗ inside capsule) -->
                            <Border Grid.Column="2" WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="#141D2B" Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18"
                                    VerticalOptions="Start" HorizontalOptions="End" Margin="0,2,0,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOpenMalClicked" />
                                </Border.GestureRecognizers>
                                <Image Source="icon_go" WidthRequest="14" HeightRequest="14"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       Rotation="-45" Opacity="0.85" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Friend Request Card (when applicable) -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            IsVisible="{Binding CurrentData.CanAddFriend, Converter={StaticResource BoolVis}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Send a friend request" FontFamily="InterSemiBold" FontSize="14"
                                       TextColor="{StaticResource BrushText}" />
                                <Label Text="Connect to share comments and updates." FontFamily="Inter" FontSize="11"
                                       TextColor="#8899A6" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Add friend" Clicked="OnAddFriendClicked"
                                    FontFamily="InterSemiBold" FontSize="13"
                                    BackgroundColor="{StaticResource EmAccent}" TextColor="White"
                                    BorderWidth="0" CornerRadius="10" Padding="14,8" />
                        </Grid>
                    </Border>

                    <!-- Horizontal Tab Bar (Pill design) -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                                VerticalScrollBarVisibility="Never" Padding="0,2">
                        <HorizontalStackLayout Spacing="8">
                            <Button x:Name="TabBtnGeneral" Text="General" Style="{StaticResource ProfileTabButtonStyle}"
                                    Clicked="OnTabButtonClicked" CommandParameter="0" />
                            <Button x:Name="TabBtnHistory" Text="History" Style="{StaticResource ProfileTabButtonStyle}"
                                    Clicked="OnTabButtonClicked" CommandParameter="1" />
                            <Button x:Name="TabBtnFavourites" Text="Favourites" Style="{StaticResource ProfileTabButtonStyle}"
                                    Clicked="OnTabButtonClicked" CommandParameter="2" />
                            <Button x:Name="TabBtnStats" Text="Stats" Style="{StaticResource ProfileTabButtonStyle}"
                                    Clicked="OnTabButtonClicked" CommandParameter="3" />
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Tab Contents Container (NO NESTED SCROLLVIEWS!) -->
                    <Grid>
                        <!-- ==================== TAB 0: GENERAL ==================== -->
                        <VerticalStackLayout IsVisible="{Binding SelectedTab, Converter={StaticResource IntEq}, ConverterParameter=0}"
                                             Spacing="14">

                            <!-- PROFILE DETAILS (Natural height with BindableLayout, NO overlapping!) -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    IsVisible="{Binding CurrentData.Details.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="PROFILE DETAILS" Style="{StaticResource ProfileSectionHeader}" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentData.Details}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="0,4">
                                                    <Label Grid.Column="0" Text="{Binding Item1}" FontFamily="InterSemiBold" FontSize="13"
                                                           TextColor="#8899A6" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding Item2}" FontFamily="Inter" FontSize="13"
                                                           TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                           HorizontalOptions="End" HorizontalTextAlignment="End" LineBreakMode="WordWrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- FRIENDS -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    IsVisible="{Binding MyFriends.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="FRIENDS" Style="{StaticResource ProfileSectionHeader}" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MyFriends}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="tmodels:MalUser">
                                                <Border BackgroundColor="{StaticResource EmBackground}"
                                                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 8" Padding="10,6">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnFriendItemTapped" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                                        <Border StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36">
                                                            <Image Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                                                   Aspect="AspectFill" />
                                                        </Border>
                                                        <Label Grid.Column="1" Text="{Binding Name}" FontFamily="InterSemiBold" FontSize="13"
                                                               TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                               MaxLines="1" LineBreakMode="TailTruncation" />
                                                        <Image Grid.Column="2" Source="icon_go" WidthRequest="12" HeightRequest="12"
                                                               Opacity="0.4" VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- COMMENTS -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    IsVisible="{Binding MalComments.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="COMMENTS" Style="{StaticResource ProfileSectionHeader}" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MalComments}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="tmodels:MalComment">
                                                <Border BackgroundColor="{StaticResource EmBackground}"
                                                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 8" Padding="12">
                                                    <VerticalStackLayout Spacing="6">
                                                        <HorizontalStackLayout Spacing="8">
                                                            <Border StrokeShape="RoundRectangle 14" WidthRequest="28" HeightRequest="28">
                                                                <Image Source="{Binding User.ImgUrl, Converter={StaticResource ImageConverter}}"
                                                                       Aspect="AspectFill" />
                                                            </Border>
                                                            <Label Text="{Binding User.Name}" FontFamily="InterBold" FontSize="13"
                                                                   TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                                                            <Label Text="{Binding Date}" FontFamily="Inter" FontSize="11"
                                                                   TextColor="#8899A6" VerticalOptions="Center" />
                                                        </HorizontalStackLayout>
                                                        <Label Text="{Binding Content}" FontFamily="Inter" FontSize="13"
                                                               TextColor="{StaticResource BrushText}" LineBreakMode="WordWrap" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ==================== TAB 1: HISTORY ==================== -->
                        <VerticalStackLayout IsVisible="{Binding SelectedTab, Converter={StaticResource IntEq}, ConverterParameter=1}"
                                             Spacing="14">

                            <!-- View Full History Action Banner -->
                            <Border Style="{StaticResource CardBorderStyle}" Padding="14,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHistoryClicked" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                            BackgroundColor="#141D2B" Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 18">
                                        <Image Source="icon_history" WidthRequest="18" HeightRequest="18"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Full Episode History" FontFamily="InterBold" FontSize="13"
                                               TextColor="{StaticResource BrushText}" />
                                        <Label Text="View complete log of watched episodes &amp; read chapters"
                                               FontFamily="Inter" FontSize="11" TextColor="#8899A6" />
                                    </VerticalStackLayout>
                                    <Image Grid.Column="2" Source="icon_go" WidthRequest="14" HeightRequest="14"
                                           Opacity="0.5" VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <!-- Recent Anime Updates -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    IsVisible="{Binding RecentAnime.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="RECENT ANIME UPDATES" Style="{StaticResource ProfileSectionHeader}" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentAnime}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="tviewmodels:AnimeItemViewModel">
                                                <Border BackgroundColor="{StaticResource EmBackground}"
                                                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 8" Padding="10,6">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnRecentAnimeItemTapped" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                                        <Image Grid.Column="0" Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                                               WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                                        <Label Grid.Column="1" Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="13"
                                                               TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                                        <Image Grid.Column="2" Source="icon_go" WidthRequest="12" HeightRequest="12"
                                                               Opacity="0.4" VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Recent Manga Updates -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    IsVisible="{Binding RecentManga.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="RECENT MANGA UPDATES" Style="{StaticResource ProfileSectionHeader}" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentManga}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="tviewmodels:AnimeItemViewModel">
                                                <Border BackgroundColor="{StaticResource EmBackground}"
                                                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 8" Padding="10,6">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnRecentMangaItemTapped" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                                        <Image Grid.Column="0" Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                                               WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                                        <Label Grid.Column="1" Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="13"
                                                               TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                                        <Image Grid.Column="2" Source="icon_go" WidthRequest="12" HeightRequest="12"
                                                               Opacity="0.4" VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Empty Notice -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    IsVisible="{Binding HasNoHistory}">
                                <Label Text="No recent history or updates" FontFamily="Inter" FontSize="13"
                                       TextColor="#8899A6" HorizontalOptions="Center" Padding="0,16" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- ==================== TAB 2: FAVOURITES ==================== -->
                        <VerticalStackLayout IsVisible="{Binding SelectedTab, Converter={StaticResource IntEq}, ConverterParameter=2}"
                                             Spacing="14">

                            <!-- Favourite Anime -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    IsVisible="{Binding FavAnime.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="FAVOURITE ANIME" Style="{StaticResource ProfileSectionHeader}" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FavAnime}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="tviewmodels:AnimeItemViewModel">
                                                <Border BackgroundColor="{StaticResource EmBackground}"
                                                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 8" Padding="10,6">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnFavAnimeItemTapped" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                                        <Image Grid.Column="0" Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                                               WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                                        <Label Grid.Column="1" Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="13"
                                                               TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                                        <Image Grid.Column="2" Source="icon_go" WidthRequest="12" HeightRequest="12"
                                                               Opacity="0.4" VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Favourite Manga -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    IsVisible="{Binding FavManga.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="FAVOURITE MANGA" Style="{StaticResource ProfileSectionHeader}" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FavManga}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="tviewmodels:AnimeItemViewModel">
                                                <Border BackgroundColor="{StaticResource EmBackground}"
                                                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 8" Padding="10,6">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnFavMangaItemTapped" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                                        <Image Grid.Column="0" Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                                               WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                                        <Label Grid.Column="1" Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="13"
                                                               TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                                        <Image Grid.Column="2" Source="icon_go" WidthRequest="12" HeightRequest="12"
                                                               Opacity="0.4" VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Favourite Characters -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    IsVisible="{Binding FavouriteCharacters.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="FAVOURITE CHARACTERS" Style="{StaticResource ProfileSectionHeader}" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FavouriteCharacters}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="tviewmodels:FavouriteViewModel">
                                                <Border BackgroundColor="{StaticResource EmBackground}"
                                                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 8" Padding="10,6">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnFavCharacterItemTapped" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                                        <Image Grid.Column="0" Source="{Binding Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                                                               WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                                        <Label Grid.Column="1" Text="{Binding Data.Name}" FontFamily="InterSemiBold" FontSize="13"
                                                               TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                                        <Image Grid.Column="2" Source="icon_go" WidthRequest="12" HeightRequest="12"
                                                               Opacity="0.4" VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Favourite Staff -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    IsVisible="{Binding FavouriteStaff.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="FAVOURITE STAFF" Style="{StaticResource ProfileSectionHeader}" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FavouriteStaff}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="tviewmodels:FavouriteViewModel">
                                                <Border BackgroundColor="{StaticResource EmBackground}"
                                                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 8" Padding="10,6">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnFavStaffItemTapped" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                                        <Image Grid.Column="0" Source="{Binding Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                                                               WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                                        <Label Grid.Column="1" Text="{Binding Data.Name}" FontFamily="InterSemiBold" FontSize="13"
                                                               TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                                        <Image Grid.Column="2" Source="icon_go" WidthRequest="12" HeightRequest="12"
                                                               Opacity="0.4" VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Empty Notice -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    IsVisible="{Binding HasNoFavourites}">
                                <Label Text="No favourites added yet" FontFamily="Inter" FontSize="13"
                                       TextColor="#8899A6" HorizontalOptions="Center" Padding="0,16" />
                            </Border>
                        </VerticalStackLayout>
                        
                        <!-- ==================== TAB 3: STATS ==================== -->
                        <VerticalStackLayout IsVisible="{Binding SelectedTab, Converter={StaticResource IntEq}, ConverterParameter=3}"
                                             Spacing="14">

                            <!-- STATUS BREAKDOWN (Modern Dashboard Design) -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <VerticalStackLayout Spacing="14">
                                    <!-- ANIME STATUS Header with Total Badge -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="ANIME STATUS" Style="{StaticResource ProfileSectionHeader}" Margin="0" />
                                        <Border Grid.Column="1" BackgroundColor="#141D2B" Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 6" Padding="8,2">
                                            <Label Text="{Binding CurrentData.AnimeTotal, StringFormat='{0} total'}"
                                                   FontFamily="InterSemiBold" FontSize="11" TextColor="{StaticResource EmAccent}" />
                                        </Border>
                                    </Grid>

                                    <!-- Anime Status Rows -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AnimeStatBars}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,85,*,40,46" ColumnSpacing="10" VerticalOptions="Center" Padding="0,2">
                                                    <!-- Colored Dot -->
                                                    <Border Grid.Column="0" WidthRequest="10" HeightRequest="10"
                                                            BackgroundColor="{Binding BarColor}" StrokeShape="RoundRectangle 5"
                                                            StrokeThickness="0" VerticalOptions="Center" />
                                                    <!-- Label -->
                                                    <Label Grid.Column="1" Text="{Binding Label}" FontFamily="InterSemiBold" FontSize="13"
                                                           TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                                                    <!-- Modern Pill Progress Track -->
                                                    <Border Grid.Column="2" HeightRequest="8" BackgroundColor="#141D2B"
                                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 4" VerticalOptions="Center" Padding="0">
                                                        <ProgressBar Progress="{Binding Fraction}"
                                                                     ProgressColor="{Binding BarColor}" BackgroundColor="Transparent"
                                                                     HeightRequest="6" VerticalOptions="Center" />
                                                    </Border>
                                                    <!-- Count -->
                                                    <Label Grid.Column="3" Text="{Binding Value}" FontFamily="InterBold" FontSize="13"
                                                           TextColor="{StaticResource BrushText}" HorizontalOptions="End"
                                                           VerticalOptions="Center" />
                                                    <!-- Percentage Badge -->
                                                    <Border Grid.Column="4" BackgroundColor="#0DFFFFFF" StrokeShape="RoundRectangle 4"
                                                            Padding="5,2" HorizontalOptions="End" VerticalOptions="Center">
                                                        <Label Text="{Binding Percent}" FontFamily="InterSemiBold" FontSize="11"
                                                               TextColor="#8899A6" HorizontalOptions="Center" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <BoxView HeightRequest="1" Color="#1AFFFFFF" Margin="0,6" />

                                    <!-- MANGA STATUS Header with Total Badge -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="MANGA STATUS" Style="{StaticResource ProfileSectionHeader}" Margin="0" />
                                        <Border Grid.Column="1" BackgroundColor="#141D2B" Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 6" Padding="8,2">
                                            <Label Text="{Binding CurrentData.MangaTotal, StringFormat='{0} total'}"
                                                   FontFamily="InterSemiBold" FontSize="11" TextColor="#22C55E" />
                                        </Border>
                                    </Grid>

                                    <!-- Manga Status Rows -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MangaStatBars}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,85,*,40,46" ColumnSpacing="10" VerticalOptions="Center" Padding="0,2">
                                                    <!-- Colored Dot -->
                                                    <Border Grid.Column="0" WidthRequest="10" HeightRequest="10"
                                                            BackgroundColor="{Binding BarColor}" StrokeShape="RoundRectangle 5"
                                                            StrokeThickness="0" VerticalOptions="Center" />
                                                    <!-- Label -->
                                                    <Label Grid.Column="1" Text="{Binding Label}" FontFamily="InterSemiBold" FontSize="13"
                                                           TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                                                    <!-- Modern Pill Progress Track -->
                                                    <Border Grid.Column="2" HeightRequest="8" BackgroundColor="#141D2B"
                                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 4" VerticalOptions="Center" Padding="0">
                                                        <ProgressBar Progress="{Binding Fraction}"
                                                                     ProgressColor="{Binding BarColor}" BackgroundColor="Transparent"
                                                                     HeightRequest="6" VerticalOptions="Center" />
                                                    </Border>
                                                    <!-- Count -->
                                                    <Label Grid.Column="3" Text="{Binding Value}" FontFamily="InterBold" FontSize="13"
                                                           TextColor="{StaticResource BrushText}" HorizontalOptions="End"
                                                           VerticalOptions="Center" />
                                                    <!-- Percentage Badge -->
                                                    <Border Grid.Column="4" BackgroundColor="#0DFFFFFF" StrokeShape="RoundRectangle 4"
                                                            Padding="5,2" HorizontalOptions="End" VerticalOptions="Center">
                                                        <Label Text="{Binding Percent}" FontFamily="InterSemiBold" FontSize="11"
                                                               TextColor="#8899A6" HorizontalOptions="Center" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- LIBRARY STATISTICS (Clean Modern 2-Column Grid) -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="LIBRARY STATISTICS" Style="{StaticResource ProfileSectionHeader}" />

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                                        <!-- Mean Scores -->
                                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#141D2B"
                                                Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8" Padding="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding CurrentData.AnimeMeanShort, FallbackValue='0.0'}"
                                                       FontFamily="InterBold" FontSize="20" TextColor="{StaticResource EmAccent}" />
                                                <Label Text="Mean anime score" FontFamily="Inter" FontSize="11" TextColor="#8899A6" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#141D2B"
                                                Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8" Padding="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding CurrentData.MangaMeanShort, FallbackValue='0.0'}"
                                                       FontFamily="InterBold" FontSize="20" TextColor="#22C55E" />
                                                <Label Text="Mean manga score" FontFamily="Inter" FontSize="11" TextColor="#8899A6" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Counts & Episodes -->
                                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#141D2B"
                                                Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8" Padding="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding CurrentData.AnimeTotal, StringFormat='{0} anime'}"
                                                       FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource BrushText}" />
                                                <Label Text="{Binding CurrentData.AnimeEpisodes, StringFormat='{0} episodes watched'}"
                                                       FontFamily="Inter" FontSize="11" TextColor="#8899A6" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#141D2B"
                                                Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8" Padding="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding CurrentData.MangaTotal, StringFormat='{0} manga'}"
                                                       FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource BrushText}" />
                                                <Label Text="{Binding CurrentData.MangaChapters, StringFormat='{0} chapters read'}"
                                                       FontFamily="Inter" FontSize="11" TextColor="#8899A6" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Days & Rewatches -->
                                        <Border Grid.Row="2" Grid.Column="0" BackgroundColor="#141D2B"
                                                Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8" Padding="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding CurrentData.AnimeDaysBind}"
                                                       FontFamily="Inter" FontSize="12" TextColor="{StaticResource BrushText}" />
                                                <Label Text="{Binding CurrentData.AnimeRewatched, StringFormat='{0} rewatches'}"
                                                       FontFamily="Inter" FontSize="11" TextColor="#8899A6" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="1" BackgroundColor="#141D2B"
                                                Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8" Padding="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding CurrentData.MangaDaysBind}"
                                                       FontFamily="Inter" FontSize="12" TextColor="{StaticResource BrushText}" />
                                                <Label Text="{Binding CurrentData.MangaReread, StringFormat='{0} rereads'}"
                                                       FontFamily="Inter" FontSize="11" TextColor="#8899A6" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>

                                    <!-- Time spent -->
                                    <Border BackgroundColor="#141D2B" Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Padding="12" Margin="0,4,0,0">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="TIME SPENT" Style="{StaticResource ProfileSectionHeader}" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Label Text="{Binding ApproxTimeSpentOnAnime}" FontFamily="InterSemiBold"
                                                       FontSize="14" TextColor="{StaticResource BrushText}" />
                                                <Label Grid.Column="1" Text="anime watched (estimated)" FontFamily="Inter" FontSize="11"
                                                       TextColor="#8899A6" VerticalOptions="Center" />
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Label Text="{Binding ApproxTimeSpentOnAnimeAndMovies}" FontFamily="InterSemiBold"
                                                       FontSize="14" TextColor="{StaticResource BrushText}" />
                                                <Label Grid.Column="1" Text="including movies" FontFamily="Inter" FontSize="11"
                                                       TextColor="#8899A6" VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
