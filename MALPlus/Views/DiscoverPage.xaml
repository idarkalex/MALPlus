<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             x:Class="MALPlus.Views.DiscoverPage"
             BackgroundColor="{StaticResource EmBackground}">

    <Grid RowDefinitions="Auto,*">
        <!-- Fixed header: the old title lived inside the scroll and scrolled away -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,20,16,6" ColumnSpacing="12">
            <Label Grid.Column="0" Text="Discover" FontFamily="InterBold" FontSize="26"
                   TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
            <ActivityIndicator x:Name="HeaderSpinner" Grid.Column="1" Color="#0066FF"
                               WidthRequest="22" HeightRequest="22" IsRunning="False" />
        </Grid>

        <ScrollView Grid.Row="1">
            <!-- The bottom inset clears the navigation bar, which floats over this scroll rather
                 than taking a row of its own. -->
            <VerticalStackLayout Padding="12,8,12,96">
                <!-- The buttons are the capsules from the artwork, blue canvas already erased. Six
                     explicit Auto rows on purpose: without them every tile placed at Grid.Row 1 or
                     lower falls outside the row collection and silently does not draw. -->
                <Grid x:Name="TileGrid"
                      ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10" RowSpacing="10">
                    <controls:DiscoverTileButton Grid.Row="0" Grid.Column="0"
                                                 Source="discover_btn_search"
                                                 AutomationId="DiscoverSearch" SemanticProperties.Description="Search"
                                                 Tapped="OnSearchTapped" />
                    <controls:DiscoverTileButton Grid.Row="0" Grid.Column="1"
                                                 Source="discover_btn_trending"
                                                 AutomationId="DiscoverTrending" SemanticProperties.Description="Trending"
                                                 Tapped="OnTrendingTapped" />
                    <controls:DiscoverTileButton Grid.Row="1" Grid.Column="0"
                                                 Source="discover_btn_upcoming"
                                                 AutomationId="DiscoverUpcoming" SemanticProperties.Description="Upcoming"
                                                 Tapped="OnUpcomingAllTapped" />
                    <controls:DiscoverTileButton Grid.Row="1" Grid.Column="1"
                                                 Source="discover_btn_calendar"
                                                 AutomationId="DiscoverYourCalendar" SemanticProperties.Description="Your calendar"
                                                 Tapped="OnUpcomingMineTapped" />
                    <!-- The two random capsules keep their artwork's gear on the right, and it is part
                         of the picture: the filters are reached from the popup the tap opens, not from
                         a hot zone over the artwork. -->
                    <controls:DiscoverTileButton Grid.Row="2" Grid.Column="0"
                                                 Source="discover_btn_random_anime"
                                                 AutomationId="DiscoverRandomAnime" SemanticProperties.Description="Random anime"
                                                 Tapped="OnRandomAnimeTapped" />
                    <controls:DiscoverTileButton Grid.Row="2" Grid.Column="1"
                                                 Source="discover_btn_random_manga"
                                                 AutomationId="DiscoverRandomManga" SemanticProperties.Description="Random manga"
                                                 Tapped="OnRandomMangaTapped" />
                    <controls:DiscoverTileButton Grid.Row="3" Grid.Column="0"
                                                 Source="discover_btn_gem"
                                                 AutomationId="DiscoverRandomGem" SemanticProperties.Description="Random gem"
                                                 Tapped="OnGemTapped" />
                    <controls:DiscoverTileButton Grid.Row="3" Grid.Column="1"
                                                 Source="discover_btn_news"
                                                 AutomationId="DiscoverNews" SemanticProperties.Description="News"
                                                 Tapped="OnNewsTapped" />
                    <controls:DiscoverTileButton Grid.Row="4" Grid.Column="0"
                                                 Source="discover_btn_recommend"
                                                 AutomationId="DiscoverRecommendations" SemanticProperties.Description="Because you liked"
                                                 Tapped="OnBecauseYouLikedTapped" />
                    <controls:DiscoverTileButton Grid.Row="4" Grid.Column="1"
                                                 Source="discover_btn_season_oped"
                                                 AutomationId="DiscoverSeasonThemes" SemanticProperties.Description="Season openings and endings"
                                                 Tapped="OnSeasonThemesTapped" />
                    <controls:DiscoverTileButton Grid.Row="5" Grid.Column="0"
                                                 Source="discover_btn_theme"
                                                 AutomationId="DiscoverRandomTheme" SemanticProperties.Description="Random theme"
                                                 Tapped="OnRandomThemeTapped" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="1" VerticalOptions="End" />
    </Grid>
</ContentPage>
