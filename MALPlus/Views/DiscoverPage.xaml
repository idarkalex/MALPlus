<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             x:Class="MALPlus.Views.DiscoverPage"
             BackgroundColor="{StaticResource EmBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Category accent colors -->
            <Color x:Key="TintBlueBg">#1A0066FF</Color>
            <Color x:Key="TintBlueIcon">#3B82F6</Color>

            <Color x:Key="TintAmberBg">#20F2A93B</Color>
            <Color x:Key="TintAmberIcon">#F59E0B</Color>

            <Color x:Key="TintVioletBg">#209A7BFF</Color>
            <Color x:Key="TintVioletIcon">#A855F7</Color>

            <!-- Card border style -->
            <Style x:Key="DiscoverCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource EmSheet}" />
                <Setter Property="Stroke" Value="{StaticResource EmBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="14" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Chip style for icons -->
            <Style x:Key="DiscoverChipStyle" TargetType="Border">
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="10" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DiscoverCardTitle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource BrushText}" />
                <Setter Property="FontFamily" Value="InterBold" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="DiscoverCardSub" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TabChipInactiveText}" />
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MaxLines" Value="2" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <!-- Top padding 18 clears status bar cleanly; bottom padding 96 clears floating BottomNavBar -->
            <VerticalStackLayout Padding="14,18,14,96" Spacing="14">

                <!-- 1. Functional Search Bar + News Button -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0" Style="{StaticResource DiscoverCardStyle}" HeightRequest="50" Padding="12,0"
                            AutomationId="DiscoverSearch" SemanticProperties.Description="Search">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="&#xf002;" FontFamily="FontAwesome" FontSize="16"
                                   TextColor="{StaticResource TabChipInactiveText}" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSearchTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Entry x:Name="SearchInputField" Grid.Column="1"
                                   Placeholder="Search anime, manga…"
                                   PlaceholderColor="{StaticResource TabChipInactiveText}"
                                   TextColor="{StaticResource BrushText}"
                                   FontFamily="Inter" FontSize="14"
                                   VerticalOptions="Center"
                                   BackgroundColor="Transparent"
                                   ReturnType="Search"
                                   HandlerChanged="OnSearchInputHandlerChanged"
                                   Completed="OnSearchInputCompleted" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DiscoverCardStyle}" WidthRequest="50" HeightRequest="50" Padding="0"
                            AutomationId="DiscoverNews" SemanticProperties.Description="News">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNewsTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="&#xf1ea;" FontFamily="FontAwesome" FontSize="18"
                               TextColor="{StaticResource TabChipInactiveText}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- 2. Hero: Because you liked... -->
                <Border StrokeThickness="1" Stroke="#264A7E" Padding="18,16" Margin="0,4,0,4"
                        AutomationId="DiscoverRecommendations" SemanticProperties.Description="Because you liked">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#10325E" Offset="0.0" />
                            <GradientStop Color="#251654" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBecauseYouLikedTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Border BackgroundColor="#26FFFFFF" StrokeThickness="0" Padding="7,3" HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5" />
                                </Border.StrokeShape>
                                <Label Text="FOR YOU" TextColor="#93C5FD" FontFamily="InterBold" FontSize="10"
                                       CharacterSpacing="1.2" />
                            </Border>
                            <Label Text="Because you liked…" TextColor="{StaticResource BrushText}"
                                   FontFamily="InterBold" FontSize="19" />
                            <Label Text="Picks tailored to your anime scores and status"
                                   TextColor="{StaticResource TabChipInactiveText}"
                                   FontFamily="Inter" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="&#xf005;" FontFamily="FontAwesome" FontSize="28"
                               TextColor="#60A5FA" VerticalOptions="Center" Margin="0,0,6,0" />
                    </Grid>
                </Border>

                <!-- 3. EXPLORE SECTION -->
                <HorizontalStackLayout Spacing="8" Margin="2,8,2,0" VerticalOptions="Center">
                    <BoxView WidthRequest="3" HeightRequest="13" Color="{StaticResource TintBlueIcon}" VerticalOptions="Center" />
                    <Label Text="EXPLORE" FontFamily="InterBold" FontSize="11" CharacterSpacing="1.2"
                           TextColor="{StaticResource TabChipInactiveText}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <!-- Trending -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DiscoverCardStyle}"
                            AutomationId="DiscoverTrending" SemanticProperties.Description="Trending">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTrendingTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Border Style="{StaticResource DiscoverChipStyle}" BackgroundColor="{StaticResource TintBlueBg}">
                                <Label Text="&#xf06d;" FontFamily="FontAwesome" FontSize="18"
                                       TextColor="{StaticResource TintBlueIcon}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Trending" Style="{StaticResource DiscoverCardTitle}" />
                                <Label Text="What's popular right now" Style="{StaticResource DiscoverCardSub}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Hidden Gem -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DiscoverCardStyle}"
                            AutomationId="DiscoverRandomGem" SemanticProperties.Description="Random gem">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGemTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Border Style="{StaticResource DiscoverChipStyle}" BackgroundColor="{StaticResource TintBlueBg}">
                                <Label Text="&#xf219;" FontFamily="FontAwesome" FontSize="17"
                                       TextColor="{StaticResource TintBlueIcon}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Hidden Gem" Style="{StaticResource DiscoverCardTitle}" />
                                <Label Text="High score, low popularity" Style="{StaticResource DiscoverCardSub}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Global Calendar -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DiscoverCardStyle}"
                            AutomationId="DiscoverUpcoming" SemanticProperties.Description="Upcoming">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUpcomingAllTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Border Style="{StaticResource DiscoverChipStyle}" BackgroundColor="{StaticResource TintBlueBg}">
                                <Label Text="&#xf0ac;" FontFamily="FontAwesome" FontSize="18"
                                       TextColor="{StaticResource TintBlueIcon}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Global Calendar" Style="{StaticResource DiscoverCardTitle}" />
                                <Label Text="All upcoming releases" Style="{StaticResource DiscoverCardSub}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Your Calendar -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DiscoverCardStyle}"
                            AutomationId="DiscoverYourCalendar" SemanticProperties.Description="Your calendar">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUpcomingMineTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Border Style="{StaticResource DiscoverChipStyle}" BackgroundColor="{StaticResource TintBlueBg}">
                                <Label Text="&#xf073;" FontFamily="FontAwesome" FontSize="17"
                                       TextColor="{StaticResource TintBlueIcon}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Your Calendar" Style="{StaticResource DiscoverCardTitle}" />
                                <Label Text="Episodes in your list" Style="{StaticResource DiscoverCardSub}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- 4. SURPRISE ME SECTION -->
                <HorizontalStackLayout Spacing="8" Margin="2,8,2,0" VerticalOptions="Center">
                    <BoxView WidthRequest="3" HeightRequest="13" Color="{StaticResource TintAmberIcon}" VerticalOptions="Center" />
                    <Label Text="SURPRISE ME" FontFamily="InterBold" FontSize="11" CharacterSpacing="1.2"
                           TextColor="{StaticResource TabChipInactiveText}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Random Anime: Main zone taps anime; gear button taps filters without conflict -->
                    <Border Grid.Column="0" Style="{StaticResource DiscoverCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="10"
                                                 AutomationId="DiscoverRandomAnime" SemanticProperties.Description="Random anime">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRandomAnimeTapped" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Border Style="{StaticResource DiscoverChipStyle}" BackgroundColor="{StaticResource TintAmberBg}">
                                    <Label Text="&#xf008;" FontFamily="FontAwesome" FontSize="17"
                                           TextColor="{StaticResource TintAmberIcon}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Random Anime" Style="{StaticResource DiscoverCardTitle}" />
                                    <Label Text="Roll the dice" Style="{StaticResource DiscoverCardSub}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Independent filter gear button -->
                            <Border Grid.Column="1" VerticalOptions="Start"
                                    WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                    BackgroundColor="{StaticResource TintAmberBg}" Padding="0"
                                    SemanticProperties.Description="Random anime filters">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRandomAnimeFiltersTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="&#xf013;" FontFamily="FontAwesome" FontSize="15"
                                       TextColor="{StaticResource TintAmberIcon}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Random Manga: Main zone taps manga; gear button taps filters without conflict -->
                    <Border Grid.Column="1" Style="{StaticResource DiscoverCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="10"
                                                 AutomationId="DiscoverRandomManga" SemanticProperties.Description="Random manga">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRandomMangaTapped" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Border Style="{StaticResource DiscoverChipStyle}" BackgroundColor="{StaticResource TintAmberBg}">
                                    <Label Text="&#xf02d;" FontFamily="FontAwesome" FontSize="17"
                                           TextColor="{StaticResource TintAmberIcon}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Random Manga" Style="{StaticResource DiscoverCardTitle}" />
                                    <Label Text="Roll the dice" Style="{StaticResource DiscoverCardSub}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Independent filter gear button -->
                            <Border Grid.Column="1" VerticalOptions="Start"
                                    WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                    BackgroundColor="{StaticResource TintAmberBg}" Padding="0"
                                    SemanticProperties.Description="Random manga filters">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRandomMangaFiltersTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="&#xf013;" FontFamily="FontAwesome" FontSize="15"
                                       TextColor="{StaticResource TintAmberIcon}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. MUSIC SECTION -->
                <HorizontalStackLayout Spacing="8" Margin="2,8,2,0" VerticalOptions="Center">
                    <BoxView WidthRequest="3" HeightRequest="13" Color="{StaticResource TintVioletIcon}" VerticalOptions="Center" />
                    <Label Text="MUSIC" FontFamily="InterBold" FontSize="11" CharacterSpacing="1.2"
                           TextColor="{StaticResource TabChipInactiveText}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Season Themes -->
                    <Border Grid.Column="0" Style="{StaticResource DiscoverCardStyle}"
                            AutomationId="DiscoverSeasonThemes" SemanticProperties.Description="Season openings and endings">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSeasonThemesTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Border Style="{StaticResource DiscoverChipStyle}" BackgroundColor="{StaticResource TintVioletBg}">
                                <Label Text="&#xf001;" FontFamily="FontAwesome" FontSize="17"
                                       TextColor="{StaticResource TintVioletIcon}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Season OP/ED" Style="{StaticResource DiscoverCardTitle}" />
                                <Label Text="This season's themes" Style="{StaticResource DiscoverCardSub}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Random Theme -->
                    <Border Grid.Column="1" Style="{StaticResource DiscoverCardStyle}"
                            AutomationId="DiscoverRandomTheme" SemanticProperties.Description="Random theme">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRandomThemeTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Border Style="{StaticResource DiscoverChipStyle}" BackgroundColor="{StaticResource TintVioletBg}">
                                <Label Text="&#xf074;" FontFamily="FontAwesome" FontSize="17"
                                       TextColor="{StaticResource TintVioletIcon}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Random Theme" Style="{StaticResource DiscoverCardTitle}" />
                                <Label Text="Creditless roulette" Style="{StaticResource DiscoverCardSub}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating ActivityIndicator in top-right corner, non-blocking touch target -->
        <ActivityIndicator x:Name="HeaderSpinner" Color="{StaticResource EmAccent}"
                           WidthRequest="22" HeightRequest="22" IsRunning="False"
                           HorizontalOptions="End" VerticalOptions="Start"
                           Margin="0,8,16,0" ZIndex="10" InputTransparent="True" />

        <controls:BottomNavBar x:Name="BottomNav" VerticalOptions="End" />
    </Grid>
</ContentPage>