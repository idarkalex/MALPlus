<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
xmlns:vm="clr-namespace:MALPlus.XShared.ViewModels.Main;assembly=MALPlus.Core"
xmlns:mmalspecific="clr-namespace:MALPlus.Models.Models.MalSpecific;assembly=MALPlus.Core"
             x:Class="MALPlus.Views.MessagingPage"
             x:DataType="vm:MalMessagingViewModel"
             BackgroundColor="{DynamicResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:IntEqualityConverter x:Key="IntEq" />
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding LoadingVisibility, FallbackValue=false}" BackgroundColor="#80000000" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>

        <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding LoadingVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert, FallbackValue=true}">
            <!-- Header with title and compose -->
            <Grid Grid.Row="0" Padding="16,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="Messages" FontFamily="InterBold" FontSize="22"
                       TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                <controls:WindowsRefreshButton Grid.Column="1" Clicked="OnRefreshing" />
                <Button Grid.Column="2" Text="✚" Clicked="OnComposeClicked"
                        FontFamily="InterBold" FontSize="20" BackgroundColor="#0066FF" TextColor="White"
                        CornerRadius="20" WidthRequest="40" HeightRequest="40" Padding="0" />
            </Grid>

            <!-- Tab strip: Inbox / Sent -->
            <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        Padding="16,0,16,10">
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="TabInbox" Text="Inbox" Clicked="OnTabButtonClicked" CommandParameter="0"
                            Style="{StaticResource TabChipActiveButtonStyle}" />
                    <Button x:Name="TabSent" Text="Sent" Clicked="OnTabButtonClicked" CommandParameter="1"
                            Style="{StaticResource TabChipButtonStyle}" />
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Inbox tab -->
            <RefreshView Grid.Row="2" IsRefreshing="{Binding LoadingVisibility, Mode=OneWay}" Refreshing="OnRefreshing"
                         IsVisible="{Binding DisplaySentMessages, Converter={StaticResource BoolVis}, ConverterParameter=invert, FallbackValue=true}">
                <CollectionView ItemsSource="{Binding MessageIndex}" SelectionMode="None"
                                RemainingItemsThreshold="3"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                    <CollectionView.EmptyView>
                        <Label Text="No messages" FontFamily="Inter" FontSize="13"
                               TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate
                        x:DataType="mmalspecific:MalMessageModel">
                            <Border Margin="16,4" BackgroundColor="{DynamicResource EmSheet}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMessageTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding Subject}" FontFamily="InterBold" FontSize="14"
                                               TextColor="{StaticResource BrushText}" MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" Text="{Binding Date}" FontFamily="Inter" FontSize="11"
                                               TextColor="#80FFFFFF" />
                                    </Grid>
                                    <Label Grid.Row="1" Text="{Binding Target, StringFormat='From: {0}'}" FontFamily="Inter" FontSize="12"
                                           TextColor="{StaticResource EmAccent}" />
                                    <Label Grid.Row="2" Text="{Binding Content}" FontFamily="Inter" FontSize="12"
                                           TextColor="#C0FFFFFF" MaxLines="2" LineBreakMode="TailTruncation" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Sent tab -->
            <RefreshView Grid.Row="2" IsRefreshing="{Binding LoadingVisibility, Mode=OneWay}" Refreshing="OnRefreshing"
                         IsVisible="{Binding DisplaySentMessages, FallbackValue=false}">
                <CollectionView ItemsSource="{Binding MessageIndex}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No sent messages" FontFamily="Inter" FontSize="13"
                               TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate
                        x:DataType="mmalspecific:MalMessageModel">
                            <Border Margin="16,4" BackgroundColor="{DynamicResource EmSheet}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMessageTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding Subject}" FontFamily="InterBold" FontSize="14"
                                               TextColor="{StaticResource BrushText}" MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" Text="{Binding Date}" FontFamily="Inter" FontSize="11"
                                               TextColor="#80FFFFFF" />
                                    </Grid>
                                    <Label Grid.Row="1" Text="{Binding Target, StringFormat='To: {0}'}" FontFamily="Inter" FontSize="12"
                                           TextColor="{StaticResource EmAccent}" />
                                    <Label Grid.Row="2" Text="{Binding Content}" FontFamily="Inter" FontSize="12"
                                           TextColor="#C0FFFFFF" MaxLines="2" LineBreakMode="TailTruncation" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
