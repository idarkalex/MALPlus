<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             xmlns:tanimescrapped="clr-namespace:MALPlus.Models.Models.AnimeScrapped;assembly=MALPlus.Core"
             xmlns:vm="clr-namespace:MALPlus.XShared.ViewModels.Main;assembly=MALPlus.Core"
             x:Class="MALPlus.Views.VideosPage"
             x:DataType="vm:PopularVideosViewModel"
             BackgroundColor="{DynamicResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding Loading}" BackgroundColor="#80000000" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>

        <Grid x:Name="VideoListRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,12">
                <Label Grid.Column="0" Text="Promotional Videos" FontFamily="InterBold" FontSize="22"
                       TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                <controls:WindowsRefreshButton Grid.Column="1" Clicked="OnRefreshing" />
            </Grid>

            <RefreshView Grid.Row="1" IsRefreshing="{Binding Refreshing}" Refreshing="OnRefreshing">
                <CollectionView ItemsSource="{Binding Videos}" SelectionMode="Single"
                                SelectionChanged="OnVideoTapped"
                                RemainingItemsThreshold="2"
                                RemainingItemsThresholdReached="OnLoadMore">
                    <CollectionView.EmptyView>
                        <Label Text="No videos yet" FontFamily="Inter" FontSize="13"
                               TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate
                        x:DataType="tanimescrapped:AnimeVideoData">
                            <Border Margin="16,6" BackgroundColor="{DynamicResource EmSheet}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14" Padding="0">
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="0">
                                    <Image Grid.Column="0" Source="{Binding Thumb, Converter={StaticResource ImageConverter}}"
                                           Aspect="AspectFill" HeightRequest="80" WidthRequest="120" />
                                    <VerticalStackLayout Grid.Column="1" Padding="10,8" Spacing="4">
                                        <Label Text="{Binding Name}" FontFamily="InterBold" FontSize="13"
                                               TextColor="{StaticResource BrushText}" MaxLines="2"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding AnimeTitle}" FontFamily="Inter" FontSize="11"
                                               TextColor="{StaticResource EmAccent}" MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- In-app video overlay -->
        <Grid x:Name="VideoOverlay" IsVisible="False" BackgroundColor="#000000" ZIndex="100" InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer />
            </Grid.GestureRecognizers>
            <WebView x:Name="VideoWebView" BackgroundColor="#000000" ZIndex="1" />
            <HorizontalStackLayout x:Name="OverlayControls" HorizontalOptions="End" VerticalOptions="Start"
                                   Margin="0,12,12,0" Spacing="8" ZIndex="50">
                <Border x:Name="VideoCloseButton" WidthRequest="40" HeightRequest="40"
                        BackgroundColor="#B3051522" Stroke="#4DFFFFFF" StrokeThickness="1"
                        StrokeShape="RoundRectangle 20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseVideo" />
                    </Border.GestureRecognizers>
                    <Image Source="icon_close.png" WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
