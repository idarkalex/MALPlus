<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.RecommendationsPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolVis" />

            <!-- Misma tarjeta que Discover (EmSheet + EmBorder). Si hoisteas DiscoverCardStyle a
                 App.xaml / Styles, borra esta copia local y usa la global. -->
            <Style x:Key="RecCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource EmSheet}" />
                <Setter Property="Stroke" Value="{StaticResource EmBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="14" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RecCaption" TargetType="Label">
                <Setter Property="FontFamily" Value="InterBold" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="CharacterSpacing" Value="1.2" />
                <Setter Property="TextTransform" Value="Uppercase" />
                <Setter Property="TextColor" Value="{StaticResource TabChipInactiveText}" />
            </Style>

            <Style x:Key="RecPosterTitle" TargetType="Label">
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource BrushText}" />
                <Setter Property="MaxLines" Value="2" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding Loading}" BackgroundColor="#80000000" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>

        <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding Loading, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <Label Grid.Row="0" Text="Recommendations" FontFamily="InterBold" FontSize="22"
                   TextColor="{StaticResource BrushText}" Padding="16,18,16,8" />

            <!-- Sin cambios: los chips y sus nombres los usa el code-behind. -->
            <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        Padding="12,0,12,8">
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="TopAnimeTab" Text="Top Anime" Clicked="OnModeClicked"
                            CommandParameter="TopAnime" Style="{StaticResource TabChipActiveButtonStyle}" />
                    <Button x:Name="RecentAnimeTab" Text="Recent Anime" Clicked="OnModeClicked"
                            CommandParameter="Anime" Style="{StaticResource TabChipButtonStyle}" />
                    <Button x:Name="TopMangaTab" Text="Top Manga" Clicked="OnModeClicked"
                            CommandParameter="TopManga" Style="{StaticResource TabChipButtonStyle}" />
                    <Button x:Name="RecentMangaTab" Text="Recent Manga" Clicked="OnModeClicked"
                            CommandParameter="Manga" Style="{StaticResource TabChipButtonStyle}" />
                </HorizontalStackLayout>
            </ScrollView>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout Padding="16,8,16,16" Spacing="18">

                    <!-- El par de portadas. Se mantiene el reparto *,*,* con el mismo padding de 16 de
                         antes: cada portada sigue cayendo en el ancho de celda del grid de la libreria y la
                         columna central sigue midiendo una portada, que es donde cabe el conector.

                         Tres filas en vez de una: el caption dice quien es quien, el poster va solo
                         (TitleOverlay apagado, el titulo ya no se repite encima y debajo) y el titulo
                         completo va debajo. El conector se centra en la fila del poster, no en el
                         bloque entero. Los toques siguen en el Grid de fondo Transparent, que es lo que
                         funciona en este proyecto, y tambien en los titulos. -->
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8"
                          VerticalOptions="Start" IsVisible="{Binding HasAny}">

                        <Label Grid.Row="0" Grid.Column="0" Text="If you like" Style="{StaticResource RecCaption}" />
                        <Label Grid.Row="0" Grid.Column="2" Text="You might like" Style="{StaticResource RecCaption}"
                               TextColor="{StaticResource EmAccent}" />

                        <Grid Grid.Row="1" Grid.Column="0" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDependentTapped" />
                            </Grid.GestureRecognizers>
                            <Border StrokeThickness="0" Padding="0" HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <controls:AnimePosterCard
                                    WidthRequest="130"
                                    HeightRequest="{x:Static controls:AnimePosterGrid.DefaultCellHeight}"
                                    PosterUrl="{Binding DependentItem.ImgUrl}"
                                    Title="{Binding DependentItem.Title}"
                                    TitleOverlay="False"
                                    TypeTag="{Binding DependentItem.TypeTag}"
                                    ScoreTag="{Binding DependentItem.CardScore}"
                                    SeasonTag="{Binding DependentItem.SeasonTag}"
                                    BottomAirTag="{Binding DependentItem.BottomAirTag}"
                                    BadgeVisible="True"
                                    BadgeAccent="{Binding DependentItem.LibraryBadgeAccent}"
                                    BadgeAccentColor="{Binding DependentItem.LibraryBadgeAccentColor}"
                                    BadgeMain="{Binding DependentItem.LibraryBadgeMain}" />
                            </Border>
                        </Grid>

                        <!-- Conector: circulo azul translucido, el mismo lenguaje que el chip de votos -->
                        <Border Grid.Row="1" Grid.Column="1" WidthRequest="40" HeightRequest="40" Padding="0"
                                BackgroundColor="#1A0066FF" Stroke="#330066FF" StrokeThickness="1"
                                HorizontalOptions="Center" VerticalOptions="Center"
                                InputTransparent="True">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Image Source="icon_arrow_right.png" WidthRequest="22" HeightRequest="22"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Grid Grid.Row="1" Grid.Column="2" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRecommendedTapped" />
                            </Grid.GestureRecognizers>
                            <Border StrokeThickness="0" Padding="0" HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <controls:AnimePosterCard
                                    WidthRequest="130"
                                    HeightRequest="{x:Static controls:AnimePosterGrid.DefaultCellHeight}"
                                    PosterUrl="{Binding RecommendedItem.ImgUrl}"
                                    Title="{Binding RecommendedItem.Title}"
                                    TitleOverlay="False"
                                    TypeTag="{Binding RecommendedItem.TypeTag}"
                                    ScoreTag="{Binding RecommendedItem.CardScore}"
                                    SeasonTag="{Binding RecommendedItem.SeasonTag}"
                                    BottomAirTag="{Binding RecommendedItem.BottomAirTag}"
                                    BadgeVisible="True"
                                    BadgeAccent="{Binding RecommendedItem.LibraryBadgeAccent}"
                                    BadgeAccentColor="{Binding RecommendedItem.LibraryBadgeAccentColor}"
                                    BadgeMain="{Binding RecommendedItem.LibraryBadgeMain}" />
                            </Border>
                        </Grid>

                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding DependentItem.Title}"
                               Style="{StaticResource RecPosterTitle}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDependentTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Grid.Row="2" Grid.Column="2" Text="{Binding RecommendedItem.Title}"
                               Style="{StaticResource RecPosterTitle}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRecommendedTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Label Text="No recommendations" FontFamily="Inter" FontSize="13"
                           TextColor="{StaticResource TabChipInactiveText}"
                           HorizontalOptions="Center" Margin="0,48"
                           IsVisible="{Binding HasAny, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />

                    <!-- Detalle: lo que escribio la comunidad, en una tarjeta. Sustituye al bloque de
                         "If you like / you might like" con los dos titulos, que repetia lo que ya dicen las
                         portadas, y a la linea divisoria. -->
                    <Border Style="{StaticResource RecCardStyle}" IsVisible="{Binding HasAny}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Community recommendation" Style="{StaticResource RecCaption}" />

                            <Label Text="{Binding CurrentRecommendation.Description}" FontFamily="Inter" FontSize="13"
                                   TextColor="#D0FFFFFF" LineBreakMode="WordWrap" LineHeight="1.25"
                                   IsVisible="{Binding CurrentRecommendation.Description, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}" />

                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center"
                                                       IsVisible="{Binding CurrentRecommendation.RecommendedBy, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}">
                                    <Label Text="by" FontFamily="Inter" FontSize="11"
                                           TextColor="{StaticResource TabChipInactiveText}" />
                                    <Label Text="{Binding CurrentRecommendation.RecommendedBy}"
                                           FontFamily="InterSemiBold" FontSize="11"
                                           TextColor="{StaticResource EmAccent}" />
                                    <Label Text="{Binding CurrentRecommendation.RecommendedWhen}"
                                           FontFamily="Inter" FontSize="11"
                                           TextColor="{StaticResource TabChipInactiveText}" />
                                </HorizontalStackLayout>
                                <Border Padding="6,2"
                                        BackgroundColor="#1A0066FF" Stroke="#330066FF" StrokeThickness="1"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding CurrentRecommendation.HasVotes}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                        <Label Text="★" FontFamily="Inter" FontSize="10" TextColor="#FFD700" VerticalOptions="Center" />
                                        <Label Text="{Binding CurrentRecommendation.VotesText}"
                                               FontFamily="InterSemiBold" FontSize="11" TextColor="#80B4FF"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Solo flechas, sin swipe (decision del calendario, se mantiene). Los botones pasan del
                 contorno #29FFFFFF al circulo relleno #14FFFFFF que usan los selectores de AnimeListPage.
                 Mismo Border + Image, mismos AutomationId y misma opacidad por binding. -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Padding="16,4,16,16" ColumnSpacing="12"
                  IsVisible="{Binding HasAny}">
                <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" Padding="0"
                        BackgroundColor="#14FFFFFF" StrokeThickness="0"
                        HorizontalOptions="Start"
                        AutomationId="RecommendationPrevious"
                        SemanticProperties.Description="Previous recommendation">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPreviousClicked" />
                    </Border.GestureRecognizers>
                    <Image Source="icon_chevron_left" WidthRequest="22" HeightRequest="22"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Opacity="{Binding PreviousOpacity}" />
                </Border>

                <Label Grid.Column="1" Text="{Binding CounterText}" FontFamily="InterSemiBold" FontSize="13"
                       TextColor="{StaticResource TabChipInactiveText}"
                       HorizontalOptions="Center" VerticalOptions="Center" />

                <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" Padding="0"
                        BackgroundColor="#14FFFFFF" StrokeThickness="0"
                        HorizontalOptions="End"
                        AutomationId="RecommendationNext"
                        SemanticProperties.Description="Next recommendation">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNextClicked" />
                    </Border.GestureRecognizers>
                    <Image Source="icon_chevron_right" WidthRequest="22" HeightRequest="22"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Opacity="{Binding NextOpacity}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
