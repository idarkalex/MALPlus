<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             x:Class="MALPlus.Views.SearchPage"
             x:Name="Page"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:IntEqualityConverter x:Key="IntEq" />
        <converters:BoolTabColorConverter x:Key="BoolTab" />
        <converters:TabColorConverter x:Key="TabColorConverter" />
        <!-- One row of the recent searches dropdown. A Border with a tap rather than a
             CollectionView cell, because the results grid below is already a CollectionView
             and two of them overlapping fight over the touch on Android. -->
        <DataTemplate x:Key="RecentSearchRow">
            <Border BackgroundColor="{StaticResource EmSheet}" Padding="16,12">
                <!-- The background has to be a real colour: with a transparent one the row is
                     not hit tested, the tap falls through to whatever is underneath and the
                     list only ever closes. Same colour as the panel, so it stays invisible. -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRecentSearchRowTapped"
                                          CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="Search" FontSize="12" VerticalOptions="Center" />
                        <Label Text="{Binding .}" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <!-- Tapping the X must not run the search, so it carries its own recognizer
                         and stops the row from seeing the touch. -->
                    <Label Grid.Column="1" Text="✕" FontSize="15" VerticalOptions="Center"
                           TextColor="#80FFFFFF"
                           HorizontalOptions="Center" VerticalTextAlignment="Center"
                           WidthRequest="32" HeightRequest="32">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRecentSearchRemoveTapped"
                                                  CommandParameter="{Binding .}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Top tab strip: Main / Characters / Genres / Studios -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    Padding="12,12,12,0" BackgroundColor="{StaticResource EmBackground}">
            <HorizontalStackLayout Spacing="6">
                <Label Text="Main" FontFamily="InterSemiBold" FontSize="13"
                       Padding="12,8" TextColor="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource TabColorConverter}, ConverterParameter=0}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTabTapped" CommandParameter="0" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Characters" FontFamily="InterSemiBold" FontSize="13"
                       Padding="12,8" TextColor="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource TabColorConverter}, ConverterParameter=1}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTabTapped" CommandParameter="1" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Genres" FontFamily="InterSemiBold" FontSize="13"
                       Padding="12,8" TextColor="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource TabColorConverter}, ConverterParameter=2}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTabTapped" CommandParameter="2" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Studios" FontFamily="InterSemiBold" FontSize="13"
                       Padding="12,8" TextColor="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource TabColorConverter}, ConverterParameter=3}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTabTapped" CommandParameter="3" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- ============ Main tab (0) ============ -->
        <Grid Grid.Row="1" Grid.RowSpan="2"
              IsVisible="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource IntEq}, ConverterParameter=0}">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Search bar (hidden in catalogue mode) -->
                <Grid Grid.Row="0" IsVisible="{Binding DirectQueryInputVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                      Padding="16,8" ColumnDefinitions="*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                    <!-- Row 1 is the recent searches list. It lives inside the bar's own grid so
                         it can only ever render directly under the bar, with no offset to compute
                         and nothing to overlap. -->
                    <Entry Grid.Row="0" x:Name="SearchEntry" Placeholder="Search anime, manga..."
                           Text="{Binding InternalQuery, Mode=TwoWay}"
                           FontFamily="Inter" FontSize="14"
                           BackgroundColor="{StaticResource EmSheet}"
                           TextColor="{StaticResource BrushText}"
                           PlaceholderColor="#80FFFFFF"
                           ReturnType="Search"
                           Completed="OnSearchCompleted" />
                    <Button Grid.Row="0" Grid.Column="1" Text="Go"
                            Command="{Binding SearchCommand}"
                            FontFamily="InterBold" FontSize="16"
                            BackgroundColor="#0066FF" TextColor="White"
                            CornerRadius="8" WidthRequest="48" HeightRequest="48" Padding="0" />

                    <Border Grid.Row="1" Margin="0,8,0,0"
                            IsVisible="False" x:Name="RecentSearchesDrop"
                            BackgroundColor="{StaticResource EmSheet}"
                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12" Padding="4">
                        <!-- Rows, not a CollectionView: the results below already are one and
                             two overlapping ones fight over the touch on Android. The list holds
                             at most eight entries, so a stack layout is enough. -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentSearches}"
                                             BindableLayout.ItemTemplate="{StaticResource RecentSearchRow}"
                                             Spacing="0" />
                    </Border>
                </Grid>

                <!-- Everything below the search bar lives in its own container so the scrim for
                     the recent searches can cover all of it in one child, with no RowSpan to
                     mis-measure and no offset to compute. A tap anywhere in here closes the
                     list; the list itself lives in the bar's own grid above, so the two can
                     never fight over the same touch. -->
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRecentSearchesDismissed" />
                    </Grid.GestureRecognizers>
                <!-- Filter chips (visible during search results) -->
                <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                            IsVisible="{Binding DirectQueryInputVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                            Padding="16,0,16,8" Margin="0,0,0,4">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="All" FontFamily="InterSemiBold" FontSize="12"
                                BackgroundColor="Transparent" TextColor="{StaticResource BrushText}"
                                BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="16"
                                Padding="12,6" HeightRequest="32"
                                Command="{Binding SubmitFilterCommand}" CommandParameter="" />
                        <Button Text="{Binding Filter1Label}" FontFamily="InterSemiBold" FontSize="12"
                                IsVisible="{Binding Filter1Label, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}"
                                BackgroundColor="Transparent" TextColor="{StaticResource BrushText}"
                                BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="16"
                                Padding="12,6" HeightRequest="32"
                                Command="{Binding SubmitFilterCommand}" CommandParameter="{Binding Filter1Label}" />
                        <Button Text="{Binding Filter2Label}" FontFamily="InterSemiBold" FontSize="12"
                                IsVisible="{Binding Filter2Label, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}"
                                BackgroundColor="Transparent" TextColor="{StaticResource BrushText}"
                                BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="16"
                                Padding="12,6" HeightRequest="32"
                                Command="{Binding SubmitFilterCommand}" CommandParameter="{Binding Filter2Label}" />
                        <Button Text="{Binding Filter3Label}" FontFamily="InterSemiBold" FontSize="12"
                                IsVisible="{Binding Filter3Label, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}"
                                BackgroundColor="Transparent" TextColor="{StaticResource BrushText}"
                                BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="16"
                                Padding="12,6" HeightRequest="32"
                                Command="{Binding SubmitFilterCommand}" CommandParameter="{Binding Filter3Label}" />
                        <Button Text="{Binding Filter4Label}" FontFamily="InterSemiBold" FontSize="12"
                                IsVisible="{Binding Filter4Label, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}"
                                BackgroundColor="Transparent" TextColor="{StaticResource BrushText}"
                                BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="16"
                                Padding="12,6" HeightRequest="32"
                                Command="{Binding SubmitFilterCommand}" CommandParameter="{Binding Filter4Label}" />
                        <Button Text="{Binding Filter5Label}" FontFamily="InterSemiBold" FontSize="12"
                                IsVisible="{Binding Filter5Label, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}"
                                BackgroundColor="Transparent" TextColor="{StaticResource BrushText}"
                                BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="16"
                                Padding="12,6" HeightRequest="32"
                                Command="{Binding SubmitFilterCommand}" CommandParameter="{Binding Filter5Label}" />
                    </HorizontalStackLayout>
                </ScrollView>

                <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="16,4,16,4"
                      IsVisible="{Binding DirectQueryInputVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <Button Grid.Column="0" Text="Anime" FontFamily="InterSemiBold" FontSize="14"
                            TextColor="{Binding AnimeSearch, Converter={StaticResource BoolTab}, ConverterParameter=true}"
                            BackgroundColor="Transparent"
                            Command="{Binding ToggleSearchModeCommand}" CommandParameter="true" />
                    <Button Grid.Column="1" Text="Manga" FontFamily="InterSemiBold" FontSize="14"
                            TextColor="{Binding AnimeSearch, Converter={StaticResource BoolTab}, ConverterParameter=false}"
                            BackgroundColor="Transparent"
                            Command="{Binding ToggleSearchModeCommand}" CommandParameter="false" />
                </Grid>

                <!-- Genre/Studio Selection Grid -->
                <Grid Grid.Row="2"
                      IsVisible="{Binding GenreSelectionGridVisibility}">
                    <Grid RowDefinitions="Auto,*" Padding="16,8" RowSpacing="8">
                        <Label Text="{Binding ActiveCatalogueTitle}"
                               FontFamily="InterBold" FontSize="20" TextColor="{StaticResource BrushText}" />
                        <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableSelectionChoices}"
                                        SelectionMode="Single" SelectionChanged="OnGenreStudioSelected">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource EmSheet}"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Padding="16,12">
                                        <Label Text="{Binding .}" FontFamily="InterBold" FontSize="16"
                                               TextColor="{StaticResource BrushText}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>

                <!-- Search Results / Catalogue Results -->
                <Grid Grid.Row="3"
                      IsVisible="{Binding GenreSelectionGridVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="0">
                        <Grid Grid.Row="0" IsVisible="{Binding HasMoreCatalogue, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                              HeightRequest="40" BackgroundColor="{StaticResource EmSheet}">
                            <ActivityIndicator IsRunning="{Binding IsLoadingMoreCatalogue}"
                                               Color="{StaticResource EmAccent}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Text="Loading more..."
                                   FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding IsLoadingMoreCatalogue}" />
                        </Grid>

                        <controls:AnimePosterGrid x:Name="ResultsGrid"
                                            Grid.Row="1"
                                            ItemsSource="{Binding CurrentSearchItems}">
                            <controls:AnimePosterGrid.CellTemplate>
                                <!-- Same component and same metrics as the anime grid; the search
                                     results only differ in which values the card shows. -->
                                <DataTemplate>
                                    <controls:AnimePosterCard
                                        HeightRequest="{Binding Source={x:Reference ResultsGrid}, Path=CellHeight}"
                                        PosterUrl="{Binding ImgUrl}"
                                        Title="{Binding Title}"
                                        TitleOverlay="True"
                                        TypeTag="{Binding TypeTag}"
                                        ScoreTag="{Binding CardScore}"
                                        BadgeVisible="True"
                                        BadgeAccent="{Binding CardBadgeAccent}"
                                        BadgeMain="{Binding CardBadgeMain}">
                                        <controls:AnimePosterCard.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnResultTapped"
                                                                  CommandParameter="{Binding .}" />
                                        </controls:AnimePosterCard.GestureRecognizers>
                                    </controls:AnimePosterCard>
                                </DataTemplate>
                            </controls:AnimePosterGrid.CellTemplate>
                        </controls:AnimePosterGrid>

                        <!-- Empty state: the component has no CollectionView.EmptyView, so it is an
                             overlay here instead. -->
                        <VerticalStackLayout Grid.Row="1" Spacing="12"
                                             VerticalOptions="Center" HorizontalOptions="Center"
                                             IsVisible="{Binding EmptyNoticeVisibility}">
                            <Label Text="No results found" FontFamily="InterBold" FontSize="16"
                                   TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
                            <Label Text="Try a different search term" FontFamily="Inter" FontSize="13"
                                   TextColor="#80FFFFFF" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    </Grid>
                </Grid>

<!-- No scrim element: it kept stealing the taps meant for the list rows, because a
                     transparent overlay that overlaps the bar is always above it on Android.
                     The container above carries the dismissal instead. -->
                </Grid>
            </Grid>

        <!-- ============ Characters tab (1) ============ -->
        <Grid Grid.Row="1" Grid.RowSpan="2"
              IsVisible="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource IntEq}, ConverterParameter=1}">
            <Grid RowDefinitions="Auto,*" Padding="16,8">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="CharSearchEntry" Placeholder="Search characters..."
                           Text="{Binding CharQuery, Source={x:Reference Page}, Mode=TwoWay}"
                           FontFamily="Inter" FontSize="14"
                           BackgroundColor="{StaticResource EmSheet}"
                           TextColor="{StaticResource BrushText}"
                           PlaceholderColor="#80FFFFFF"
                           ReturnType="Search"
                           Completed="OnCharacterSearchCompleted" />
                    <Button Grid.Column="1" Text="Go"
                            Clicked="OnCharacterSearchClicked"
                            FontFamily="InterBold" FontSize="16"
                            BackgroundColor="#0066FF" TextColor="White"
                            CornerRadius="8" WidthRequest="48" HeightRequest="48" Padding="0" />
                </Grid>
                <CollectionView Grid.Row="1" ItemsSource="{Binding CharacterResults, Source={x:Reference Page}}"
                                SelectionMode="Single" SelectionChanged="OnCharacterSelected">
                    <CollectionView.EmptyView>
                        <Label Text="Type a character name to search"
                               FontFamily="Inter" FontSize="13" TextColor="#80FFFFFF"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="10">
                                <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" WidthRequest="52" HeightRequest="76"
                                            StrokeShape="RoundRectangle 6"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                                        <Image Source="{Binding Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                                               Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Data.Name}" FontFamily="InterBold" FontSize="14"
                                               TextColor="{StaticResource BrushText}" MaxLines="2"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Data.Notes}" FontFamily="Inter" FontSize="11"
                                               TextColor="#80FFFFFF" MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- ============ Genres tab (2) â€” reuses Main tab's catalogue by setting mode=Genres ============ -->
        <Grid Grid.Row="1" Grid.RowSpan="2"
              IsVisible="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource IntEq}, ConverterParameter=2}">
            <Grid RowDefinitions="Auto,*" Padding="16,8">
                <Label Grid.Row="0" Text="Pick a genre"
                       FontFamily="InterBold" FontSize="20" TextColor="{StaticResource BrushText}" />
                <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableSelectionChoices}"
                                SelectionMode="Single" SelectionChanged="OnGenreStudioSelected">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="16,12">
                                <Label Text="{Binding .}" FontFamily="InterBold" FontSize="16"
                                       TextColor="{StaticResource BrushText}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- ============ Studios tab (3) ============ -->
        <Grid Grid.Row="1" Grid.RowSpan="2"
              IsVisible="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource IntEq}, ConverterParameter=3}">
            <Grid RowDefinitions="Auto,*" Padding="16,8">
                <Label Grid.Row="0" Text="Pick a studio"
                       FontFamily="InterBold" FontSize="20" TextColor="{StaticResource BrushText}" />
                <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableSelectionChoices}"
                                SelectionMode="Single" SelectionChanged="OnGenreStudioSelected">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="16,12">
                                <Label Text="{Binding .}" FontFamily="InterBold" FontSize="16"
                                       TextColor="{StaticResource BrushText}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- Loading overlay -->
        <Grid IsVisible="{Binding Loading}" BackgroundColor="#80000000"
              Grid.RowSpan="3" VerticalOptions="Fill" HorizontalOptions="Fill" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>
    </Grid>
</ContentPage>
