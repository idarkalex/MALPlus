<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             x:Class="MALPlus.Views.SearchPage"
             x:Name="Page"
             BackgroundColor="{DynamicResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:IntEqualityConverter x:Key="IntEq" />
        <converters:BoolTabColorConverter x:Key="BoolTab" />
        <converters:TabColorConverter x:Key="TabColorConverter" />

        <!-- One row of the recent searches dropdown. A Border with a tap rather than a
             CollectionView cell, because the results grid below is already a CollectionView
             and two of them overlapping fight over the touch on Android. -->
        <DataTemplate x:Key="RecentSearchRow">
            <Border BackgroundColor="{DynamicResource EmSheet}" Padding="16,12">
                <!-- The background has to be a real colour: with a transparent one the row is
                     not hit tested, the tap falls through to whatever is underneath and the
                     list only ever closes. Same colour as the panel, so it stays invisible. -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRecentSearchRowTapped"
                                          CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="Search" FontSize="12" VerticalOptions="Center" />
                        <Label Text="{Binding .}" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
<!-- Tapping the X must not run the search, so it carries its own recognizer
                         and stops the row from seeing the touch. A drawable again rather than a
                         character: as text the cross came out as mojibake, and a vector cannot
                         depend on the font carrying the glyph. -->
<Image Grid.Column="1" Source="icon_close.png" WidthRequest="20" HeightRequest="20"
                            VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRecentSearchRemoveTapped"
                                                  CommandParameter="{Binding .}" />
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A filter chip, styled like the blue tags the poster cards use so the two read as the same
             control. Marked means the accent fill, unmarked means no fill at all.
             The unmarked background is the page colour rather than a transparent one on purpose: a
             Border with a transparent background is not hit tested on Android, so the chip would
             swallow nothing and the bar would be dead to the touch. Painting it the page colour
             looks identical to no background and still takes the tap. -->
        <DataTemplate x:Key="TypeFilterChip">
            <Border Margin="0,0,8,0" Padding="14,7" StrokeThickness="0"
                    StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource EmBackground}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTypeFilterTapped" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding .Selected}" Value="True">
                        <Setter Property="BackgroundColor" Value="#0066FF" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding .Label}" FontFamily="InterBold" FontSize="11">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding .Selected}" Value="True">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding .Selected}" Value="False">
                            <Setter Property="TextColor" Value="{StaticResource BrushText}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </DataTemplate>

        <!-- Templates for All (Everywhere) Tab -->
        <DataTemplate x:Key="CategoryHeaderTemplate">
            <HorizontalStackLayout Spacing="8" Margin="4,16,4,6" VerticalOptions="Center">
                <BoxView WidthRequest="3" HeightRequest="14" Color="{StaticResource EmAccent}" VerticalOptions="Center" />
                <Label Text="{Binding Name}" FontFamily="InterBold" FontSize="13" CharacterSpacing="1.2"
                       TextColor="{StaticResource BrushText}" TextTransform="Uppercase" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="EverywhereItemTemplate">
            <Border BackgroundColor="{DynamicResource EmSheet}"
                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 10" Padding="10" Margin="0,3">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEverywhereItemTapped" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Border Grid.Column="0" WidthRequest="48" HeightRequest="68"
                            StrokeShape="RoundRectangle 6" StrokeThickness="0" BackgroundColor="#1AFFFFFF">
                        <Image Source="{Binding Item.ImageUrl, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding Item.Name}" FontFamily="InterBold" FontSize="14"
                               TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Border BackgroundColor="#200066FF" StrokeThickness="0" Padding="6,2"
                                    IsVisible="{Binding Item.Payload.MediaType, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Item.Payload.MediaType}" FontFamily="InterBold" FontSize="10"
                                       TextColor="#60A5FA" TextTransform="Uppercase" />
                            </Border>
                            <Label Text="{Binding Item.Type}" FontFamily="Inter" FontSize="11"
                                   TextColor="{DynamicResource TabChipInactiveText}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Border Grid.Column="2" BackgroundColor="#20F59E0B" StrokeThickness="0" Padding="6,3" VerticalOptions="Center"
                            IsVisible="{Binding Item.Payload.Score, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                            <Label Text="★" TextColor="#F59E0B" FontSize="11" VerticalOptions="Center" />
                            <Label Text="{Binding Item.Payload.Score}" TextColor="#F59E0B" FontFamily="InterBold" FontSize="11" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SeparatorTemplate">
            <BoxView HeightRequest="1" Color="{DynamicResource EmBorder}" Margin="4,10" />
        </DataTemplate>

        <converters:SearchEverywhereTemplateSelector x:Key="EverywhereSelector"
            CategoryTemplate="{StaticResource CategoryHeaderTemplate}"
            ItemTemplate="{StaticResource EverywhereItemTemplate}"
            SeparatorTemplate="{StaticResource SeparatorTemplate}" />
    </ContentPage.Resources>

    <!-- Two rows only. The tab strip sits above and every tab fills what is left. -->
    <Grid RowDefinitions="Auto,*">
        <!-- Top tab strip: All / Anime / Manga / Characters / Genres / Studios -->
        <ScrollView x:Name="TabStripScroll" Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    Padding="12,12,12,0" BackgroundColor="{DynamicResource EmBackground}">
            <HorizontalStackLayout Spacing="8">
                <Border x:Name="SearchBackButton" WidthRequest="34" HeightRequest="34"
                        StrokeShape="RoundRectangle 17" BackgroundColor="#14FFFFFF" Padding="0"
                        VerticalOptions="Center" IsVisible="False">
                    <Grid>
                        <Image Source="icon_chevron_left.png" WidthRequest="16" HeightRequest="16"
                               HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                        <Button Clicked="OnSearchBackClicked" BackgroundColor="Transparent" BorderWidth="0" Padding="0" />
                    </Grid>
                </Border>
                <Button x:Name="TabAll" Text="All" Clicked="OnSearchButtonClicked" CommandParameter="0"
                        Style="{StaticResource TabChipActiveButtonStyle}" />
                <Button x:Name="TabAnime" Text="Anime" Clicked="OnSearchButtonClicked" CommandParameter="1"
                        Style="{StaticResource TabChipButtonStyle}" />
                <Button x:Name="TabManga" Text="Manga" Clicked="OnSearchButtonClicked" CommandParameter="2"
                        Style="{StaticResource TabChipButtonStyle}" />
                <Button x:Name="TabCharacters" Text="Characters" Clicked="OnSearchButtonClicked" CommandParameter="3"
                        Style="{StaticResource TabChipButtonStyle}" />
                <Button x:Name="TabGenres" Text="Genres" Clicked="OnSearchButtonClicked" CommandParameter="4"
                        Style="{StaticResource TabChipButtonStyle}" />
                <Button x:Name="TabStudios" Text="Studios" Clicked="OnSearchButtonClicked" CommandParameter="5"
                        Style="{StaticResource TabChipButtonStyle}" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- ============ ALL TAB (0) ============ -->
        <Grid Grid.Row="1"
              IsVisible="{Binding IsAllTabVisible, Source={x:Reference Page}}">
            <Grid RowDefinitions="Auto,*" Padding="16,8">
                <!-- Search input on All tab -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,8">
                    <Entry x:Name="AllSearchEntry" Placeholder="Search everything on MAL..."
                           Text="{Binding AllQuery, Source={x:Reference Page}, Mode=TwoWay}"
                           FontFamily="Inter" FontSize="14"
                           HeightRequest="48"
                           BackgroundColor="{DynamicResource EmSheet}"
                           TextColor="{StaticResource BrushText}"
                           PlaceholderColor="#80FFFFFF"
                           ReturnType="Search"
                           Completed="OnAllSearchCompleted" />
                    <ImageButton Grid.Column="1" Source="icon_close.png" Clicked="OnClearAllQueryClicked"
                                 BackgroundColor="{DynamicResource EmSheet}"
                                 WidthRequest="48" HeightRequest="48" Padding="14"
                                 IsVisible="{Binding AllQuery, Source={x:Reference Page}, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}" />
                    <ImageButton Grid.Column="2" Source="search.png"
                                 Clicked="OnAllSearchClicked"
                                 BackgroundColor="#0066FF"
                                 CornerRadius="8" WidthRequest="48" HeightRequest="48" Padding="12" />
                </Grid>

                <!-- Results list with categorized sections and dividers -->
                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding EverywhereVm.SearchResults, Source={x:Reference Page}}"
                                ItemTemplate="{StaticResource EverywhereSelector}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,40,0,0">
                            <Label Text="Search everything on MyAnimeList"
                                   FontFamily="InterBold" FontSize="15"
                                   TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
                            <Label Text="Find anime, manga, characters and users"
                                   FontFamily="Inter" FontSize="13"
                                   TextColor="{DynamicResource TabChipInactiveText}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Loading overlay for All tab -->
                <Grid Grid.Row="1" IsVisible="{Binding EverywhereVm.Loading, Source={x:Reference Page}}"
                      BackgroundColor="#80000000" VerticalOptions="Fill" HorizontalOptions="Fill" ZIndex="99">
                    <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                                       WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ Main tab (Anime: 1, Manga: 2) ============ -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              IsVisible="{Binding IsMainTabVisible, Source={x:Reference Page}}">

            <!-- Search bar, then the format chips directly under it.
                 AdjustNothing on the activity keeps the keyboard from resizing the window, so
                 putting them here means they stay put while typing instead of sliding away. -->
            <VerticalStackLayout Grid.Row="0" Spacing="8" Padding="16,12,16,10"
                                 IsVisible="{Binding DirectQueryInputVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Entry x:Name="SearchEntry" Placeholder="Search anime, manga..."
                           Text="{Binding InternalQuery, Mode=TwoWay}"
                           FontFamily="Inter" FontSize="14"
                           HeightRequest="48"
                           BackgroundColor="{DynamicResource EmSheet}"
                           TextColor="{StaticResource BrushText}"
                           PlaceholderColor="#80FFFFFF"
                           ReturnType="Search"
                           Completed="OnSearchCompleted" />
<!-- Clear. A real Button beside the Entry and never a recognizer on the Entry,
                         which would consume the touch and stop the keyboard opening. The mark is a
                         drawable rather than a character: as text it came out as mojibake twice,
                         and a vector cannot depend on the font having the glyph. -->
                    <ImageButton Grid.Column="1" Source="icon_close.png" Clicked="OnClearQueryClicked"
                                 BackgroundColor="{DynamicResource EmSheet}"
                                 WidthRequest="48" HeightRequest="48" Padding="14"
                                 IsVisible="{Binding InternalQuery, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}" />
                    <ImageButton Grid.Column="2" Source="search.png"
                                 Command="{Binding SearchCommand}"
                                 BackgroundColor="#0066FF"
                                 CornerRadius="8" WidthRequest="48" HeightRequest="48" Padding="12" />
                </Grid>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding TypeFilters}"
                                             BindableLayout.ItemTemplate="{StaticResource TypeFilterChip}"
                                             Spacing="0" />
                </ScrollView>
            </VerticalStackLayout>

            <!-- Content: either the genre/studio picker or the results. -->
            <Grid Grid.Row="1">
                <!-- Genre/Studio Selection Grid -->
                <Grid IsVisible="{Binding GenreSelectionGridVisibility}">
                    <Grid RowDefinitions="Auto,*" Padding="16,8" RowSpacing="8">
                        <Label Text="{Binding ActiveCatalogueTitle}"
                               FontFamily="InterBold" FontSize="20" TextColor="{StaticResource BrushText}" />
                        <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableSelectionChoices}"
                                        SelectionMode="Single" SelectionChanged="OnGenreStudioSelected">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{DynamicResource EmSheet}"
                                            Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Padding="16,12">
                                        <!-- Studio logo above the name rather than beside it. A two column grid on a phone leaves
                                             about 80dp next to a 64dp icon, which broke the names
                                             into "ABC Ani mation"; stacked, both get the full cell
                                             width and the logos read at their natural shape. -->
                                        <VerticalStackLayout Spacing="8">
                                            <Image Aspect="AspectFit" HeightRequest="56"
                                                   IsVisible="{Binding IconUrl, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}"
                                                   Source="{Binding IconUrl, Converter={StaticResource ImageConverter}}" />
                                            <Label Text="{Binding Name}" FontFamily="InterBold" FontSize="13"
                                                   TextColor="{StaticResource BrushText}"
                                                   MaxLines="2" LineBreakMode="TailTruncation"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>

                <!-- Search Results / Catalogue Results -->
                <Grid IsVisible="{Binding GenreSelectionGridVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="0">
                        <Grid Grid.Row="0" IsVisible="{Binding HasMoreCatalogue, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                              HeightRequest="40" BackgroundColor="{DynamicResource EmSheet}">
                            <ActivityIndicator IsRunning="{Binding IsLoadingMoreCatalogue}"
                                               Color="{StaticResource EmAccent}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Text="Loading more..."
                                   FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding IsLoadingMoreCatalogue}" />
                        </Grid>

                        <controls:AnimePosterGrid x:Name="ResultsGrid"
                                            Grid.Row="1"
                                            ItemsSource="{Binding CurrentSearchItems}">
                            <controls:AnimePosterGrid.CellTemplate>
                                <!-- Same component and same metrics as the anime grid; the search
                                     results only differ in which values the card shows. -->
                                <DataTemplate>
                                    <controls:AnimePosterCard
                                        WidthRequest="{Binding CellWidth, Source={x:Reference ResultsGrid}}"
                                        HeightRequest="{Binding CellHeight, Source={x:Reference ResultsGrid}}"
                                        PosterUrl="{Binding ImgUrl}"
                                        Title="{Binding Title}"
                                        TitleOverlay="True"
                                        TypeTag="{Binding TypeTag}"
                                        ScoreTag="{Binding CardScore}"
                                        BadgeVisible="True"
                                        BadgeAccent="{Binding CardBadgeAccent}"
                                        BadgeAccentColor="{Binding CardBadgeAccentColor}"
                                        BadgeMain="{Binding CardBadgeMain}">
                                        <controls:AnimePosterCard.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnResultTapped"
                                                                  CommandParameter="{Binding .}" />
                                        </controls:AnimePosterCard.GestureRecognizers>
                                    </controls:AnimePosterCard>
                                </DataTemplate>
                            </controls:AnimePosterGrid.CellTemplate>
                        </controls:AnimePosterGrid>

                        <!-- Empty state: the component has no CollectionView.EmptyView, so it is an
                             overlay here instead. -->
                        <VerticalStackLayout Grid.Row="1" Spacing="12"
                                             VerticalOptions="Center" HorizontalOptions="Center"
                                             IsVisible="{Binding EmptyNoticeVisibility}">
                            <Label Text="No results found" FontFamily="InterBold" FontSize="16"
                                   TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
                            <Label Text="Try a different search term" FontFamily="Inter" FontSize="13"
                                   TextColor="#80FFFFFF" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

                <!-- Recent searches. It hangs off the content row so it cannot push the page, and it is pulled
                     up by the height of the chip row so it reads as hanging off the SEARCH BAR
                     rather than off the chips, which is where the eye expects it. Declared last so
                     it paints above both the chips and the results.

                     There is deliberately no scrim. A transparent overlay across the grid is always
                     above it on Android, so it swallowed the scroll and every tap on a row, which
                     is what made the list break scrolling. It closes on the gestures that mean the
                     user is done with it: scrolling, picking a result, switching tab, tapping a
                     chip, or back. -->
                <Border VerticalOptions="Start" Margin="16,-52,16,8"
                        IsVisible="False" x:Name="RecentSearchesDrop"
                        BackgroundColor="{DynamicResource EmSheet}"
                        Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="4">
                    <!-- Rows, not a CollectionView: the results below already are one and two
                         overlapping ones fight over the touch on Android. -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentSearches}"
                                         BindableLayout.ItemTemplate="{StaticResource RecentSearchRow}"
                                         Spacing="0" />
                </Border>
            </Grid>
        </Grid>

        <!-- ============ Characters tab (3) ============ -->
        <Grid Grid.Row="1"
              IsVisible="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource IntEq}, ConverterParameter=3}">
            <Grid RowDefinitions="Auto,*" Padding="16,8">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="CharSearchEntry" Placeholder="Search characters..."
                           Text="{Binding CharQuery, Source={x:Reference Page}, Mode=TwoWay}"
                           FontFamily="Inter" FontSize="14"
                           BackgroundColor="{DynamicResource EmSheet}"
                           TextColor="{StaticResource BrushText}"
                           PlaceholderColor="#80FFFFFF"
                           ReturnType="Search"
                           Completed="OnCharacterSearchCompleted" />
                    <Button Grid.Column="1" Text="Go"
                            Clicked="OnCharacterSearchClicked"
                            FontFamily="InterBold" FontSize="16"
                            BackgroundColor="#0066FF" TextColor="White"
                            CornerRadius="8" WidthRequest="48" HeightRequest="48" Padding="0" />
                </Grid>
                <CollectionView Grid.Row="1" ItemsSource="{Binding CharacterResults, Source={x:Reference Page}}"
                                ItemSizingStrategy="MeasureFirstItem"
                                SelectionMode="Single" SelectionChanged="OnCharacterSelected">
                    <CollectionView.EmptyView>
                        <Label Text="Type a character name to search"
                               FontFamily="Inter" FontSize="13" TextColor="#80FFFFFF"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" BackgroundColor="{DynamicResource EmSheet}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="10">
                                <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" WidthRequest="52" HeightRequest="76"
                                            StrokeShape="RoundRectangle 6"
                                            Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1">
                                        <Image Source="{Binding Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                                               Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Data.Name}" FontFamily="InterBold" FontSize="14"
                                               TextColor="{StaticResource BrushText}" MaxLines="2"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Data.Notes}" FontFamily="Inter" FontSize="11"
                                               TextColor="#80FFFFFF" MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- ============ Genres tab (3) ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â reuses Main tab's catalogue by setting mode=Genres ============ -->
        <Grid Grid.Row="1"
              IsVisible="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource IntEq}, ConverterParameter=4}">
            <!-- Two rows but the list spans both. With the title gone there is nothing in row0, and
                 leaving it as a star row handed it half the height and pushed the grid down. -->
            <Grid RowDefinitions="*,*" Padding="16,8">
                <CollectionView x:Name="GenreList" Grid.Row="0" Grid.RowSpan="2" ItemsSource="{Binding AvailableSelectionChoices}"
                                SelectionMode="Single" SelectionChanged="OnGenreStudioSelected">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{DynamicResource EmSheet}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="16,12">
                                <Label Text="{Binding Name}" FontFamily="InterBold" FontSize="16"
                                       TextColor="{StaticResource BrushText}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- ============ Studios tab (5) ============ -->
        <Grid Grid.Row="1"
              IsVisible="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource IntEq}, ConverterParameter=5}">
            <!-- Two rows but the list spans both. With the title gone there is nothing in row0, and
                 leaving it as a star row handed it half the height and pushed the grid down. -->
            <Grid RowDefinitions="*,*" Padding="16,8">
                <CollectionView x:Name="StudioList" Grid.Row="0" Grid.RowSpan="2" ItemsSource="{Binding AvailableSelectionChoices}"
                                SelectionMode="Single" SelectionChanged="OnGenreStudioSelected">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{DynamicResource EmSheet}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12,10">
<VerticalStackLayout Spacing="8">
                                    <Image Aspect="AspectFit" HeightRequest="56"
                                           IsVisible="{Binding IconUrl, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}"
                                           Source="{Binding IconUrl, Converter={StaticResource ImageConverter}}" />
                                    <Label Text="{Binding Name}" FontFamily="InterBold" FontSize="13"
                                           TextColor="{StaticResource BrushText}"
                                           MaxLines="2" LineBreakMode="TailTruncation"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- Loading overlay -->
        <Grid IsVisible="{Binding Loading}" BackgroundColor="#80000000"
              Grid.Row="1" VerticalOptions="Fill" HorizontalOptions="Fill" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>
    </Grid>
</ContentPage>
