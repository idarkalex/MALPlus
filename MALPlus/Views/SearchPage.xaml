<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             x:Class="MALPlus.Views.SearchPage"
             x:Name="Page"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:IntEqualityConverter x:Key="IntEq" />
        <converters:BoolTabColorConverter x:Key="BoolTab" />
        <converters:TabColorConverter x:Key="TabColorConverter" />

        <!-- One row of the recent searches dropdown. A Border with a tap rather than a
             CollectionView cell, because the results grid below is already a CollectionView
             and two of them overlapping fight over the touch on Android. -->
        <DataTemplate x:Key="RecentSearchRow">
            <Border BackgroundColor="{StaticResource EmSheet}" Padding="16,12">
                <!-- The background has to be a real colour: with a transparent one the row is
                     not hit tested, the tap falls through to whatever is underneath and the
                     list only ever closes. Same colour as the panel, so it stays invisible. -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRecentSearchRowTapped"
                                          CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="Search" FontSize="12" VerticalOptions="Center" />
                        <Label Text="{Binding .}" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <!-- Tapping the X must not run the search, so it carries its own recognizer
                         and stops the row from seeing the touch. -->
                    <Label Grid.Column="1" Text="âœ•" FontSize="15" VerticalOptions="Center"
                           TextColor="#80FFFFFF"
                           HorizontalOptions="Center" VerticalTextAlignment="Center"
                           WidthRequest="32" HeightRequest="32">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRecentSearchRemoveTapped"
                                                  CommandParameter="{Binding .}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A filter chip, styled like the blue tags the poster cards use so the two read as the same
             control. Marked means the accent fill, unmarked means no fill at all.
             The unmarked background is the page colour rather than a transparent one on purpose: a
             Border with a transparent background is not hit tested on Android, so the chip would
             swallow nothing and the bar would be dead to the touch. Painting it the page colour
             looks identical to no background and still takes the tap. -->
        <DataTemplate x:Key="TypeFilterChip">
            <Border Margin="0,0,8,0" Padding="14,7" StrokeThickness="0"
                    StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource EmBackground}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTypeFilterTapped" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding .Selected}" Value="True">
                        <Setter Property="BackgroundColor" Value="#0066FF" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding .Label}" FontFamily="InterBold" FontSize="11">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding .Selected}" Value="True">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding .Selected}" Value="False">
                            <Setter Property="TextColor" Value="{StaticResource BrushText}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- Two rows only. The tab strip sits above and every tab fills what is left, which is what
         lets the Main tab put a filter bar at the bottom without the layout having to reserve
         space for it up here. -->
    <Grid RowDefinitions="Auto,*">
        <!-- Top tab strip: Main / Characters / Genres / Studios -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    Padding="12,12,12,0" BackgroundColor="{StaticResource EmBackground}">
            <HorizontalStackLayout Spacing="6">
                <!-- Anime and Manga are entries of this same row, not a separate one below it. Both
                     host the search UI, so the strip is the only place the mode is chosen and there
                     is nothing else competing for the space under the tab strip. -->
                <Label Text="Anime" FontFamily="InterSemiBold" FontSize="13"
                       Padding="12,8" TextColor="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource TabColorConverter}, ConverterParameter=0}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTabTapped" CommandParameter="0" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Manga" FontFamily="InterSemiBold" FontSize="13"
                       Padding="12,8" TextColor="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource TabColorConverter}, ConverterParameter=1}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTabTapped" CommandParameter="1" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Characters" FontFamily="InterSemiBold" FontSize="13"
                       Padding="12,8" TextColor="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource TabColorConverter}, ConverterParameter=2}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTabTapped" CommandParameter="2" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Genres" FontFamily="InterSemiBold" FontSize="13"
                       Padding="12,8" TextColor="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource TabColorConverter}, ConverterParameter=3}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTabTapped" CommandParameter="3" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Studios" FontFamily="InterSemiBold" FontSize="13"
                       Padding="12,8" TextColor="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource TabColorConverter}, ConverterParameter=4}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTabTapped" CommandParameter="4" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- ============ Main tab (0) ============ -->
        <!-- Header, content, filter bar. The content row is the star row, and the recent searches
             dropdown lives inside it as a Start-aligned overlay: a star row cannot be grown by a
             child, so nothing shifts, which is what the old version did when both lived in an
             Auto row and pushed the whole page down. -->
<Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              IsVisible="{Binding IsMainTabVisible, Source={x:Reference Page}}">

            <!-- Search bar, then the format chips directly under it.
                 AdjustNothing on the activity keeps the keyboard from resizing the window, so
                 putting them here means they stay put while typing instead of sliding away. -->
            <VerticalStackLayout Grid.Row="0" Spacing="8" Padding="16,12,16,10"
                                 IsVisible="{Binding DirectQueryInputVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Entry x:Name="SearchEntry" Placeholder="Search anime, manga..."
                           Text="{Binding InternalQuery, Mode=TwoWay}"
                           FontFamily="Inter" FontSize="14"
                           HeightRequest="48"
                           BackgroundColor="{StaticResource EmSheet}"
                           TextColor="{StaticResource BrushText}"
                           PlaceholderColor="#80FFFFFF"
                           ReturnType="Search"
                           Completed="OnSearchCompleted" />
                    <!-- Clear. A real Button beside the Entry and never a recognizer on the Entry
                         itself: a TapGestureRecognizer on an Entry consumes the touch, the field
                         never takes focus and the keyboard never opens.
                         No FontFamily on purpose: InterBold has no glyph for the multiplication X
                         and it came out as mojibake, while the default face renders the same
                         character fine on the recent-search rows. -->
                    <Button Grid.Column="1" Text="✕" Clicked="OnClearQueryClicked"
                            FontSize="16" TextColor="#B3FFFFFF"
                            BackgroundColor="{StaticResource EmSheet}"
                            CornerRadius="8" WidthRequest="48" HeightRequest="48" Padding="0"
                            IsVisible="{Binding InternalQuery, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}" />
                    <ImageButton Grid.Column="2" Source="search.svg"
                                 Command="{Binding SearchCommand}"
                                 BackgroundColor="#0066FF"
                                 CornerRadius="8" WidthRequest="48" HeightRequest="48" Padding="12" />
                </Grid>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding TypeFilters}"
                                             BindableLayout.ItemTemplate="{StaticResource TypeFilterChip}"
                                             Spacing="0" />
                </ScrollView>
            </VerticalStackLayout>

            <!-- Content: either the genre/studio picker or the results. -->
            <Grid Grid.Row="1">
                <!-- Genre/Studio Selection Grid -->
                <Grid IsVisible="{Binding GenreSelectionGridVisibility}">
                    <Grid RowDefinitions="Auto,*" Padding="16,8" RowSpacing="8">
                        <Label Text="{Binding ActiveCatalogueTitle}"
                               FontFamily="InterBold" FontSize="20" TextColor="{StaticResource BrushText}" />
                        <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableSelectionChoices}"
                                        SelectionMode="Single" SelectionChanged="OnGenreStudioSelected">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource EmSheet}"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Padding="16,12">
                                        <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
                                            <!-- Studio logo, loaded on demand. MAL does not return
                                                 these; Tenrai does, at /v1/producers/{id}, and the
                                                 enum already carries every studio's MAL id. -->
                                            <Image Grid.Column="0" Aspect="AspectFit"
                                                   IsVisible="{Binding IconUrl, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}"
                                                   Source="{Binding IconUrl, Converter={StaticResource ImageConverter}}" />
                                            <Label Grid.Column="1" Text="{Binding Name}" FontFamily="InterBold" FontSize="16"
                                                   TextColor="{StaticResource BrushText}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>

                <!-- Search Results / Catalogue Results -->
                <Grid IsVisible="{Binding GenreSelectionGridVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="0">
                        <Grid Grid.Row="0" IsVisible="{Binding HasMoreCatalogue, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                              HeightRequest="40" BackgroundColor="{StaticResource EmSheet}">
                            <ActivityIndicator IsRunning="{Binding IsLoadingMoreCatalogue}"
                                               Color="{StaticResource EmAccent}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Text="Loading more..."
                                   FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding IsLoadingMoreCatalogue}" />
                        </Grid>

                        <controls:AnimePosterGrid x:Name="ResultsGrid"
                                            Grid.Row="1"
                                            ItemsSource="{Binding CurrentSearchItems}">
                            <controls:AnimePosterGrid.CellTemplate>
                                <!-- Same component and same metrics as the anime grid; the search
                                     results only differ in which values the card shows. -->
                                <DataTemplate>
                                    <controls:AnimePosterCard
                                        HeightRequest="{Binding Source={x:Reference ResultsGrid}, Path=CellHeight}"
                                        PosterUrl="{Binding ImgUrl}"
                                        Title="{Binding Title}"
                                        TitleOverlay="True"
                                        TypeTag="{Binding TypeTag}"
                                        ScoreTag="{Binding CardScore}"
                                        BadgeVisible="True"
                                        BadgeAccent="{Binding CardBadgeAccent}"
                                        BadgeMain="{Binding CardBadgeMain}">
                                        <controls:AnimePosterCard.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnResultTapped"
                                                                  CommandParameter="{Binding .}" />
                                        </controls:AnimePosterCard.GestureRecognizers>
                                    </controls:AnimePosterCard>
                                </DataTemplate>
                            </controls:AnimePosterGrid.CellTemplate>
                        </controls:AnimePosterGrid>

                        <!-- Empty state: the component has no CollectionView.EmptyView, so it is an
                             overlay here instead. -->
                        <VerticalStackLayout Grid.Row="1" Spacing="12"
                                             VerticalOptions="Center" HorizontalOptions="Center"
                                             IsVisible="{Binding EmptyNoticeVisibility}">
                            <Label Text="No results found" FontFamily="InterBold" FontSize="16"
                                   TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
                            <Label Text="Try a different search term" FontFamily="Inter" FontSize="13"
                                   TextColor="#80FFFFFF" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

                <!-- Recent searches. It lives in the content row and is Start-aligned, and because that row is
                     a star row a Start-aligned child cannot change its height: the dropdown is an
                     overlay that leaves the page exactly where it was. Declared last so it paints
                     above the results.

                     There is deliberately NO scrim behind it. A transparent overlay over the grid is
                     always above it on Android, so it swallowed the scroll as well as every tap on
                     a row, which is what made the list feel like it broke scrolling. The list now
                     closes on the gestures that mean "I am done with it": scrolling the results,
                     picking a result, switching tab or tapping a filter chip. Back also closes it. -->
                <Border VerticalOptions="Start" Margin="16,0,16,8"
                        IsVisible="False" x:Name="RecentSearchesDrop"
                        BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="4">
                    <!-- Rows, not a CollectionView: the results below already are one and two
                         overlapping ones fight over the touch on Android. -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentSearches}"
                                         BindableLayout.ItemTemplate="{StaticResource RecentSearchRow}"
                                         Spacing="0" />
                </Border>
            </Grid>
        </Grid>

        <!-- ============ Characters tab (2) ============ -->
        <Grid Grid.Row="1"
              IsVisible="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource IntEq}, ConverterParameter=2}">
            <Grid RowDefinitions="Auto,*" Padding="16,8">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="CharSearchEntry" Placeholder="Search characters..."
                           Text="{Binding CharQuery, Source={x:Reference Page}, Mode=TwoWay}"
                           FontFamily="Inter" FontSize="14"
                           BackgroundColor="{StaticResource EmSheet}"
                           TextColor="{StaticResource BrushText}"
                           PlaceholderColor="#80FFFFFF"
                           ReturnType="Search"
                           Completed="OnCharacterSearchCompleted" />
                    <Button Grid.Column="1" Text="Go"
                            Clicked="OnCharacterSearchClicked"
                            FontFamily="InterBold" FontSize="16"
                            BackgroundColor="#0066FF" TextColor="White"
                            CornerRadius="8" WidthRequest="48" HeightRequest="48" Padding="0" />
                </Grid>
                <CollectionView Grid.Row="1" ItemsSource="{Binding CharacterResults, Source={x:Reference Page}}"
                                SelectionMode="Single" SelectionChanged="OnCharacterSelected">
                    <CollectionView.EmptyView>
                        <Label Text="Type a character name to search"
                               FontFamily="Inter" FontSize="13" TextColor="#80FFFFFF"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="10">
                                <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" WidthRequest="52" HeightRequest="76"
                                            StrokeShape="RoundRectangle 6"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                                        <Image Source="{Binding Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                                               Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Data.Name}" FontFamily="InterBold" FontSize="14"
                                               TextColor="{StaticResource BrushText}" MaxLines="2"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Data.Notes}" FontFamily="Inter" FontSize="11"
                                               TextColor="#80FFFFFF" MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- ============ Genres tab (3) â€” reuses Main tab's catalogue by setting mode=Genres ============ -->
        <Grid Grid.Row="1"
              IsVisible="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource IntEq}, ConverterParameter=3}">
            <Grid RowDefinitions="Auto,*" Padding="16,8">
                <Label Grid.Row="0" Text="Pick a genre"
                       FontFamily="InterBold" FontSize="20" TextColor="{StaticResource BrushText}" />
                <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableSelectionChoices}"
                                SelectionMode="Single" SelectionChanged="OnGenreStudioSelected">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="16,12">
                                <Label Text="{Binding Name}" FontFamily="InterBold" FontSize="16"
                                       TextColor="{StaticResource BrushText}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- ============ Studios tab (4) ============ -->
        <Grid Grid.Row="1"
              IsVisible="{Binding SearchTabIndex, Source={x:Reference Page}, Converter={StaticResource IntEq}, ConverterParameter=4}">
            <Grid RowDefinitions="Auto,*" Padding="16,8">
                <Label Grid.Row="0" Text="Pick a studio"
                       FontFamily="InterBold" FontSize="20" TextColor="{StaticResource BrushText}" />
                <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableSelectionChoices}"
                                SelectionMode="Single" SelectionChanged="OnGenreStudioSelected">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12,10">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
                                    <Image Grid.Column="0" Aspect="AspectFit"
                                           IsVisible="{Binding IconUrl, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}"
                                           Source="{Binding IconUrl, Converter={StaticResource ImageConverter}}" />
                                    <Label Grid.Column="1" Text="{Binding Name}" FontFamily="InterBold" FontSize="15"
                                           TextColor="{StaticResource BrushText}"
                                           VerticalOptions="Center" MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- Loading overlay -->
        <Grid IsVisible="{Binding Loading}" BackgroundColor="#80000000"
              Grid.Row="1" VerticalOptions="Fill" HorizontalOptions="Fill" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>
    </Grid>
</ContentPage>
