<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             x:Name="CharacterDetailsPageRoot"
             x:Class="MALPlus.Views.CharacterDetailsPage"
             BackgroundColor="{DynamicResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />

        <!-- Full List Card: Voice Actor -->
        <DataTemplate x:Key="CharacterVoiceActorTemplate">
            <Border Margin="0,0,0,8" Padding="10" Style="{StaticResource PanelStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVoiceActorTapped" CommandParameter="{Binding Data.Id}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="60,*" ColumnSpacing="12">
                    <Border WidthRequest="60" HeightRequest="84" StrokeShape="RoundRectangle 8"
                            Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1">
                        <Image Source="{Binding Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding Data.Name}" FontFamily="InterBold" FontSize="14"
                               TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                        <Border HorizontalOptions="Start" Padding="7,2" StrokeShape="RoundRectangle 6"
                                BackgroundColor="#1A0066FF" StrokeThickness="0"
                                IsVisible="{Binding Data.Notes, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}">
                            <Label Text="{Binding Data.Notes}" FontFamily="InterSemiBold" FontSize="10" TextColor="#60A5FA" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Full List Card: Media (Anime / Manga) -->
        <DataTemplate x:Key="CharacterMediaCardTemplate">
            <Border Margin="0,0,0,10" Padding="10" Style="{StaticResource PanelStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAnimeographyTapped" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="76,*" ColumnSpacing="12">
                    <Border WidthRequest="76" HeightRequest="108" StrokeShape="RoundRectangle 8"
                            Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1">
                        <Image Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                        <Label Text="{Binding Title}" FontFamily="InterBold" FontSize="14"
                               TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                                    BindableLayout.ItemsSource="{Binding DisplayChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="7,3" Margin="0,2,6,2"
                                            BackgroundColor="{DynamicResource TabChipInactiveBg}" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="1">
                                                <Setter Property="BackgroundColor" Value="#1A0066FF" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Text}" FontFamily="InterSemiBold" FontSize="10"
                                               TextColor="{DynamicResource TabChipInactiveText}" LineBreakMode="WordWrap" MaxLines="2">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="1">
                                                    <Setter Property="TextColor" Value="#60A5FA" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <!-- Floating Back Button -->
        <Border ZIndex="500" HorizontalOptions="Start" VerticalOptions="Start"
                Margin="16,16,0,0" WidthRequest="40" HeightRequest="40"
                StrokeShape="RoundRectangle 20" BackgroundColor="#B3051522" Stroke="#33FFFFFF" StrokeThickness="1">
            <Grid>
                <Label Text="←" FontFamily="InterBold" FontSize="18" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                <Button Clicked="OnBackButtonClicked" BackgroundColor="Transparent" BorderWidth="0" Padding="0" />
            </Grid>
        </Border>

        <Grid IsVisible="{Binding Loading}" BackgroundColor="#CC000510" ZIndex="99">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                                   WidthRequest="40" HeightRequest="40" />
                <Label Text="Loading..." FontFamily="Inter" FontSize="12"
                       TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid RowDefinitions="Auto,Auto,*"
              IsVisible="{Binding Loading, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <!-- Hero Header: BlurHeroView backdrop + crisp uncropped portrait + Name/Favorites -->
            <Grid x:Name="FullHero" Grid.Row="0" HeightRequest="238" BackgroundColor="{DynamicResource EmBackground}" IsClippedToBounds="True">
                <controls:BlurHeroView ImageUrl="{Binding Data.ImgUrl}" />
                <BoxView InputTransparent="True">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#66051522" Offset="0.0" />
                            <GradientStop Color="#8C051522" Offset="0.55" />
                            <GradientStop Color="#F2051522" Offset="1.0" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <Grid ColumnDefinitions="106,*" ColumnSpacing="16"
                      VerticalOptions="End" Padding="20,64,20,18">
                    <Border Grid.Column="0" WidthRequest="106" HeightRequest="154"
                            StrokeShape="RoundRectangle 10"
                            Stroke="#33FFFFFF" StrokeThickness="1"
                            BackgroundColor="{DynamicResource EmSheet}"
                            VerticalOptions="End">
                        <Image Source="{Binding Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="8">
                        <Label Text="{Binding Data.Name}" FontFamily="InterBold" FontSize="22"
                               TextColor="{StaticResource BrushText}" MaxLines="3" LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="7">
                            <Border Padding="8,4" BackgroundColor="#1A0066FF" StrokeShape="RoundRectangle 6">
                                <Label Text="CHARACTER" FontFamily="InterSemiBold" FontSize="10" TextColor="#60A5FA" />
                            </Border>
                            <Border Padding="8,4" BackgroundColor="{DynamicResource TabChipInactiveBg}"
                                    Stroke="{DynamicResource EmBorderBrush}" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                    IsVisible="{Binding Data.TotalFavs, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}">
                                <Label Text="{Binding Data.TotalFavs, StringFormat='★ {0}'}"
                                       FontFamily="InterSemiBold" FontSize="10" TextColor="{StaticResource BrushText}" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <!-- Modern Tab Bar (empty tabs hidden dynamically in code-behind) -->
            <ScrollView x:Name="TabStripScroll" Grid.Row="1" HorizontalOptions="Fill" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        Padding="14,8,14,8" BackgroundColor="{DynamicResource EmBackground}">
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="TabOverview" Text="Info" Style="{StaticResource TabChipButtonStyle}" Clicked="OnTabOverviewClicked" />
                    <Button x:Name="TabVoiceActors" Text="Voice Actors" Style="{StaticResource TabChipButtonStyle}" Clicked="OnTabVoiceActorsClicked" />
                    <Button x:Name="TabAnimeography" Text="Animeography" Style="{StaticResource TabChipButtonStyle}" Clicked="OnTabAnimeographyClicked" />
                    <Button x:Name="TabMangaography" Text="Mangaography" Style="{StaticResource TabChipButtonStyle}" Clicked="OnTabMangaographyClicked" />
                </HorizontalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2" x:Name="TabContentHost" Padding="16,8,16,0">

                <!-- INFO TAB (pure About & Spoilers, no duplicate shelves) -->
                <ScrollView x:Name="OverviewTab">
                    <VerticalStackLayout Spacing="14" Padding="0,0,0,24">
                        <!-- About Box -->
                        <Border Style="{StaticResource PanelStyle}" Padding="14"
                                IsVisible="{Binding HasAboutContent}">
                            <VerticalStackLayout Spacing="8">
                                <Button Text="{Binding AboutToggleText}" Command="{Binding ToggleAboutCommand}"
                                        FontFamily="InterSemiBold" FontSize="12" TextColor="#60A5FA"
                                        BackgroundColor="Transparent" Padding="0" HorizontalOptions="Start" />
                                <controls:SpoilerTextView Text="{Binding Data.Content}"
                                                           TextColor="{StaticResource BrushText}"
                                                           TextSize="13" LineHeight="1.4"
                                                           IsVisible="{Binding IsAboutExpanded}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Spoilers Box -->
                        <Border Style="{StaticResource PanelStyle}" Padding="14"
                                IsVisible="{Binding SpoilerButtonVisibility}">
                            <VerticalStackLayout Spacing="8">
                                <Button Text="{Binding SpoilerToggleText}" Command="{Binding ToggleSpoilerCommand}"
                                        FontFamily="InterSemiBold" FontSize="12" TextColor="#60A5FA"
                                        BackgroundColor="Transparent" Padding="0" HorizontalOptions="Start" />
                                <Label Text="{Binding Data.SpoilerContent}" IsVisible="{Binding IsSpoilerExpanded}"
                                       FontFamily="Inter" FontSize="13" TextColor="{StaticResource BrushText}"
                                       LineHeight="1.4" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Empty Info Notice -->
                        <Border Style="{StaticResource PanelStyle}" Padding="16"
                                IsVisible="{Binding IsOverviewEmpty}">
                            <Label Text="No character information available." FontFamily="Inter" FontSize="13"
                                   TextColor="{DynamicResource TabChipInactiveText}" />
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- VOICE ACTORS TAB -->
                <Grid x:Name="VoiceActorsTab" IsVisible="False" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,2,2,10">
                        <Label Text="VOICE ACTORS" Style="{StaticResource SectionLabelStyle}" Margin="0" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding VoiceActors.Count}" FontFamily="InterSemiBold"
                                   FontSize="11" TextColor="{DynamicResource TabChipInactiveText}" />
                    </Grid>
                    <CollectionView Grid.Row="1" x:Name="VoiceActorsList"
                                    ItemsSource="{Binding VoiceActors}"
                                    ItemTemplate="{StaticResource CharacterVoiceActorTemplate}"
                                    ItemSizingStrategy="MeasureFirstItem">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                        </CollectionView.ItemsLayout>
                    </CollectionView>
                </Grid>

                <!-- ANIMEOGRAPHY TAB -->
                <Grid x:Name="AnimeographyTab" IsVisible="False" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,2,2,10">
                        <Label Text="ANIMEOGRAPHY" Style="{StaticResource SectionLabelStyle}" Margin="0" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Data.Animeography.Count}" FontFamily="InterSemiBold"
                                   FontSize="11" TextColor="{DynamicResource TabChipInactiveText}" />
                    </Grid>
                    <CollectionView Grid.Row="1" x:Name="AnimeographyList"
                                    ItemsSource="{Binding Data.Animeography}"
                                    ItemTemplate="{StaticResource CharacterMediaCardTemplate}"
                                    ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                        </CollectionView.ItemsLayout>
                    </CollectionView>
                </Grid>

                <!-- MANGAOGRAPHY TAB -->
                <Grid x:Name="MangaographyTab" IsVisible="False" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,2,2,10">
                        <Label Text="MANGAOGRAPHY" Style="{StaticResource SectionLabelStyle}" Margin="0" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Data.Mangaography.Count}" FontFamily="InterSemiBold"
                                   FontSize="11" TextColor="{DynamicResource TabChipInactiveText}" />
                    </Grid>
                    <CollectionView Grid.Row="1" x:Name="MangaographyList"
                                    ItemsSource="{Binding Data.Mangaography}"
                                    ItemTemplate="{StaticResource CharacterMediaCardTemplate}"
                                    ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                        </CollectionView.ItemsLayout>
                    </CollectionView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
