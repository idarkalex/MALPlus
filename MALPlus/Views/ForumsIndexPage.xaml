<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.ForumsIndexPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:IntEqualityConverter x:Key="IntEq" />
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding LoadingSideContentVisibility, FallbackValue=false}" BackgroundColor="#80000000" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>

        <Grid RowDefinitions="Auto,*" IsVisible="{Binding LoadingSideContentVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert, FallbackValue=true}">
            <!-- Tab strip -->
            <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        Padding="12,8,12,0">
                <HorizontalStackLayout x:Name="TabStrip" Spacing="6" />
            </ScrollView>

            <!-- Boards tab -->
            <RefreshView Grid.Row="1" IsRefreshing="{Binding LoadingSideContentVisibility, FallbackValue=false}" Refreshing="OnRefreshing"
                         IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ForumsTabIndex, Converter={StaticResource IntEq}, ConverterParameter=0}">
                <ScrollView>
                    <VerticalStackLayout Padding="12,4">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Boards}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="8" Margin="0,0,0,8">
                                        <Label Text="{Binding Group}" FontFamily="InterBold" FontSize="11" CharacterSpacing="1.2"
                                               TextColor="{StaticResource TabChipInactiveText}" TextTransform="Uppercase" Margin="4,8,4,4" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BackgroundColor="{StaticResource EmSheet}"
                                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 14" Padding="14,12" Margin="0,0,0,4">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnBoardTapped" CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <VerticalStackLayout Spacing="4">
                                                            <Label Text="{Binding Entry.Name}" FontFamily="InterBold" FontSize="14"
                                                                   TextColor="{StaticResource BrushText}" />
                                                            <Label Text="{Binding Entry.Description}" FontFamily="Inter" FontSize="12"
                                                                   TextColor="#80FFFFFF" MaxLines="2"
                                                                   LineBreakMode="TailTruncation" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <!-- Recent Posts tab -->
            <RefreshView Grid.Row="1" IsRefreshing="{Binding LoadingSideContentVisibility, FallbackValue=false}" Refreshing="OnRefreshing"
                         IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ForumsTabIndex, Converter={StaticResource IntEq}, ConverterParameter=1}">
                <CollectionView ItemsSource="{Binding RecentPosts}" SelectionMode="Single"
                                SelectionChanged="OnRecentPostTapped">
                    <CollectionView.EmptyView>
                        <Label Text="No recent posts" FontFamily="Inter" FontSize="13"
                               TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="12,3" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14" Padding="12,10">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding BoardName}" FontFamily="InterBold" FontSize="11"
                                               TextColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding PostTime}" FontFamily="Inter" FontSize="11"
                                               TextColor="{StaticResource TabChipInactiveText}" VerticalOptions="Center" />
                                    </Grid>
                                    <Label Grid.Row="1" Text="{Binding Title}" FontFamily="InterBold" FontSize="14"
                                           TextColor="{StaticResource BrushText}" MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Grid.Row="2" Spacing="6" VerticalOptions="Center">
                                        <Border WidthRequest="20" HeightRequest="20"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                                VerticalOptions="Center">
                                            <Image Source="{Binding User.ImgUrl, Converter={StaticResource ImageConverter}}"
                                                   Aspect="AspectFill" WidthRequest="20" HeightRequest="20" />
                                        </Border>
                                        <Label Text="{Binding User.Name}" FontFamily="InterSemiBold" FontSize="11"
                                               TextColor="{StaticResource TabChipInactiveText}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
