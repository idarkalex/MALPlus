<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.App">
    <Application.Resources>
        <ResourceDictionary>
            <converters:StringToImageSourceConverter x:Key="ImageConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolVis" />

            <Color x:Key="EmBackground">#051522</Color>
            <Color x:Key="EmSheet">#0A1F2E</Color>
            <Color x:Key="EmAccent">#0066FF</Color>
            <Color x:Key="EmBorder">#1E3A52</Color>
            <SolidColorBrush x:Key="EmBorderBrush" Color="#1E3A52" />
            <SolidColorBrush x:Key="EmBackgroundBrush" Color="#051522" />
            <SolidColorBrush x:Key="EmSheetBrush" Color="#0A1F2E" />
            <Color x:Key="BrushText">#FFFFFF</Color>
            <Color x:Key="BrushTextSecondary">#99FFFFFF</Color>
            <x:Double x:Key="EmTitleMd">18</x:Double>
            <x:Double x:Key="EmBodyMd">16</x:Double>
            <x:Double x:Key="EmLabelCaps">12</x:Double>

            <Color x:Key="TabChipInactiveBg">#141D2B</Color>
            <Color x:Key="TabChipInactiveText">#8FA8C0</Color>

            <!-- Reusable Tab Chip style (Option A: Modern Squircle, 8dp radius) -->
            <Style x:Key="TabChipButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="{DynamicResource EmBorder}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource TabChipInactiveBg}" />
                <Setter Property="TextColor" Value="{DynamicResource TabChipInactiveText}" />
            </Style>

            <Style x:Key="TabChipActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource TabChipButtonStyle}">
                <Setter Property="BackgroundColor" Value="{DynamicResource EmAccent}" />
                <Setter Property="TextColor" Value="{DynamicResource BrushText}" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="BorderColor" Value="Transparent" />
            </Style>

            <!-- The panel every list row sits on. Global rather than declared per page, because three
                 pages draw rows out of the same ItemTemplate and a resource declared inside one page is
                 invisible to the others: a row asking for it throws when it inflates, which takes the
                 whole page's content with it rather than leaving a single cell empty. -->
            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource EmSheet}" />
                <Setter Property="Stroke" Value="{DynamicResource EmBorderBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            </Style>

            <!-- Hide default Shell navigation bar on all pages (pages provide their own header) -->
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="Shell.NavBarIsVisible" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
