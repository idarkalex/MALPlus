<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MALPlus.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="EmBackground">#051522</Color>
            <Color x:Key="EmSheet">#0A1F2E</Color>
            <Color x:Key="EmAccent">#0066FF</Color>
            <Color x:Key="EmBorder">#1E3A52</Color>
            <Color x:Key="BrushText">#FFFFFF</Color>
            <Color x:Key="BrushTextSecondary">#99FFFFFF</Color>
            <x:Double x:Key="EmTitleMd">18</x:Double>
            <x:Double x:Key="EmBodyMd">16</x:Double>
            <x:Double x:Key="EmLabelCaps">12</x:Double>

            <!-- The panel every list row sits on. Global rather than declared per page, because three
                 pages draw rows out of the same ItemTemplate and a resource declared inside one page is
                 invisible to the others: a row asking for it throws when it inflates, which takes the
                 whole page's content with it rather than leaving a single cell empty. -->
            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource EmSheet}" />
                <Setter Property="Stroke" Value="{StaticResource EmBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
